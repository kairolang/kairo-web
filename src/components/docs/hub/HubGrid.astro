---
/**
 * <HubGrid>: lays out a run of cards. The column count follows the width of
 * the hub column (a container query, so it works the same beside a sidebar
 * or without one): `cols` when there is room, 2 on mid widths, 1 on phones.
 * In a 3-column grid that drops to 2, a lone last card spans the row.
 * Cards in a row share a height (one bento box, every corner lining up); a
 * shorter card's spare height is padding at the bottom of its frame.
 *
 * Props
 *   cols   2 | 3   Columns at full width (default 3).
 *
 * Slot (default)
 *   Cards (HubCard, PathCard, StatusCard, ...).
 *
 * Usage (MDX)
 *   <HubGrid cols={3}>
 *     <PathCard title="new here">...</PathCard>
 *     ...
 *   </HubGrid>
 */

interface Props {
  cols?: 2 | 3;
}

const { cols = 3 } = Astro.props;
---
<div class="hub-grid" data-cols={cols}>
  <slot />
</div>
