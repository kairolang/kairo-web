---
/**
 * <PathCard>: a suggested reading path. A framed card whose Markdown list
 * is the route through the docs; an ordered list renders as numbered steps
 * ("[1] welcome  [2] install …"), an unordered one as jump links ("↓").
 *
 * Props
 *   title  string    Who the path is for ("new to kairo"), set in the
 *                    frame's top edge.
 *   kicker string?   Small label on the right of the top edge ("start here").
 *   id     string?   Anchor id.
 *   level  3 | 4     Heading level (default 3).
 *
 * Slot (default)
 *   A Markdown list. Text after a step's link is wrapped as a gloss
 *   (<span class="hub-gloss">), same as HubCard. A <HubSearch inline> item
 *   takes its shortcut key as the marker.
 *
 * Usage (MDX)
 *   <PathCard title="new to kairo">
 *
 *   1. [welcome](/docs/welcome/)
 *   2. [install](/docs/install/)
 *
 *   </PathCard>
 */
import { metaReserve, wrapGlosses } from './markup';

interface Props {
  title: string;
  kicker?: string;
  id?: string;
  level?: 3 | 4;
}

const { title, kicker, id, level = 3 } = Astro.props;
const H = level === 4 ? 'h4' : 'h3';
const body = wrapGlosses(await Astro.slots.render('default'));
---
<section class="ascii-frame ascii-frame--fill hub-card hub-path" id={id} style={metaReserve(kicker)}>
  <H class="ascii-frame-title hub-card-title">{title}</H>
  {kicker && <span class="ascii-frame-meta hub-card-meta">{kicker}</span>}
  <div class="hub-card-body hub-path-steps">
    <Fragment set:html={body} />
  </div>
</section>
