---
/**
 * The one "on this page" tree, shared by docs (desktop column + mobile
 * drawer) and blog posts (right rail + inline <details> copy).
 *
 *   // READ
 *   [██████░░░░░░░░░░]  42%
 *   - - - - - - - - - - - - -
 *   // ON THIS PAGE
 *   .
 *   ├─> Active heading          ">" slides between rows (transform only)
 *   │   ├── h3
 *   │   └── h3
 *   └── Last heading
 *   - - - - - - - - - - - - -
 *   [ ↑ top ]  [ cd .. ]
 *
 * Tree lines are 1px rules (not glyphs) so wrapped labels stay connected.
 * Scroll-spy, progress and markers are scroll-driven only: no ambient motion.
 */
import { getCollection } from 'astro:content';
import { docHref } from '../../lib/docs-tree';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
  /** Several instances may render on one page; ids must differ. */
  id?: string;
  /** Show the ASCII reading-progress bar (default true). */
  progress?: boolean;
  /** Show the "// on this page" label (off where a summary already says it). */
  label?: boolean;
  /** Element whose read-through the bar measures. */
  article?: string;
  /** Element whose bottom is the content end (the last heading wins there). */
  end?: string;
  class?: string;
}
const { headings, id, progress = true, label = true, article, end, class: cls } = Astro.props;

// h2 at the root, h3 nested under the preceding h2 (an orphan h3 sits at the root).
type Node = { slug: string; text: string; depth: number; children: Node[] };
const tree: Node[] = [];
for (const h of headings) {
  if (h.depth === 2) tree.push({ slug: h.slug, text: h.text, depth: 2, children: [] });
  else if (h.depth === 3) {
    const parent = tree[tree.length - 1];
    (parent ? parent.children : tree).push({ slug: h.slug, text: h.text, depth: 3, children: [] });
  }
}

// "cd .." — one level up: a docs page goes to its nearest parent section
// index that exists (else /docs/), a blog post to /blog/.
const path = Astro.url.pathname;
const parts = path.replace(/^\/+|\/+$/g, '').split('/').filter(Boolean);
const isDocs = parts[0] === 'docs';
let up = { href: '/', name: 'home' };
if (parts[0] === 'blog') up = { href: '/blog/', name: 'blog' };
else if (isDocs && parts.length > 1) {
  const docs = await getCollection('docs');
  const titles = new Map(docs.map(d => [docHref(d.id), d.data.title]));
  up = { href: '/docs/', name: 'docs' };
  for (let i = parts.length - 1; i >= 2; i--) {
    const href = '/' + parts.slice(0, i).join('/') + '/';
    if (titles.has(href)) { up = { href, name: titles.get(href) ?? parts[i - 1] }; break; }
  }
}
const upPath = up.href === '/' ? '~' : '~' + up.href.replace(/\/$/, '');

const articleSel = article ?? (isDocs ? 'main.docs-content article.prose' : '#post-body');
const endSel = end ?? (isDocs ? 'main.docs-content' : articleSel);
const CELLS = 16;
---

<nav
  class:list={['toc', cls]}
  id={id}
  aria-label="On this page"
  data-toc
  data-toc-article={articleSel}
  data-toc-end={endSel}
>
  {progress && (
    <div class="toc-block toc-read" aria-hidden="true">
      <p class="toc-label">read</p>
      <div class="toc-bar" data-toc-bar>[<span class="tb-fill"></span><span class="tb-empty">{'░'.repeat(CELLS)}</span>]<span class="tb-pct">   0%</span></div>
    </div>
  )}

  {tree.length > 0 && (
    <div class="toc-block">
      {label && <p class="toc-label">on this page</p>}
      <div class="toc-body">
        <span class="toc-marker" aria-hidden="true">&gt;</span>
        <div class="toc-root" aria-hidden="true">.</div>
        <ul class="toc-tree">
          {tree.map(n => (
            <li class="toc-item">
              <a href={`#${n.slug}`} class={`toc-link toc-h${n.depth}`}>{n.text}</a>
              {n.children.length > 0 && (
                <ul>
                  {n.children.map(c => (
                    <li class="toc-item">
                      <a href={`#${c.slug}`} class="toc-link toc-h3">{c.text}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <div class="toc-block toc-actions">
    <a href="#top" class="toc-act" data-toc-top>
      <span class="toc-act-glyph" aria-hidden="true">↑</span> top<span class="sr-only"> of the page</span>
    </a>
    <a href={up.href} class="toc-act" title={`cd ${upPath}`} rel="up">
      cd <span class="toc-act-glyph" aria-hidden="true">..</span><span class="sr-only"> (up to {up.name})</span>
    </a>
  </div>
</nav>

<style>
  .toc {
    --row-pad: 3px;
    font-family: var(--font-mono);
    padding: 0 0 2rem;
  }
  .toc-block + .toc-block {
    margin-top: 1.25rem;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--frame-line);
  }
  .toc-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-2);
    margin: 0 0 0.55rem;
  }
  .toc-label::before {
    content: '// ';
    content: '// ' / '';
    color: var(--text-3);
  }

  /* ── read bar: [██████░░░░░░░░░░]  42% ── */
  .toc-bar {
    font-size: 0.75rem;
    line-height: 1.4;
    white-space: pre;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
    overflow: hidden;
  }
  .tb-fill { color: var(--red); }
  .tb-empty { color: var(--text-3); }
  .tb-pct { color: var(--text-2); }

  /* ── tree ── */
  .toc-body { position: relative; }
  .toc-root {
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--text-3);
    padding-left: 0.2ch;
  }
  .toc-tree,
  .toc-tree ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-tree {
    font-size: 0.75rem;
    line-height: 1.4;
    --tree-line: var(--text-3);
  }
  .toc-item {
    position: relative;
    padding-left: 3.5ch;
  }
  /* │ — the full height of the item (incl. its children) unless it is the last */
  .toc-item::before {
    content: '';
    position: absolute;
    left: 0.5ch;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--tree-line);
  }
  .toc-item:last-child::before { bottom: auto; height: calc(0.5lh + var(--row-pad)); }
  /* ── — the branch into the label; the active row's is shortened to "─"
     and the sliding ">" completes it: ├─> */
  .toc-item::after {
    content: '';
    position: absolute;
    left: 0.5ch;
    top: calc(0.5lh + var(--row-pad));
    width: 2.4ch;
    height: 1px;
    background: var(--tree-line);
  }
  .toc-item.is-active::after { width: 1.2ch; background: var(--accent); }

  .toc-link {
    display: block;
    padding: var(--row-pad) 0.5ch;
    margin-left: -0.5ch;
    font-weight: 450; /* constant weight: the active state must not reflow */
    color: var(--text-2);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--dur-instant) steps(1, end), background-color var(--dur-instant) steps(1, end);
  }
  .toc-link:hover,
  .toc-link:focus-visible {
    color: var(--text);
    background-color: var(--bg-3);
  }
  /* the h2 that holds the active h3 lights up a step */
  .toc-item.has-active > .toc-link { color: var(--text); }
  .toc-link.active,
  .toc-link.active:hover { color: var(--accent); }

  /* the moving ">" — one per TOC, positioned with transform only */
  .toc-marker {
    position: absolute;
    left: 1.85ch;
    top: 0;
    width: 1ch;
    padding-top: var(--row-pad);
    font-size: 0.75rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--accent);
    text-align: center;
    opacity: 0;
    transform: translate(var(--mx, 0px), var(--my, 0px));
    pointer-events: none;
  }
  .toc-marker.on { opacity: 1; }
  /* no slide on the first placement (or after being hidden): only moves animate */
  .toc-marker.ready {
    transition: transform var(--dur-fast) steps(4, end), opacity var(--dur-instant) steps(1, end);
  }

  /* ── actions: [ ↑ top ]  [ cd .. ] ── */
  .toc-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.5ch;
  }
  .toc-act {
    font-size: 0.72rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--text-2);
    text-decoration: none;
    padding: 1px 0.3ch;
    margin-left: -0.3ch;
    transition: color var(--dur-instant) steps(1, end), background-color var(--dur-instant) steps(1, end);
  }
  .toc-act + .toc-act { margin-left: 0; }
  .toc-act::before { content: '[ '; content: '[ ' / ''; color: var(--text-3); }
  .toc-act::after  { content: ' ]'; content: ' ]' / ''; color: var(--text-3); }
  .toc-act-glyph { color: var(--accent); }
  .toc-act:hover,
  .toc-act:focus-visible {
    background-color: var(--accent);
    color: var(--on-red);
  }
  .toc-act:hover::before,
  .toc-act:hover::after,
  .toc-act:hover .toc-act-glyph,
  .toc-act:focus-visible::before,
  .toc-act:focus-visible::after,
  .toc-act:focus-visible .toc-act-glyph { color: inherit; }
</style>

<script>
  const CELLS = 16;

  function initTOC() {
    const tocs = Array.from(document.querySelectorAll<HTMLElement>('nav[data-toc]'));
    if (!tocs.length || tocs[0].dataset.init) return;
    tocs.forEach(t => (t.dataset.init = '1'));
    const root = document.documentElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const article = document.querySelector<HTMLElement>(tocs[0].dataset.tocArticle || 'article');
    const endEl = document.querySelector<HTMLElement>(tocs[0].dataset.tocEnd || '') ?? article;

    const idOf = (hash: string) => {
      try { return decodeURIComponent(hash.slice(1)); } catch { return hash.slice(1); }
    };
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('nav[data-toc] .toc-link'));
    const ids = Array.from(new Set(links.map(l => idOf(l.hash)).filter(Boolean)));
    const heads = ids.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const rootItems = Array.from(document.querySelectorAll<HTMLElement>('nav[data-toc] .toc-tree > .toc-item'));

    // ── geometry: cached, re-measured on resize / content size change only,
    //    so the scroll path never reads layout
    let tops: number[] = [];
    let contentBottom = 0;   // document-Y where the content ends (docs: the footer gate)
    let aTop = 0, aHeight = 1, vh = window.innerHeight;
    let OFFSET = 120;        // activation line below the viewport top
    const FLOOR = 120;       // at the content end the line sits this far above the bottom
    const measure = () => {
      const y = window.scrollY;
      vh = window.innerHeight;
      tops = heads.map(h => h.getBoundingClientRect().top + y);
      contentBottom = endEl ? endEl.getBoundingClientRect().bottom + y : root.scrollHeight;
      if (article) {
        const r = article.getBoundingClientRect();
        aTop = r.top + y;
        aHeight = r.height;
      }
      // a jumped-to heading must land on/under the line: header + its scroll margin
      if (heads[0]) {
        const sm = parseFloat(getComputedStyle(heads[0]).scrollMarginTop) || 0;
        const sp = parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;
        OFFSET = Math.max(120, sm + sp + 12);
      }
    };

    // ── reading progress: [██████░░░░░░░░░░]  42%
    const bars = tocs.map(t => {
      const bar = t.querySelector<HTMLElement>('[data-toc-bar]');
      return bar && {
        fill: bar.querySelector<HTMLElement>('.tb-fill')!,
        empty: bar.querySelector<HTMLElement>('.tb-empty')!,
        pct: bar.querySelector<HTMLElement>('.tb-pct')!,
      };
    }).filter(Boolean) as Array<{ fill: HTMLElement; empty: HTMLElement; pct: HTMLElement }>;
    let lastPct = -1;
    const updateBar = () => {
      if (!bars.length || !article) return;
      // 0% until the article top passes 30% of the viewport (never above 0,
      // so a page whose text starts on screen reads 0% at the top)
      const start = Math.max(0, aTop - vh * 0.3);
      const stop = aTop + aHeight - vh;
      const p = stop > start ? (window.scrollY - start) / (stop - start) : 1;
      const pct = Math.round(Math.max(0, Math.min(1, p)) * 100);
      if (pct === lastPct) return;
      lastPct = pct;
      const n = Math.round((pct / 100) * CELLS);
      const f = '█'.repeat(n), e = '░'.repeat(CELLS - n), l = ' ' + String(pct).padStart(3, ' ') + '%';
      for (const b of bars) { b.fill.textContent = f; b.empty.textContent = e; b.pct.textContent = l; }
    };

    // ── active heading: accent text + the sliding ">"
    let current = '';
    const placeMarker = (toc: HTMLElement) => {
      const body = toc.querySelector<HTMLElement>('.toc-body');
      const marker = toc.querySelector<HTMLElement>('.toc-marker');
      if (!body || !marker) return;
      const link = body.querySelector<HTMLElement>('.toc-link.active');
      const b = body.getBoundingClientRect();
      if (!link || !b.height) {   // nothing active, or laid out lazily (drawer / details)
        marker.classList.remove('on', 'ready');
        return;
      }
      const li = link.parentElement as HTMLElement;
      const lr = li.getBoundingClientRect();
      marker.style.setProperty('--mx', `${Math.round(lr.left - b.left)}px`);
      marker.style.setProperty('--my', `${Math.round(lr.top - b.top)}px`);
      if (!marker.classList.contains('on')) {
        marker.classList.add('on');
        requestAnimationFrame(() => marker.classList.add('ready'));
      }
    };
    // keep the active row visible inside a scrolling TOC column / drawer
    const follow = (toc: HTMLElement) => {
      const link = toc.querySelector<HTMLElement>('.toc-link.active');
      const box = toc.closest<HTMLElement>('.docs-toc-col, .post-rail, .toc-drawer');
      if (!link || !box || box.scrollHeight <= box.clientHeight + 1 || !box.clientHeight) return;
      const lr = link.getBoundingClientRect(), br = box.getBoundingClientRect();
      if (lr.top < br.top + 24 || lr.bottom > br.bottom - 24) {
        box.scrollTop += lr.top - br.top - box.clientHeight / 3;
      }
    };
    const placeAll = () => tocs.forEach(placeMarker);
    const setActive = (id: string) => {
      if (id === current) return;
      current = id;
      for (const l of links) {
        const on = !!id && idOf(l.hash) === id;
        l.classList.toggle('active', on);
        if (on) l.setAttribute('aria-current', 'location');
        else l.removeAttribute('aria-current');
        (l.parentElement as HTMLElement).classList.toggle('is-active', on);
      }
      // the h2 that holds the active h3
      for (const li of rootItems) {
        li.classList.toggle('has-active', !!li.querySelector(':scope > ul .toc-link.active'));
      }
      placeAll();
      tocs.forEach(follow);
    };

    // A heading jumped to (TOC / #link / #hash load) stays active until the
    // reader scrolls themselves: a tail heading that can't reach the line
    // must not hand the highlight to the one after it.
    let pinned = '';
    let ticking = false;
    const spy = () => {
      if (!heads.length) return;
      if (pinned) { setActive(pinned); return; }
      const sy = window.scrollY;
      // The activation line sits OFFSET below the top. Over the last half
      // viewport of travel before the content end it sweeps down towards the
      // bottom, so headings that can never reach the top still activate, in
      // order, and the last one is active once the content end is in view.
      let line = sy + OFFSET;
      const gate = contentBottom - vh;
      if (gate > 0) {
        const r = Math.max(1, Math.min(vh * 0.5, gate));
        const p = Math.min(1, Math.max(0, (sy - (gate - r)) / r));
        line += p * Math.max(0, vh - OFFSET - FLOOR);
      }
      let idx = -1;
      for (let i = 0; i < tops.length; i++) {
        if (tops[i] <= line) idx = i; else break;
      }
      // resting at (or past) the content end: the last heading wins
      if (gate > 0 && sy >= gate - 2) idx = heads.length - 1;
      setActive(idx >= 0 ? heads[idx].id : '');
    };
    const update = () => { ticking = false; spy(); updateBar(); };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    const unpin = () => { if (pinned) { pinned = ''; onScroll(); } };
    const pin = (id: string) => {
      if (!id || !ids.includes(id)) return;
      pinned = id;
      setActive(id);
    };

    for (const l of links) l.addEventListener('click', () => pin(idOf(l.hash)));
    window.addEventListener('hashchange', () => pin(idOf(location.hash)));
    document.addEventListener('docs:anchor', (e) => pin((e as CustomEvent<{ id: string }>).detail?.id ?? ''));
    // the reader taking over the scroll releases the pin
    window.addEventListener('wheel', unpin, { passive: true });
    window.addEventListener('touchstart', unpin, { passive: true });
    window.addEventListener('pointerdown', (e) => {
      if (e.target === root || e.clientX >= root.clientWidth) unpin();
    }, { passive: true });
    document.addEventListener('keydown', (e) => {
      if (/^(Page(Up|Down)|Arrow(Up|Down)|Home|End| )$/.test(e.key)) unpin();
    });

    // ── [ ↑ top ]: scroll home, drop the #hash, hand focus to the page title
    for (const top of document.querySelectorAll<HTMLAnchorElement>('nav[data-toc] [data-toc-top]')) {
      top.addEventListener('click', (e) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        pinned = '';
        if (location.hash) history.replaceState(history.state, '', location.pathname + location.search);
        window.scrollTo({ top: 0, behavior: reduce.matches ? 'instant' : 'smooth' });
        const h1 = document.querySelector<HTMLElement>('main h1');
        if (h1) {
          if (!h1.hasAttribute('tabindex')) {
            h1.setAttribute('tabindex', '-1');
            h1.addEventListener('blur', () => h1.removeAttribute('tabindex'), { once: true });
          }
          h1.focus({ preventScroll: true });
        }
        onScroll();
      });
    }

    measure();
    if (location.hash) pin(idOf(location.hash));
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => { measure(); onScroll(); placeAll(); }, { passive: true });
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(() => { measure(); onScroll(); });
      [article, endEl, document.body].forEach(el => el && ro.observe(el));
      // a TOC laid out lazily (drawer opening, <details> expanding, column
      // shown on resize) gets its ">" placed once it has a size
      const mo = new ResizeObserver(placeAll);
      tocs.forEach(t => { const b = t.querySelector('.toc-body'); if (b) mo.observe(b); });
    }
    document.fonts?.ready.then(() => { measure(); onScroll(); placeAll(); }).catch(() => {});
    document.addEventListener('docs:toc-open', placeAll);
  }

  initTOC();
  document.addEventListener('astro:page-load', initTOC);
</script>
