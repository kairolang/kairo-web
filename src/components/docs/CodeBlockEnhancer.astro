---
// Wraps Shiki code blocks in an ASCII terminal frame (runs client-side after render):
//   ┌─[ kairo ]──────────────────── 12 lines ─ [copy] ┐
---
<script>
  function enhanceCodeBlocks() {
    document.querySelectorAll<HTMLElement>('article.prose pre.astro-code').forEach(pre => {
      if (pre.parentElement?.classList.contains('code-block-wrap')) return; // already wrapped

      const classes = Array.from(pre.classList);
      const langClass = classes.find(c => c.startsWith('language-'));
      const lang = (pre.dataset.language || (langClass ? langClass.replace('language-', '') : '') || 'code')
        .replace(/[^a-z0-9+#._-]/gi, '');
      const lines = (pre.querySelectorAll('.line').length) || (pre.textContent ?? '').replace(/\n$/, '').split('\n').length;

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrap';

      const header = document.createElement('div');
      header.className = 'code-block-header';
      header.innerHTML = `
        <span class="code-block-lang">${lang}</span>
        <span class="code-block-rule" aria-hidden="true"></span>
        <span class="code-block-meta" aria-hidden="true">${lines} line${lines === 1 ? '' : 's'}</span>
        <button type="button" class="code-copy-btn" aria-label="Copy code"><span class="code-copy-label">copy</span></button>
        <span class="code-copy-status sr-only" role="status" aria-live="polite"></span>
      `;

      pre.parentNode!.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(pre);

      // Copy button: "[copy]" -> "[ok] copied" (or "[err]")
      let timer = 0;
      header.querySelector('.code-copy-btn')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const label = btn.querySelector('.code-copy-label')!;
        const status = header.querySelector('.code-copy-status')!;
        const code = pre.textContent ?? '';
        let ok = true;
        try {
          await navigator.clipboard.writeText(code);
        } catch {
          // fallback for non-secure contexts / denied permission
          try {
            const ta = document.createElement('textarea');
            ta.value = code;
            ta.setAttribute('readonly', '');
            ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none';
            document.body.appendChild(ta);
            ta.select();
            ok = document.execCommand('copy');
            ta.remove();
          } catch { ok = false; }
        }
        label.textContent = ok ? 'copied' : 'failed';
        status.textContent = ok ? 'Code copied to clipboard' : 'Copy failed';
        btn.classList.toggle('copied', ok);
        btn.classList.toggle('failed', !ok);
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          label.textContent = 'copy';
          status.textContent = '';
          btn.classList.remove('copied', 'failed');
        }, 1600);
      });
    });
  }

  enhanceCodeBlocks();
  document.addEventListener('astro:page-load', enhanceCodeBlocks);

  // ── Code hints ────────────────────────────────────────────────
  // Popover for `.code-hint` spans emitted by shiki-code-hints.mjs. One shared
  // element on <body>, fixed-positioned so the code block's overflow can't clip it.
  let pop: HTMLDivElement | null = null;
  let shownFor: HTMLElement | null = null;
  let pinned = false;

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const inlineCode = (s: string) => escapeHtml(s).replace(/`([^`]+)`/g, '<code>$1</code>');

  function showHint(el: HTMLElement) {
    if (!pop) {
      pop = document.createElement('div');
      pop.className = 'code-hint-pop';
      pop.id = 'code-hint-pop';
      pop.setAttribute('role', 'tooltip');
      document.body.appendChild(pop);
    }
    pop.innerHTML = `
      <p class="code-hint-title">${inlineCode(el.dataset.hintTitle ?? '')}</p>
      <p class="code-hint-body">${inlineCode(el.dataset.hintBody ?? '')}</p>
    `;
    pop.classList.add('visible');

    const gap = 9;
    const edge = 12;
    const r = el.getBoundingClientRect();
    const left = Math.max(edge, Math.min(r.left, window.innerWidth - pop.offsetWidth - edge));
    const below = r.top - pop.offsetHeight - gap < edge;
    pop.classList.toggle('below', below);
    pop.style.left = `${left}px`;
    pop.style.top = `${below ? r.bottom + gap : r.top - pop.offsetHeight - gap}px`;
    pop.style.setProperty('--pole-x', `${Math.min(r.left - left, pop.offsetWidth - 14)}px`);

    shownFor?.removeAttribute('aria-describedby');
    el.setAttribute('aria-describedby', pop.id);
    shownFor = el;
  }

  function hideHint() {
    pop?.classList.remove('visible');
    shownFor?.removeAttribute('aria-describedby');
    shownFor = null;
    pinned = false;
  }

  const hintFrom = (e: Event) => (e.target as Element | null)?.closest?.<HTMLElement>('.code-hint') ?? null;

  document.addEventListener('mouseover', e => {
    const el = hintFrom(e);
    if (el && el !== shownFor) { pinned = false; showHint(el); }
  });
  document.addEventListener('mouseout', e => {
    if (hintFrom(e) && !pinned) hideHint();
  });
  document.addEventListener('focusin', e => {
    const el = hintFrom(e);
    if (el) showHint(el);
  });
  document.addEventListener('focusout', e => {
    if (hintFrom(e)) hideHint();
  });
  // Tap / click pins the hint open (touch has no hover); a second one closes it.
  document.addEventListener('click', e => {
    const el = hintFrom(e);
    if (!el) return hideHint();
    if (pinned && el === shownFor) return hideHint();
    showHint(el);
    pinned = true;
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') hideHint();
  });
  window.addEventListener('scroll', hideHint, { passive: true, capture: true });
  window.addEventListener('resize', hideHint);
  document.addEventListener('astro:before-swap', hideHint);
</script>

<style is:global>
  /* ── ASCII code frame ────────────────────────────────────────────
     ┌─[ kairo ]─────────────────────── 12 lines  [copy] ┐
     │ code                                               │
     └────────────────────────────────────────────────────┘
     1px frame + brighter corner ticks (same recipe as .ascii-frame). */
  .code-block-wrap {
    --c: var(--frame-corner);
    position: relative;
    margin: 1.5rem 0;
    border: 1px solid var(--frame-line);
    border-radius: 0;
    background-color: var(--bg-2);
    background-image:
      linear-gradient(var(--c), var(--c)), linear-gradient(var(--c), var(--c)),
      linear-gradient(var(--c), var(--c)), linear-gradient(var(--c), var(--c));
    background-size: var(--corner-len) 1px, 1px var(--corner-len), var(--corner-len) 1px, 1px var(--corner-len);
    background-position: 0 100%, 0 100%, 100% 100%, 100% 100%;
    background-repeat: no-repeat;
    background-origin: border-box;
    box-shadow: none;
    overflow: hidden;
  }

  .code-block-header {
    display: flex;
    align-items: center;
    gap: 1ch;
    min-width: 0;
    padding: 0 0 0 1ch;
    background: var(--bg-3);
    border-bottom: 1px solid var(--frame-line);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1;
    height: 2.15rem;
  }

  /* "─[ kairo ]" */
  .code-block-lang {
    flex-shrink: 0;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--text-2);
    white-space: nowrap;
  }
  .code-block-lang::before { content: '─[ '; content: '─[ ' / ''; color: var(--text-3); font-weight: 400; }
  .code-block-lang::after  { content: ' ]'; content: ' ]' / ''; color: var(--text-3); font-weight: 400; }

  /* "──────────" filler */
  .code-block-rule {
    flex: 1 1 auto;
    min-width: 1ch;
    height: 1px;
    background: var(--frame-line);
  }
  .code-block-meta {
    flex-shrink: 0;
    color: var(--text-3);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* "[copy]" — hover sweeps an inverse red block in steps */
  .code-copy-btn {
    flex-shrink: 0;
    align-self: stretch;
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0 1.4ch;
    border: 0;
    border-left: 1px solid var(--frame-line);
    border-radius: 0;
    font: inherit;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--text-2);
    background-color: transparent;
    background-image: linear-gradient(var(--red), var(--red));
    background-repeat: no-repeat;
    background-position: 0 0;
    background-size: 0% 100%;
    cursor: pointer;
    transition:
      background-size var(--dur-fast) steps(5, end),
      color 0s linear calc(var(--dur-fast) / 2);
  }
  .code-copy-btn::before { content: '['; content: '[' / ''; }
  .code-copy-btn::after  { content: ']'; content: ']' / ''; }
  .code-copy-btn:hover,
  .code-copy-btn:focus-visible {
    background-size: 100% 100%;
    color: var(--on-red);
  }
  .code-copy-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .code-copy-btn:active { transform: translateY(1px); }
  .code-copy-btn.copied { color: #3fb950; background-size: 0% 100%; }
  .code-copy-btn.failed { color: var(--accent); background-size: 0% 100%; }
  [data-theme="light"] .code-copy-btn.copied { color: #1a7f37; }

  /* Override Shiki pre inside code-block-wrap */
  .code-block-wrap pre.astro-code {
    margin: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    padding: 1.05rem 1.4rem 1.15rem !important;
    background: transparent !important;
  }
  .prose .code-block-wrap pre {
    margin: 0 !important;
    border: none !important;
  }

  @media (max-width: 480px) {
    .code-block-meta { display: none; }
    .code-block-wrap pre.astro-code { padding: 0.9rem 1rem 1rem !important; }
  }

  /* ── Code hints ──────────────────────────────────────────────── */
  /* The marker is absolutely positioned so it never shifts the code's columns. */
  .astro-code .code-hint {
    position: relative;
    cursor: help;
    border-bottom: 1px dotted var(--text-3);
    border-radius: 0;
    outline: none;
  }
  .astro-code .code-hint::before {
    content: '';
    position: absolute;
    left: -3.5px;
    top: 0;
    border-left: 3.5px solid transparent;
    border-right: 3.5px solid transparent;
    border-top: 4.5px solid var(--accent);
    opacity: 0.75;
  }
  .astro-code .code-hint:hover,
  .astro-code .code-hint:focus-visible,
  .astro-code .code-hint[aria-describedby] {
    border-bottom: 1px solid var(--accent);
  }
  .astro-code .code-hint:hover::before,
  .astro-code .code-hint:focus-visible::before,
  .astro-code .code-hint[aria-describedby]::before { opacity: 1; }
  .astro-code .code-hint:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 1px;
  }

  /* Popover: a square terminal note on a 1-char "pole".
     ┌─[ hint ]──────────┐
     │ title              │
     │ body               │
     └────────────────────┘                                       */
  .code-hint-pop {
    position: fixed;
    z-index: 200;
    top: 0;
    left: 0;
    width: max-content;
    max-width: min(360px, calc(100vw - 24px));
    padding: 10px 14px 11px;
    background: var(--bg-3);
    border: 1px solid var(--border-hi);
    border-left: 3px solid var(--accent);
    border-radius: 0;
    box-shadow: var(--shadow-hard);
    font-family: var(--font-sans);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path var(--dur-fast) steps(4, end),
      opacity 0s linear,
      visibility 0s linear var(--dur-fast);
  }
  .code-hint-pop.below { clip-path: inset(0 0 100% 0); }
  .code-hint-pop.visible {
    opacity: 1;
    visibility: visible;
    clip-path: inset(-20px -20px -20px -20px);
    transition-delay: 0s;
  }
  .code-hint-pop::after {
    content: '';
    position: absolute;
    left: calc(var(--pole-x, 0px) - 2px);
    top: 100%;
    width: 1px;
    height: 9px;
    background: var(--accent);
  }
  .code-hint-pop.below::after {
    top: auto;
    bottom: 100%;
  }
  .code-hint-title {
    margin: 0 0 4px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
  }
  .code-hint-title::before { content: '// '; content: '// ' / ''; color: var(--text-3); font-weight: 400; }
  .code-hint-body {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--text-2);
  }
  .code-hint-pop code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--text);
    background: none;
    border: none;
    padding: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .code-copy-btn,
    .code-hint-pop { transition: none; }
  }
</style>
