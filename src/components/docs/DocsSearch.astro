---
---
<div class="search-wrap">
  <button id="search-trigger" class="search-trigger" aria-label="Search docs (Ctrl+K)">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
    </svg>
    <span class="search-trigger-text">Search docs...</span>
    <kbd class="search-kbd">⌘K</kbd>
  </button>
</div>

<!-- Portal: search modal -->
<div id="search-modal" class="search-modal" role="dialog" aria-label="Search" aria-modal="true" aria-hidden="true">
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-panel">

    <!-- Input row -->
    <div class="search-input-row">
      <svg class="search-input-icon" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input
        id="search-input"
        class="search-input"
        type="search"
        placeholder="Search documentation..."
        autocomplete="off"
        spellcheck="false"
        aria-autocomplete="list"
        aria-controls="search-result-list"
      />
      <button id="search-close-btn" class="search-close-btn" aria-label="Close search">
        <span>Esc</span>
      </button>
    </div>

    <!-- Results -->
    <div id="search-result-list" class="search-results" role="listbox"></div>

    <!-- Footer hints -->
    <div class="search-footer">
      <span class="search-hint-item">
        <kbd>↑</kbd><kbd>↓</kbd> navigate
      </span>
      <span class="search-hint-item">
        <kbd>↵</kbd> open
      </span>
      <span class="search-hint-item">
        <kbd>Esc</kbd> close
      </span>
      <span class="search-count" id="search-count"></span>
    </div>
  </div>
</div>

<style>
  .search-wrap { padding: 0 1.25rem 1.25rem; }

  .search-trigger {
    width: 100%;
    background: var(--bg-3);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    color: var(--text-3);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
    text-align: left;
  }
  .search-trigger:hover {
    border-color: var(--border-hi);
    color: var(--text-2);
  }
  .search-trigger-text { flex: 1; }
  .search-kbd {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 1px 6px;
    font-size: 0.65rem;
    color: var(--text-3);
    font-family: var(--font-sans);
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  /* Modal */
  .search-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
  }
  .search-modal.open { display: flex; }
  .search-modal.open .search-panel {
    animation: fadeUp 0.3s var(--ease-out) both;
  }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .search-panel {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 640px;
    margin: 0 1rem;
    background: var(--bg-2);
    border: 1px solid var(--border-hi);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  /* Input row */
  .search-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
  }
  .search-input-icon { color: var(--text-3); flex-shrink: 0; }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--text);
    caret-color: var(--accent);
    min-width: 0;
  }
  .search-input::placeholder { color: var(--text-3); }
  .search-input::-webkit-search-cancel-button { display: none; }

  .search-close-btn {
    display: flex;
    align-items: center;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    color: var(--text-3);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    padding: 3px 9px;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
    flex-shrink: 0;
  }
  .search-close-btn:hover {
    border-color: var(--border-hi);
    color: var(--text);
  }

  /* Results */
  .search-results {
    max-height: 420px;
    overflow-y: auto;
    scrollbar-width: thin;
    padding: 6px 0;
  }

  /* Footer */
  .search-footer {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 10px 16px;
    border-top: 1px solid var(--border);
    background: var(--bg-3);
  }
  .search-hint-item {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: var(--text-3);
  }
  .search-hint-item kbd {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 1px 5px;
    font-size: 0.65rem;
    font-family: var(--font-sans);
    color: var(--text-2);
    min-width: 20px;
    text-align: center;
  }
  .search-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-3);
  }
</style>

<!-- Result item styles are global because items are rendered from JS -->
<style is:global>
  .search-empty {
    padding: 2.5rem 1.5rem;
    text-align: center;
    color: var(--text-3);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .search-empty svg { color: var(--text-3); margin-bottom: 0.75rem; }
  .search-empty p {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    margin: 0;
    line-height: 1.5;
  }
  .search-empty .search-hint-small {
    font-size: 0.78rem;
    opacity: 0.6;
    margin-top: 0.25rem;
  }

  .result-group-label {
    padding: 12px 18px 4px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .result-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 14px;
    margin: 1px 8px;
    border-radius: var(--r-sm);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease);
    cursor: pointer;
  }
  .result-item:hover,
  .result-item[aria-selected="true"] {
    background: color-mix(in srgb, var(--text) 6%, transparent);
  }
  .result-icon {
    color: var(--text-3);
    flex-shrink: 0;
    margin-top: 3px;
  }
  .result-item[aria-selected="true"] .result-icon { color: var(--accent); }

  .result-body { min-width: 0; flex: 1; }
  .result-title-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }
  .result-title {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .result-heading {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    color: var(--text-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
  }
  .result-heading::before {
    content: '# ';
    color: var(--text-3);
    opacity: 0.7;
  }
  .result-desc {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--text-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
  }
  .result-title mark,
  .result-desc mark,
  .result-heading mark {
    background: color-mix(in srgb, var(--red) 22%, transparent);
    color: var(--text);
    border-radius: 3px;
    padding: 0 1px;
    font-style: normal;
  }
  .result-arrow {
    color: var(--text-3);
    flex-shrink: 0;
    margin-top: 4px;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease);
  }
  .result-item:hover .result-arrow,
  .result-item[aria-selected="true"] .result-arrow { opacity: 1; color: var(--accent); }

  .no-results {
    padding: 2rem 1.5rem;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-3);
  }
  .no-results strong {
    color: var(--text-2);
    font-weight: 600;
  }
  .no-results a { color: var(--accent); }
</style>

<script>
  interface SearchHeading {
    text: string;
    slug: string;
  }
  interface SearchEntry {
    title: string;
    description: string;
    section: string;
    url: string;
    headings: SearchHeading[];
    body: string;
  }
  interface ScoredResult {
    entry: SearchEntry;
    score: number;
    heading: SearchHeading | null; // best matching heading (deep link target)
    snippet: string;               // context around the match in the body
  }

  let index: SearchEntry[] | null = null;
  let focusIdx = -1;
  let searchSeq = 0;
  const RESULT_LIMIT = 10;

  async function loadIndex(): Promise<SearchEntry[]> {
    if (index) return index;
    try {
      const res = await fetch('/search.json');
      index = await res.json();
    } catch {
      index = [];
    }
    return index!;
  }

  /* ── Ranking ─────────────────────────────────────────────────────
     AND semantics: every query token must appear somewhere in the
     entry (title, section, headings, description, or body), otherwise
     the entry is dropped. Field weights determine ordering. */
  function scoreEntry(entry: SearchEntry, query: string, tokens: string[]): ScoredResult | null {
    const title = entry.title.toLowerCase();
    const section = entry.section.toLowerCase();
    const desc = entry.description.toLowerCase();
    const body = entry.body.toLowerCase();

    let score = 0;
    let bestHeading: SearchHeading | null = null;
    let bestHeadingScore = 0;

    // Whole-query bonuses
    if (title === query) score += 1000;
    else if (title.startsWith(query)) score += 480;
    else if (title.includes(query)) score += 260;
    if (desc.includes(query)) score += 70;
    if (body.includes(query)) score += 50;

    for (const heading of entry.headings) {
      const h = heading.text.toLowerCase();
      let hs = 0;
      if (h === query) hs = 320;
      else if (h.startsWith(query)) hs = 220;
      else if (h.includes(query)) hs = 140;
      if (hs > bestHeadingScore) {
        bestHeadingScore = hs;
        bestHeading = heading;
      }
    }
    score += bestHeadingScore;

    // Per-token: every token must match somewhere
    for (const t of tokens) {
      let tokenScore = 0;

      if (title.includes(t)) {
        // word-prefix matches rank above mid-word hits
        tokenScore += new RegExp(`(^|[^a-z0-9])${escapeRe(t)}`).test(title) ? 120 : 70;
      }
      if (section.includes(t)) tokenScore += 25;
      if (desc.includes(t)) tokenScore += 30;

      if (tokenScore === 0 || bestHeadingScore === 0) {
        for (const heading of entry.headings) {
          if (heading.text.toLowerCase().includes(t)) {
            tokenScore += 45;
            if (!bestHeading) bestHeading = heading;
            break;
          }
        }
      }
      if (body.includes(t)) tokenScore += 12;

      if (tokenScore === 0) return null; // AND semantics
      score += tokenScore;
    }

    // Context snippet around the first match in the body
    let snippet = '';
    const probe = body.indexOf(query) >= 0 ? query : tokens.find(t => body.includes(t));
    if (probe) {
      const at = body.indexOf(probe);
      const start = Math.max(0, at - 48);
      const end = Math.min(entry.body.length, at + probe.length + 72);
      snippet = (start > 0 ? '…' : '') + entry.body.slice(start, end).trim() + (end < entry.body.length ? '…' : '');
    }

    return { entry, score, heading: bestHeading, snippet };
  }

  function escapeRe(s: string): string {
    return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function highlight(text: string, tokens: string[]): string {
    let out = escapeHtml(text);
    if (!tokens.length) return out;
    const pattern = new RegExp(`(${tokens.map(escapeRe).join('|')})`, 'gi');
    return out.replace(pattern, '<mark>$1</mark>');
  }

  const EMPTY_STATE = `
    <div class="search-empty">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <p>Search across all documentation pages.</p>
      <p class="search-hint-small">Titles, headings, and page content are indexed.</p>
    </div>`;

  function setCount(text: string) {
    const el = document.getElementById('search-count');
    if (el) el.textContent = text;
  }

  function renderResults(results: ScoredResult[], query: string, tokens: string[]) {
    const container = document.getElementById('search-result-list');
    if (!container) return;
    focusIdx = -1;

    if (!results.length) {
      container.innerHTML = `
        <div class="no-results">
          No results for <strong>"${escapeHtml(query)}"</strong><br>
          <span style="font-size:0.78rem;opacity:0.7;display:block;margin-top:0.5rem;">Try different keywords or browse the <a href="/docs">docs</a>.</span>
        </div>`;
      setCount('');
      return;
    }

    // Group by section, preserving overall rank order
    const groups: Array<{ section: string; items: ScoredResult[] }> = [];
    for (const r of results) {
      let g = groups.find(g => g.section === r.entry.section);
      if (!g) {
        g = { section: r.entry.section, items: [] };
        groups.push(g);
      }
      g.items.push(r);
    }

    let html = '';
    let idx = 0;
    for (const g of groups) {
      html += `<div class="result-group-label">${escapeHtml(g.section)}</div>`;
      for (const r of g.items) {
        const url = r.heading ? `${r.entry.url}#${r.heading.slug}` : r.entry.url;
        const sub = r.snippet || r.entry.description;
        html += `
          <a class="result-item" href="${url}" role="option" aria-selected="false" data-idx="${idx++}">
            <svg class="result-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
            </svg>
            <div class="result-body">
              <div class="result-title-row">
                <span class="result-title">${highlight(r.entry.title, tokens)}</span>
                ${r.heading ? `<span class="result-heading">${highlight(r.heading.text, tokens)}</span>` : ''}
              </div>
              ${sub ? `<div class="result-desc">${highlight(sub, tokens)}</div>` : ''}
            </div>
            <svg class="result-arrow" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>`;
      }
    }

    container.innerHTML = html;
    setFocus(0);
  }

  function setFocus(idx: number) {
    const items = document.querySelectorAll<HTMLElement>('.result-item');
    if (!items.length) return;
    items.forEach(el => el.setAttribute('aria-selected', 'false'));
    const clamped = ((idx % items.length) + items.length) % items.length; // wrap around
    focusIdx = clamped;
    items[clamped]?.setAttribute('aria-selected', 'true');
    items[clamped]?.scrollIntoView({ block: 'nearest' });
  }

  async function handleInput(e: Event) {
    const raw = (e.target as HTMLInputElement).value;
    const query = raw.trim().toLowerCase();
    const seq = ++searchSeq;
    const container = document.getElementById('search-result-list');
    if (!container) return;

    if (!query) {
      container.innerHTML = EMPTY_STATE;
      setCount('');
      return;
    }

    const data = await loadIndex();
    if (seq !== searchSeq) return; // stale async result

    const tokens = query.split(/\s+/).filter(Boolean);
    const results: ScoredResult[] = [];
    for (const entry of data) {
      const r = scoreEntry(entry, query, tokens);
      if (r) results.push(r);
    }
    results.sort((a, b) => b.score - a.score);

    setCount(`${results.length} result${results.length === 1 ? '' : 's'}`);
    renderResults(results.slice(0, RESULT_LIMIT), raw.trim(), tokens);
  }

  function openModal() {
    const modal = document.getElementById('search-modal');
    const container = document.getElementById('search-result-list');
    if (container && !container.innerHTML.trim()) container.innerHTML = EMPTY_STATE;
    modal?.classList.add('open');
    modal?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    setTimeout(() => (document.getElementById('search-input') as HTMLInputElement)?.focus(), 30);
    loadIndex();
  }

  function closeModal() {
    const modal = document.getElementById('search-modal');
    modal?.classList.remove('open');
    modal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    const input = document.getElementById('search-input') as HTMLInputElement;
    if (input) input.value = '';
    const container = document.getElementById('search-result-list');
    if (container) container.innerHTML = EMPTY_STATE;
    setCount('');
    focusIdx = -1;
  }

  function init() {
    document.getElementById('search-trigger')?.addEventListener('click', openModal);
    document.getElementById('search-backdrop')?.addEventListener('click', closeModal);
    document.getElementById('search-close-btn')?.addEventListener('click', closeModal);
    document.getElementById('search-input')?.addEventListener('input', handleInput);

    document.getElementById('search-input')?.addEventListener('keydown', (e) => {
      const items = document.querySelectorAll<HTMLElement>('.result-item');
      if (e.key === 'ArrowDown') { e.preventDefault(); setFocus(focusIdx + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setFocus(focusIdx - 1); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        const target = items[focusIdx >= 0 ? focusIdx : 0];
        if (target) window.location.href = (target as HTMLAnchorElement).href;
      }
      else if (e.key === 'Escape') { closeModal(); }
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        document.getElementById('search-modal')?.classList.contains('open')
          ? closeModal() : openModal();
      }
      if (e.key === '/' && !document.getElementById('search-modal')?.classList.contains('open')) {
        const tag = (document.activeElement?.tagName || '').toLowerCase();
        if (tag !== 'input' && tag !== 'textarea') {
          e.preventDefault();
          openModal();
        }
      }
      if (e.key === 'Escape' && document.getElementById('search-modal')?.classList.contains('open')) {
        closeModal();
      }
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
