---

---

<div class="search-wrap">
	<button id="search-trigger" class="search-trigger" aria-label="Search docs (Ctrl+K)">
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="14"
			height="14"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
		>
			<circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path>
		</svg>
		<span class="search-trigger-text">Search docs...</span>
		<kbd class="search-kbd">⌘K</kbd>
	</button>
</div>

<!-- Portal: search modal -->
<div
	id="search-modal"
	class="search-modal"
	role="dialog"
	aria-label="Search"
	aria-modal="true"
	aria-hidden="true"
>
	<div class="search-backdrop" id="search-backdrop"></div>
	<div class="search-panel">
		<!-- Input row -->
		<div class="search-input-row">
			<svg
				class="search-input-icon"
				xmlns="http://www.w3.org/2000/svg"
				width="17"
				height="17"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
			>
				<circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path>
			</svg>
			<input
				id="search-input"
				class="search-input"
				type="search"
				placeholder="Search documentation..."
				autocomplete="off"
				spellcheck="false"
				aria-autocomplete="list"
				aria-controls="search-result-list"
			/>

			<!-- Syntax help -->
			<div class="search-help-wrap">
				<button
					id="search-help-btn"
					class="search-help-btn"
					aria-label="Search syntax help"
					aria-expanded="false"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="15"
						height="15"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					>
						<circle cx="12" cy="12" r="10"></circle><path
							d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line
							x1="12"
							y1="17"
							x2="12.01"
							y2="17"></line>
					</svg>
				</button>
				<div
					id="search-help-popover"
					class="search-help-popover"
					role="tooltip"
					aria-hidden="true"
				>
					<div class="help-title">Search syntax</div>
					<div class="help-row">
						<code>"exact match"</code><span>whole words, in order</span>
					</div>
					<div class="help-row">
						<code>const -deprecated</code><span>exclude a term</span>
					</div>
					<div class="help-row">
						<code>section:language</code><span>limit to a section</span>
					</div>
					<div class="help-row">
						<code>-section:library</code><span>exclude a section</span>
					</div>
					<div class="help-row"><code>in:title</code><span>match titles only</span></div>
					<div class="help-row"><code>no:function</code><span>hide a category</span></div>
					<div class="help-row">
						<code>is:deprecated</code><span>only that category</span>
					</div>
				</div>
			</div>

			<button id="search-close-btn" class="search-close-btn" aria-label="Close search">
				<span>Esc</span>
			</button>
		</div>

		<!-- Correction / parse notice -->
		<div id="search-notice" class="search-notice" hidden></div>

		<!-- Results -->
		<div id="search-result-list" class="search-results" role="listbox"></div>

		<!-- Footer hints -->
		<div class="search-footer">
			<span class="search-hint-item">
				<kbd>↑</kbd><kbd>↓</kbd> navigate
			</span>
			<span class="search-hint-item">
				<kbd>↵</kbd> open
			</span>
			<span class="search-hint-item">
				<kbd>Esc</kbd> close
			</span>
			<span class="search-count" id="search-count"></span>
		</div>
	</div>
</div>

<style>
	.search-wrap {
		padding: 0 1.25rem 1.25rem;
	}

	.search-trigger {
		width: 100%;
		background: var(--bg-3);
		border: 1px solid var(--border);
		border-radius: var(--r-md);
		padding: 8px 12px;
		display: flex;
		align-items: center;
		gap: 8px;
		cursor: pointer;
		color: var(--text-3);
		font-family: var(--font-sans);
		font-size: 0.82rem;
		transition:
			border-color var(--dur-fast) var(--ease),
			color var(--dur-fast) var(--ease);
		text-align: left;
	}
	.search-trigger:hover {
		border-color: var(--border-hi);
		color: var(--text-2);
	}
	.search-trigger-text {
		flex: 1;
	}
	.search-kbd {
		background: var(--bg-2);
		border: 1px solid var(--border);
		border-radius: 5px;
		padding: 1px 6px;
		font-size: 0.65rem;
		color: var(--text-3);
		font-family: var(--font-sans);
		letter-spacing: 0.05em;
		flex-shrink: 0;
	}

	/* Modal */
	.search-modal {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 1000;
		align-items: flex-start;
		justify-content: center;
		padding-top: 12vh;
	}
	.search-modal.open {
		display: flex;
	}
	.search-modal.open .search-panel {
		animation: fadeUp 0.3s var(--ease-out) both;
	}

	.search-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.55);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.search-panel {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 640px;
		margin: 0 1rem;
		background: var(--bg-2);
		border: 1px solid var(--border-hi);
		border-radius: var(--r-lg);
		overflow: visible;
		box-shadow: var(--shadow-lg);
	}

	/* Input row */
	.search-input-row {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 14px 16px;
		border-bottom: 1px solid var(--border);
		position: relative;
	}
	.search-input-icon {
		color: var(--text-3);
		flex-shrink: 0;
	}

	.search-input {
		flex: 1;
		background: transparent;
		border: none;
		outline: none;
		font-family: var(--font-sans);
		font-size: 1rem;
		color: var(--text);
		caret-color: var(--accent);
		min-width: 0;
	}
	.search-input::placeholder {
		color: var(--text-3);
	}
	.search-input::-webkit-search-cancel-button {
		display: none;
	}

	/* Help affordance */
	.search-help-wrap {
		position: relative;
		flex-shrink: 0;
		display: flex;
	}
	.search-help-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		border: none;
		color: var(--text-3);
		cursor: pointer;
		padding: 2px;
		border-radius: var(--r-sm);
		transition: color var(--dur-fast) var(--ease);
	}
	.search-help-btn:hover,
	.search-help-btn[aria-expanded="true"] {
		color: var(--accent);
	}

	.search-help-popover {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		z-index: 10;
		width: 280px;
		background: var(--bg-2);
		border: 1px solid var(--border-hi);
		border-radius: var(--r-md);
		box-shadow: var(--shadow-lg);
		padding: 10px 6px 8px;
		display: none;
		animation: fadeUp 0.18s var(--ease-out) both;
	}
	.search-help-popover.open {
		display: block;
	}
	.help-title {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-3);
		padding: 2px 10px 8px;
	}
	.help-row {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 5px 10px;
	}
	.help-row code {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		background: var(--bg-3);
		border: 1px solid var(--border);
		border-radius: 5px;
		padding: 2px 7px;
		color: var(--text);
		white-space: nowrap;
		flex-shrink: 0;
		min-width: 132px;
	}
	.help-row span {
		font-family: var(--font-sans);
		font-size: 0.74rem;
		color: var(--text-3);
	}

	.search-close-btn {
		display: flex;
		align-items: center;
		background: transparent;
		border: 1px solid var(--border);
		border-radius: var(--r-pill);
		color: var(--text-3);
		font-family: var(--font-sans);
		font-size: 0.68rem;
		padding: 3px 9px;
		cursor: pointer;
		transition:
			border-color var(--dur-fast) var(--ease),
			color var(--dur-fast) var(--ease);
		flex-shrink: 0;
	}
	.search-close-btn:hover {
		border-color: var(--border-hi);
		color: var(--text);
	}

	/* Correction notice */
	.search-notice {
		padding: 9px 16px;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: 0.78rem;
		color: var(--text-2);
		background: var(--bg-3);
	}
	.search-notice strong {
		color: var(--text);
		font-weight: 600;
	}
	.search-notice a {
		color: var(--accent);
		cursor: pointer;
		text-decoration: none;
	}
	.search-notice a:hover {
		text-decoration: underline;
	}
	.search-notice .notice-chip {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		background: var(--bg-2);
		border: 1px solid var(--border);
		border-radius: 5px;
		padding: 1px 6px;
		color: var(--text);
	}

	/* Results */
	.search-results {
		max-height: 420px;
		overflow-y: auto;
		scrollbar-width: thin;
		padding: 6px 0;
	}

	/* Footer */
	.search-footer {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 10px 16px;
		border-top: 1px solid var(--border);
		background: var(--bg-3);
	}
	.search-hint-item {
		display: flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-sans);
		font-size: 0.68rem;
		color: var(--text-3);
	}
	.search-hint-item kbd {
		background: var(--bg-2);
		border: 1px solid var(--border);
		border-radius: 5px;
		padding: 1px 5px;
		font-size: 0.65rem;
		font-family: var(--font-sans);
		color: var(--text-2);
		min-width: 20px;
		text-align: center;
	}
	.search-count {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: 0.66rem;
		color: var(--text-3);
	}
</style>

<!-- Result item styles are global because items are rendered from JS -->
<style is:global>
	.search-empty {
		padding: 2.5rem 1.5rem;
		text-align: center;
		color: var(--text-3);
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.search-empty svg {
		color: var(--text-3);
		margin-bottom: 0.75rem;
	}
	.search-empty p {
		font-family: var(--font-sans);
		font-size: 0.875rem;
		margin: 0;
		line-height: 1.5;
	}
	.search-empty .search-hint-small {
		font-size: 0.78rem;
		opacity: 0.6;
		margin-top: 0.25rem;
	}

	.result-group-label {
		padding: 12px 18px 4px;
		font-family: var(--font-mono);
		font-size: 0.62rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-3);
	}

	.result-item {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		padding: 10px 14px;
		margin: 1px 8px;
		border-radius: var(--r-sm);
		text-decoration: none;
		transition: background var(--dur-fast) var(--ease);
		cursor: pointer;
	}
	.result-item:hover,
	.result-item[aria-selected="true"] {
		background: color-mix(in srgb, var(--text) 6%, transparent);
	}
	.result-icon {
		color: var(--text-3);
		flex-shrink: 0;
		margin-top: 3px;
	}
	.result-item[aria-selected="true"] .result-icon {
		color: var(--accent);
	}

	.result-body {
		min-width: 0;
		flex: 1;
	}
	.result-title-row {
		display: flex;
		align-items: baseline;
		gap: 8px;
		min-width: 0;
	}
	.result-title {
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--text);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.result-heading {
		font-family: var(--font-sans);
		font-size: 0.76rem;
		color: var(--text-3);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		flex-shrink: 1;
	}
	.result-heading::before {
		content: "# ";
		color: var(--text-3);
		opacity: 0.7;
	}
	.result-desc {
		font-family: var(--font-sans);
		font-size: 0.78rem;
		color: var(--text-3);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		margin-top: 2px;
	}
