---

---

<div class="search-wrap">
	<button
		id="search-trigger"
		class="search-trigger"
		type="button"
		aria-label="Search docs (Ctrl+K)"
		aria-haspopup="dialog"
		data-search-open
	>
		<span class="search-trigger-prompt" aria-hidden="true">&gt;</span>
		<span class="search-trigger-text">search docs<span class="search-trigger-cursor" aria-hidden="true">_</span></span>
		<kbd class="search-kbd" id="search-kbd">⌘K</kbd>
	</button>
</div>

<!-- Portal: search modal (moved to <body> on init so no transformed
     ancestor, e.g. the mobile drawer, can trap its position: fixed) -->
<div
	id="search-modal"
	class="search-modal"
	role="dialog"
	aria-label="Search documentation"
	aria-modal="true"
	aria-hidden="true"
>
	<div class="search-backdrop" id="search-backdrop"></div>
	<div class="search-panel">
		<!-- Title bar: ┌─[ search ]──────── ~/docs ─┐ -->
		<div class="search-titlebar" aria-hidden="true">
			<span class="search-titlebar-name">search</span>
			<span class="search-titlebar-rule"></span>
			<span class="search-titlebar-path">~/docs</span>
		</div>

		<!-- Input row: "> query█" -->
		<div class="search-input-row">
			<label for="search-input" class="search-input-prompt" aria-hidden="true">&gt;</label>
			<input
				id="search-input"
				class="search-input"
				type="search"
				placeholder="search docs_"
				autocomplete="off"
				spellcheck="false"
				aria-label="Search documentation"
				aria-autocomplete="list"
				aria-controls="search-result-list"
			/>

			<!-- Syntax help -->
			<div class="search-help-wrap">
				<button
					id="search-help-btn"
					class="search-help-btn"
					type="button"
					aria-label="Search syntax help"
					aria-expanded="false"
					aria-controls="search-help-popover"
				>
					?
				</button>
				<div
					id="search-help-popover"
					class="search-help-popover"
					role="tooltip"
					aria-hidden="true"
				>
					<div class="help-title">man search</div>
					<div class="help-row">
						<code>"exact match"</code><span>whole words, in order</span>
					</div>
					<div class="help-row">
						<code>const -deprecated</code><span>exclude a term</span>
					</div>
					<div class="help-row">
						<code>section:language</code><span>limit to a section</span>
					</div>
					<div class="help-row">
						<code>-section:library</code><span>exclude a section</span>
					</div>
					<div class="help-row"><code>in:title</code><span>match titles only</span></div>
					<div class="help-row"><code>no:function</code><span>hide a category</span></div>
					<div class="help-row">
						<code>is:deprecated</code><span>only that category</span>
					</div>
				</div>
			</div>

			<button id="search-close-btn" class="search-close-btn" type="button" aria-label="Close search">
				<span>esc</span>
			</button>
		</div>

		<!-- Correction / parse notice -->
		<div id="search-notice" class="search-notice" hidden></div>

		<!-- Results -->
		<div id="search-result-list" class="search-results" role="listbox" aria-label="Search results"></div>

		<!-- Footer hints -->
		<div class="search-footer">
			<span class="search-hint-item">
				<kbd>↑</kbd><kbd>↓</kbd> navigate
			</span>
			<span class="search-hint-item">
				<kbd>↵</kbd> open
			</span>
			<span class="search-hint-item search-hint-esc">
				<kbd>esc</kbd> close
			</span>
			<span class="search-count" id="search-count" aria-live="polite"></span>
		</div>
	</div>
</div>

<style>
	.search-wrap {
		padding: 0 0.75rem 1rem 1.25rem;
	}

	/* "> search docs_          [⌘K]" */
	.search-trigger {
		width: 100%;
		display: flex;
		align-items: center;
		gap: 1ch;
		padding: 7px 8px 7px 1ch;
		background: var(--bg-2);
		border: 1px solid var(--frame-line);
		border-radius: 0;
		cursor: pointer;
		color: var(--text-2);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-align: left;
		transition: border-color var(--dur-instant) steps(1, end);
	}
	.search-trigger:hover,
	.search-trigger:focus-visible {
		border-color: color-mix(in srgb, var(--red) 55%, var(--frame-line));
		color: var(--text);
	}
	.search-trigger-prompt {
		color: var(--accent);
		font-weight: 700;
	}
	.search-trigger-text {
		flex: 1;
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
	}
	/* static on calm pages; blinks only while the trigger is hovered/focused */
	.search-trigger-cursor {
		color: var(--accent);
		margin-left: 1px;
	}
	.search-trigger:hover .search-trigger-cursor,
	.search-trigger:focus-visible .search-trigger-cursor {
		animation: search-blink 1.06s steps(1, end) infinite;
	}
	.search-kbd {
		flex-shrink: 0;
		font-size: 0.66rem;
		color: var(--text-2);
		letter-spacing: 0.04em;
	}

	/* ── Modal ── */
	.search-modal {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 1000;
		align-items: flex-start;
		justify-content: center;
		padding-top: 12vh;
	}
	.search-modal.open {
		display: flex;
	}
	/* opens by "printing" top -> bottom, 4 steps */
	.search-modal.open .search-panel {
		animation: search-print var(--dur-fast) steps(4, end) both;
	}

	.search-backdrop {
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--bg) 84%, transparent);
	}
	/* faint dot lattice on the backdrop: texture, not motion */
	.search-backdrop::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: radial-gradient(color-mix(in srgb, var(--red) 22%, transparent) 1px, transparent 1.2px);
		background-size: 6px 6px;
		opacity: 0.5;
		pointer-events: none;
	}

	.search-panel {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 660px;
		margin: 0 1rem;
		background: var(--bg-2);
		border: 1px solid var(--border-hi);
		border-radius: 0;
		overflow: visible;
		box-shadow: var(--shadow-hard);
		font-family: var(--font-mono);
	}

	/* ── Title bar ── */
	.search-titlebar {
		display: flex;
		align-items: center;
		gap: 1ch;
		padding: 0 1ch;
		height: 1.9rem;
		background: var(--bg-3);
		border-bottom: 1px solid var(--border);
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		color: var(--text-2);
	}
	.search-titlebar-name::before { content: '─[ '; content: '─[ ' / ''; color: var(--text-3); }
	.search-titlebar-name::after  { content: ' ]'; content: ' ]' / ''; color: var(--text-3); }
	.search-titlebar-rule { flex: 1; height: 1px; background: var(--border-hi); }
	.search-titlebar-path { color: var(--accent); }

	/* ── Input row ── */
	.search-input-row {
		display: flex;
		align-items: center;
		gap: 1ch;
		padding: 12px 12px 12px 1.5ch;
		border-bottom: 1px solid var(--border);
		position: relative;
	}
	.search-input-prompt {
		flex-shrink: 0;
		color: var(--accent);
		font-weight: 700;
		font-size: 1rem;
		line-height: 1;
	}

	.search-input {
		flex: 1;
		min-width: 0;
		background: transparent;
		border: none;
		border-radius: 0;
		outline: none;
		font-family: var(--font-mono);
		font-size: 1rem;
		color: var(--text);
		caret-color: var(--accent);
		caret-shape: block;
		-webkit-appearance: none;
		appearance: none;
	}
	.search-input::placeholder {
		color: var(--text-3);
		opacity: 1;
	}
	.search-input::-webkit-search-cancel-button {
		display: none;
	}

	/* Help affordance "[?]" */
	.search-help-wrap {
		position: relative;
		flex-shrink: 0;
		display: flex;
	}
	.search-help-btn,
	.search-close-btn {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		background: transparent;
		border: 0;
		border-radius: 0;
		color: var(--text-2);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		line-height: 1.5;
		padding: 2px 4px;
		cursor: pointer;
	}
	.search-help-btn::before,
	.search-close-btn::before { content: '['; content: '[' / ''; color: var(--text-3); }
	.search-help-btn::after,
	.search-close-btn::after { content: ']'; content: ']' / ''; color: var(--text-3); }
	.search-help-btn:hover,
	.search-help-btn[aria-expanded="true"],
	.search-close-btn:hover {
		background: var(--accent);
		color: var(--on-red);
	}
	.search-help-btn:hover::before,
	.search-help-btn:hover::after,
	.search-help-btn[aria-expanded="true"]::before,
	.search-help-btn[aria-expanded="true"]::after,
	.search-close-btn:hover::before,
	.search-close-btn:hover::after { color: inherit; }

	.search-help-popover {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		z-index: 10;
		width: 300px;
		max-width: calc(100vw - 3rem);
		background: var(--bg-2);
		border: 1px solid var(--border-hi);
		border-radius: 0;
		box-shadow: var(--shadow-hard);
		padding: 8px 0 8px;
		display: none;
	}
	.search-help-popover.open {
		display: block;
		animation: search-print var(--dur-fast) steps(3, end) both;
	}
	.help-title {
		font-size: 0.64rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-2);
		padding: 2px 12px 8px;
		border-bottom: 1px dashed var(--border);
		margin-bottom: 4px;
	}
	.help-title::before { content: '$ '; content: '$ ' / ''; color: var(--accent); }
	.help-row {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 4px 12px;
	}
	.help-row code {
		font-size: 0.72rem;
		background: var(--bg-3);
		border: 1px solid var(--border);
		border-radius: 0;
		padding: 1px 6px;
		color: var(--text);
		white-space: nowrap;
		flex-shrink: 0;
		min-width: 136px;
	}
	.help-row span {
		font-size: 0.72rem;
		color: var(--text-2);
	}

	/* Correction notice */
	.search-notice {
		padding: 8px 1.5ch;
		border-bottom: 1px solid var(--border);
		font-size: 0.74rem;
		color: var(--text-2);
		background: var(--bg-3);
	}
	.search-notice::before { content: '[i] '; content: '[i] ' / ''; color: var(--accent); }
	.search-notice :global(strong) {
		color: var(--text);
		font-weight: 600;
	}
	.search-notice :global(a) {
		color: var(--accent);
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.search-notice :global(a:hover) {
		background: var(--accent);
		color: var(--on-red);
		text-decoration: none;
	}
	.search-notice :global(.notice-chip) {
		font-size: 0.72rem;
		background: var(--bg-2);
		border: 1px solid var(--border);
		border-radius: 0;
		padding: 0 5px;
		color: var(--text);
	}

	/* Results */
	.search-results {
		max-height: min(440px, 56vh);
		overflow-y: auto;
		scrollbar-width: thin;
		padding: 4px 0 6px;
	}

	/* Footer */
	.search-footer {
		display: flex;
		align-items: center;
		gap: 1.5ch 2ch;
		flex-wrap: wrap;
		padding: 8px 1.5ch;
		border-top: 1px solid var(--border);
		background: var(--bg-3);
	}
	.search-hint-item {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: 0.66rem;
		color: var(--text-2);
	}
	.search-hint-item kbd {
		font-size: 0.64rem;
		min-width: 2.2ch;
		text-align: center;
	}
	.search-count {
		margin-left: auto;
		font-size: 0.66rem;
		color: var(--text-2);
		font-variant-numeric: tabular-nums;
	}

	@keyframes search-print {
		from { clip-path: inset(0 0 100% 0); }
		to   { clip-path: inset(0 0 -20px 0); }
	}
	@keyframes search-blink {
		0%, 50% { opacity: 1; }
		50.01%, 100% { opacity: 0; }
	}

	@media (max-width: 640px) {
		.search-modal { padding-top: 4.5rem; }
		.search-panel { margin: 0 0.75rem; }
		.search-hint-item:not(.search-hint-esc) { display: none; }
	}
</style>

<!-- Result item styles are global because items are rendered from JS -->
<style is:global>
	.search-empty {
		padding: 1.5rem 1.5ch 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1.7;
		color: var(--text-2);
	}
	.search-empty p { margin: 0; }
	.search-empty .se-cmd::before { content: '$ '; content: '$ ' / ''; color: var(--accent); }
	.search-empty .se-cmd { color: var(--text); }
	.search-empty .se-out { color: var(--text-2); padding-left: 2ch; }
	.search-empty .se-out::before { content: '├── '; content: '├── ' / ''; color: var(--text-3); }
	.search-empty .se-out.last::before { content: '└── '; content: '└── ' / ''; }
	.search-empty .se-tip { margin-top: 0.6rem; color: var(--text-2); }
	.search-empty .se-tip code { font-size: 0.72rem; }
	.search-empty .se-help { color: var(--text); }

	.result-group-label {
		padding: 10px 1.5ch 4px;
		font-family: var(--font-mono);
		font-size: 0.64rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-2);
	}
	.result-group-label::before { content: '// '; content: '// ' / ''; color: var(--text-3); }

	.result-item {
		display: flex;
		align-items: flex-start;
		gap: 1ch;
		padding: 7px 1.5ch 8px;
		border-left: 2px solid transparent;
		border-radius: 0;
		text-decoration: none;
		cursor: pointer;
		font-family: var(--font-mono);
	}
	.result-item:hover {
		background: color-mix(in srgb, var(--text) 5%, transparent);
	}
	.result-item[aria-selected="true"] {
		background: color-mix(in srgb, var(--red) 11%, transparent);
		border-left-color: var(--red);
	}
	.result-icon {
		flex-shrink: 0;
		width: 1ch;
		font-size: 0.86rem;
		line-height: 1.45;
		font-weight: 700;
		color: var(--text-3);
	}
	.result-item[aria-selected="true"] .result-icon {
		color: var(--accent);
	}

	.result-body {
		min-width: 0;
		flex: 1;
	}
	.result-title-row {
		display: flex;
		align-items: baseline;
		gap: 1.2ch;
		min-width: 0;
	}
	.result-title {
		font-size: 0.86rem;
		font-weight: 600;
		line-height: 1.45;
		color: var(--text);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		flex-shrink: 0;
		max-width: 70%;
	}
	.result-heading {
		font-size: 0.74rem;
		color: var(--text-2);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		flex-shrink: 1;
		min-width: 0;
	}
	.result-heading::before {
		content: "# ";
		content: "# " / "";
		color: var(--accent);
	}
	.result-desc {
		font-family: var(--font-sans);
		font-size: 0.78rem;
		line-height: 1.5;
		color: var(--text-2);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		margin-top: 1px;
	}
	.result-title mark,
	.result-desc mark,
	.result-heading mark {
		background: color-mix(in srgb, var(--red) 30%, transparent);
		color: var(--text);
		border-radius: 0;
		padding: 0;
		box-shadow: inset 0 -1px 0 var(--accent);
		font-style: normal;
	}
	.result-arrow {
		flex-shrink: 0;
		font-size: 0.8rem;
		line-height: 1.55;
		color: var(--accent);
		visibility: hidden;
	}
	.result-item:hover .result-arrow,
	.result-item[aria-selected="true"] .result-arrow {
		visibility: visible;
	}

	.no-results {
		padding: 1.5rem 1.5ch;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		line-height: 1.7;
		color: var(--text-2);
	}
	.no-results .nr-err { color: var(--accent); }
	.no-results .nr-err::before { content: '[err] '; content: '[err] ' / ''; }
	.no-results strong {
		color: var(--text);
		font-weight: 600;
	}
	.no-results a {
		color: var(--accent);
	}
	.no-results a:hover { background: var(--accent); color: var(--on-red); }
</style>

<script>
	interface SearchHeading {
		text: string;
		slug: string;
	}
	interface SearchEntry {
		title: string;
		description: string;
		section: string;
		url: string;
		headings: SearchHeading[];
		body: string;
		/* Optional category metadata. If present in search.json, no:/is:/category
       filtering uses it directly. If absent, we approximate against
       section + heading text. */
		tags?: string[];
		kind?: string;
	}
	interface ScoredResult {
		entry: SearchEntry;
		score: number;
		heading: SearchHeading | null;
		snippet: string;
	}

	/* Parsed query model */
	interface ParsedQuery {
		phrases: string[];
		positive: string[];
		negative: string[];
		sections: string[];
		exclSections: string[];
		fields: string[]; // restrict scoring to these fields; empty = all
		no: string[];
		is: string[];
		raw: string; // remaining free text (for the "did you mean" link)
	}

	let index: SearchEntry[] | null = null;
	let vocab: string[] | null = null; // known terms for fuzzy fallback
	let sectionVocab: string[] | null = null;
	let focusIdx = -1;
	let searchSeq = 0;
	const RESULT_LIMIT = 10;
	const LANG_RESERVED = 4;

	const LANG_PREFIX = "language";

	async function loadIndex(): Promise<SearchEntry[]> {
		if (index) return index;
		try {
			const res = await fetch("/search.json");
			index = await res.json();
		} catch {
			index = [];
		}
		buildVocab(index!);
		return index!;
	}

	/* Build a vocabulary of real terms for bounded fuzzy correction.
     Titles, headings, and section names — never raw body text, so we
     never fuzzy-match against incidental words. */
	function buildVocab(entries: SearchEntry[]) {
		if (vocab) return;
		const terms = new Set<string>();
		const sections = new Set<string>();
		for (const e of entries) {
			for (const w of e.title.toLowerCase().split(/[^a-z0-9]+/)) {
				if (w.length >= 3) terms.add(w);
			}
			for (const h of e.headings) {
				for (const w of h.text.toLowerCase().split(/[^a-z0-9]+/)) {
					if (w.length >= 3) terms.add(w);
				}
			}
			if (e.section) sections.add(e.section.toLowerCase());
		}
		vocab = [...terms];
		sectionVocab = [...sections];
	}

	/* ── Query parser ────────────────────────────────────────────────
     GitHub-style qualifier grammar. Single pass with a tokenizer that
     respects quoted phrases. */
	function parseQuery(raw: string): ParsedQuery {
		const q: ParsedQuery = {
			phrases: [],
			positive: [],
			negative: [],
			sections: [],
			exclSections: [],
			fields: [],
			no: [],
			is: [],
			raw: "",
		};
		const freeBits: string[] = [];

		// Tokenize: quoted runs stay intact, everything else splits on space.
		const re = /(-?)(?:"([^"]*)"?|(\S+))/g;
		let m: RegExpExecArray | null;
		while ((m = re.exec(raw)) !== null) {
			const neg = m[1] === "-";
			const phrase = m[2];
			const word = m[3];

			if (phrase !== undefined) {
				const p = phrase.trim().toLowerCase();
				if (p) {
					if (neg) q.negative.push(p);
					else {
						q.phrases.push(p);
						freeBits.push(p);
					}
				}
				continue;
			}
			if (word === undefined) continue;

			// qualifier?  key:value
			const qm = /^([a-z]+):(.+)$/i.exec(word);
			if (qm) {
				const key = qm[1].toLowerCase();
				let val = qm[2].toLowerCase();
				const valNeg = val.startsWith("!");
				if (valNeg) val = val.slice(1);

				switch (key) {
					case "section":
						if (neg || valNeg) q.exclSections.push(val);
						else q.sections.push(val);
						continue;
					case "in":
						if (
							[
								"title",
								"heading",
								"headings",
								"body",
								"desc",
								"description",
							].includes(val)
						) {
							q.fields.push(
								val === "headings"
									? "heading"
									: val === "description"
										? "desc"
										: val,
							);
						}
						continue;
					case "no":
						q.no.push(val);
						continue;
					case "is":
						if (neg) q.no.push(val);
						else q.is.push(val);
						continue;
					default:
						// unknown qualifier -> treat as plain text
						break;
				}
			}

			const w = word.toLowerCase();
			if (neg) q.negative.push(w);
			else {
				q.positive.push(w);
				freeBits.push(w);
			}
		}

		q.raw = freeBits.join(" ").trim();
		return q;
	}

	/* ── Fuzzy fallback (bounded Levenshtein) ────────────────────────── */
	function editDistance(a: string, b: string, max: number): number {
		if (Math.abs(a.length - b.length) > max) return max + 1;
		const prev = new Array(b.length + 1);
		const curr = new Array(b.length + 1);
		for (let j = 0; j <= b.length; j++) prev[j] = j;
		for (let i = 1; i <= a.length; i++) {
			curr[0] = i;
			let rowMin = curr[0];
			for (let j = 1; j <= b.length; j++) {
				const cost = a[i - 1] === b[j - 1] ? 0 : 1;
				curr[j] = Math.min(prev[j] + 1, curr[j - 1] + 1, prev[j - 1] + cost);
				if (curr[j] < rowMin) rowMin = curr[j];
			}
			if (rowMin > max) return max + 1; // early bail
			for (let j = 0; j <= b.length; j++) prev[j] = curr[j];
		}
		return prev[b.length];
	}

	function fuzzyCorrect(token: string, dict: string[]): string | null {
		const max = token.length >= 5 ? 2 : 1;
		let best: string | null = null;
		let bestD = max + 1;
		for (const term of dict) {
			if (Math.abs(term.length - token.length) > max) continue;
			const d = editDistance(token, term, max);
			if (d < bestD) {
				bestD = d;
				best = term;
				if (d === 0) break;
			}
		}
		return bestD <= max ? best : null;
	}

	/* Does an entry belong to a category? Prefers real tags/kind metadata,
     falls back to section + heading text when absent. */
	function entryHasCategory(entry: SearchEntry, cat: string): boolean {
		if (entry.tags && entry.tags.some((t) => t.toLowerCase().includes(cat))) return true;
		if (entry.kind && entry.kind.toLowerCase().includes(cat)) return true;
		// fallback: section or any heading mentions the category
		if (entry.section.toLowerCase().includes(cat)) return true;
		return entry.headings.some((h) => h.text.toLowerCase().includes(cat));
	}

	function escapeRe(s: string): string {
		return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
	}
	function escapeHtml(s: string): string {
		return s
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;");
	}

	/* ── Scoring ─────────────────────────────────────────────────────── */
	function scoreEntry(entry: SearchEntry, q: ParsedQuery): ScoredResult | null {
		const section = entry.section.toLowerCase();

		// ── Hard gates (applied before scoring) ──
		if (q.sections.length && !q.sections.some((s) => section.includes(s))) return null;
		if (q.exclSections.some((s) => section.includes(s))) return null;
		if (q.no.some((c) => entryHasCategory(entry, c))) return null;
		if (q.is.length && !q.is.every((c) => entryHasCategory(entry, c))) return null;

		const title = entry.title.toLowerCase();
		const desc = entry.description.toLowerCase();
		const body = entry.body.toLowerCase();
		const headingText = entry.headings.map((h) => h.text.toLowerCase());

		// Field restriction (in:title etc.)
		const useTitle = !q.fields.length || q.fields.includes("title");
		const useHeading = !q.fields.length || q.fields.includes("heading");
		const useBody = !q.fields.length || q.fields.includes("body");
		const useDesc = !q.fields.length || q.fields.includes("desc");

		// ── Negative bare tokens: drop if present anywhere visible ──
		for (const n of q.negative) {
			if (
				title.includes(n) ||
				desc.includes(n) ||
				body.includes(n) ||
				headingText.some((h) => h.includes(n))
			)
				return null;
		}

		// ── Phrases: every phrase must appear contiguously in a used field ──
		for (const p of q.phrases) {
			const re = new RegExp(`(^|[^a-z0-9])${escapeRe(p)}([^a-z0-9]|$)`);
			const hit =
				(useTitle && re.test(title)) ||
				(useDesc && re.test(desc)) ||
				(useBody && re.test(body)) ||
				(useHeading && headingText.some((h) => re.test(h)));
			if (!hit) return null;
		}

		const allTokens = [...q.positive, ...q.phrases];
		const fullText = allTokens.join(" ");

		let score = 0;
		let bestHeading: SearchHeading | null = null;
		let bestHeadingScore = 0;

		// Whole-query bonuses (positives + phrases as one string)
		if (useTitle) {
			if (title === fullText) score += 1000;
			else if (title.startsWith(fullText + " "))
				score += 480; // prefix of a multi-word title, e.g. "const qualifier"
			else if (
				fullText &&
				new RegExp(`(^|[^a-z0-9])${escapeRe(fullText)}([^a-z0-9]|$)`).test(title)
			)
				score += 300; // whole-word appearance
			else if (fullText && title.includes(fullText)) score += 120; // mid-word substring (constructors) — demoted hard
		}
		if (useDesc && fullText && desc.includes(fullText)) score += 70;
		if (useBody && fullText && body.includes(fullText)) score += 50;

		if (useHeading) {
			for (const heading of entry.headings) {
				const h = heading.text.toLowerCase();
				let hs = 0;
				if (h === fullText)
					hs = 320; // "const"
				else if (fullText && h.startsWith(fullText + " "))
					hs = 240; // "const pointers", "const methods" — whole word, leading
				else if (
					fullText &&
					new RegExp(`(^|[^a-z0-9])${escapeRe(fullText)}([^a-z0-9]|$)`).test(h)
				)
					hs = 180; // whole word, anywhere
				else if (fullText && h.includes(fullText)) hs = 60; // "constructors" — prefix/substring, demoted hard
				if (hs > bestHeadingScore) {
					bestHeadingScore = hs;
					bestHeading = heading;
				}
			}
			score += bestHeadingScore;
		}

		// Per-token (AND): every positive token must match somewhere used
		for (const t of allTokens) {
			let tokenScore = 0;

			if (useTitle && title.includes(t)) {
				const whole = new RegExp(`(^|[^a-z0-9])${escapeRe(t)}([^a-z0-9]|$)`).test(title);
				const prefix = new RegExp(`(^|[^a-z0-9])${escapeRe(t)}`).test(title);
				tokenScore += whole ? 200 : prefix ? 90 : 70;
			}
			if (section.includes(t)) tokenScore += 25;
			if (useDesc && desc.includes(t)) tokenScore += 30;

			if (useHeading && (tokenScore === 0 || bestHeadingScore === 0)) {
				for (const heading of entry.headings) {
					const h = heading.text.toLowerCase();
					if (h.includes(t)) {
						const whole = new RegExp(`(^|[^a-z0-9])${escapeRe(t)}([^a-z0-9]|$)`).test(
							h,
						);
						tokenScore += whole ? 80 : 15;
						if (!bestHeading) bestHeading = heading;
						break;
					}
				}
			}
			if (useBody && body.includes(t)) tokenScore += 12;

			if (tokenScore === 0) return null; // AND semantics
			score += tokenScore;
		}

		// ── Language/ authority boost ──
		if (section.startsWith(LANG_PREFIX)) {
			if (title === fullText || bestHeadingScore >= 220) score += 600;
			else score += 180;
		}

		// ── Context snippet ──
		let snippet = "";
		const probe =
			useBody && fullText && body.indexOf(fullText) >= 0
				? fullText
				: allTokens.find((t) => body.includes(t));
		if (probe) {
			const at = body.indexOf(probe);
			const start = Math.max(0, at - 48);
			const end = Math.min(entry.body.length, at + probe.length + 72);
			snippet =
				(start > 0 ? "…" : "") +
				entry.body.slice(start, end).trim() +
				(end < entry.body.length ? "…" : "");
		}

		return { entry, score, heading: bestHeading, snippet };
	}

	/* Run scoring across the corpus for a parsed query. */
	function runSearch(data: SearchEntry[], q: ParsedQuery): ScoredResult[] {
		const out: ScoredResult[] = [];
		for (const entry of data) {
			const r = scoreEntry(entry, q);
			if (r) out.push(r);
		}
		out.sort((a, b) => b.score - a.score);
		return out;
	}

	/* Group-then-slice with reserved Language slots so Language pages
     can never be sliced out by a flood of incidental matches. */
	function applyReservation(results: ScoredResult[]): ScoredResult[] {
		const lang = results.filter((r) => r.entry.section.toLowerCase().startsWith(LANG_PREFIX));
		const merged = [...lang.slice(0, LANG_RESERVED), ...results];
		const seen = new Set<string>();
		const final: ScoredResult[] = [];
		for (const r of merged) {
			if (seen.has(r.entry.url)) continue;
			seen.add(r.entry.url);
			final.push(r);
			if (final.length >= RESULT_LIMIT) break;
		}
		return final;
	}

	function highlightTokens(q: ParsedQuery): string[] {
		return [...q.positive, ...q.phrases].filter(Boolean);
	}
	function highlight(text: string, tokens: string[]): string {
		if (!tokens.length) return escapeHtml(text);
		// Match on the RAW text, then escape each piece, so a token can never
		// split an entity (&lt; &amp; ...) the way matching escaped HTML did.
		const pattern = new RegExp(`(${tokens.map(escapeRe).join("|")})`, "gi");
		return text
			.split(pattern)
			.map((part, i) => (i % 2 ? `<mark>${escapeHtml(part)}</mark>` : escapeHtml(part)))
			.join("");
	}

	const EMPTY_STATE = `
    <div class="search-empty">
      <p class="se-cmd">grep -ri "" ~/docs</p>
      <p>Search across all documentation pages.</p>
      <p class="se-out">titles</p>
      <p class="se-out">headings</p>
      <p class="se-out last">page content</p>
      <p class="se-tip">Try <code>"exact phrase"</code> <code>-term</code> <code>section:language</code>, or open <span class="se-help">[?]</span> for more.</p>
    </div>`;

	function setCount(text: string) {
		const el = document.getElementById("search-count");
		if (el) el.textContent = text;
	}

	function showNotice(html: string | null) {
		const el = document.getElementById("search-notice");
		if (!el) return;
		if (!html) {
			el.hidden = true;
			el.innerHTML = "";
			return;
		}
		el.hidden = false;
		el.innerHTML = html;
	}

	function renderResults(results: ScoredResult[], query: string, tokens: string[]) {
		const container = document.getElementById("search-result-list");
		if (!container) return;
		focusIdx = -1;

		if (!results.length) {
			container.innerHTML = `
        <div class="no-results">
          <p class="nr-err">No results for <strong>"${escapeHtml(query)}"</strong></p>
          <p>Try different keywords or browse the <a href="/docs/">docs</a>.</p>
        </div>`;
			setCount("");
			return;
		}

		const groups: Array<{ section: string; items: ScoredResult[] }> = [];
		for (const r of results) {
			let g = groups.find((g) => g.section === r.entry.section);
			if (!g) {
				g = { section: r.entry.section, items: [] };
				groups.push(g);
			}
			g.items.push(r);
		}

		let html = "";
		let idx = 0;
		for (const g of groups) {
			html += `<div class="result-group-label">${escapeHtml(g.section)}</div>`;
			for (const r of g.items) {
				const url = r.heading ? `${r.entry.url}#${r.heading.slug}` : r.entry.url;
				const sub = r.snippet || r.entry.description;
				html += `
          <a class="result-item" href="${url}" role="option" aria-selected="false" data-idx="${idx++}">
            <span class="result-icon" aria-hidden="true">&gt;</span>
            <div class="result-body">
              <div class="result-title-row">
                <span class="result-title">${highlight(r.entry.title, tokens)}</span>
                ${r.heading ? `<span class="result-heading">${highlight(r.heading.text, tokens)}</span>` : ""}
              </div>
              ${sub ? `<div class="result-desc">${highlight(sub, tokens)}</div>` : ""}
            </div>
            <span class="result-arrow" aria-hidden="true">↵</span>
          </a>`;
			}
		}

		container.innerHTML = html;
		setFocus(0);
	}

	function setFocus(idx: number) {
		const items = document.querySelectorAll<HTMLElement>(".result-item");
		if (!items.length) return;
		items.forEach((el) => el.setAttribute("aria-selected", "false"));
		const clamped = ((idx % items.length) + items.length) % items.length;
		focusIdx = clamped;
		items[clamped]?.setAttribute("aria-selected", "true");
		items[clamped]?.scrollIntoView({ block: "nearest" });
	}

	let lastForcedRaw: string | null = null; // for "search instead for" override

	async function executeSearch(raw: string, allowFuzzy = true) {
		const seq = ++searchSeq;
		const container = document.getElementById("search-result-list");
		if (!container) return;

		const trimmed = raw.trim();
		if (!trimmed) {
			container.innerHTML = EMPTY_STATE;
			setCount("");
			showNotice(null);
			return;
		}

		const data = await loadIndex();
		if (seq !== searchSeq) return;

		const q = parseQuery(trimmed);

		// Correct section-qualifier typos against the small section vocab.
		let sectionCorrected = false;
		if (sectionVocab) {
			q.sections = q.sections.map((s) => {
				if (sectionVocab!.some((v) => v.includes(s))) return s;
				const fix = fuzzyCorrect(s, sectionVocab!);
				if (fix) {
					sectionCorrected = true;
					return fix;
				}
				return s;
			});
		}

		let results = runSearch(data, q);
		let noticeHtml: string | null = null;

		// Fuzzy fallback: only when exact search found nothing AND we have
		// positive tokens to correct (phrases/qualifiers are left alone).
		if (allowFuzzy && !results.length && q.positive.length && vocab) {
			const corrections: Array<[string, string]> = [];
			const corrected = q.positive.map((t) => {
				if (vocab!.some((v) => v.includes(t))) return t; // substring exists, keep
				const fix = fuzzyCorrect(t, vocab!);
				if (fix && fix !== t) {
					corrections.push([t, fix]);
					return fix;
				}
				return t;
			});

			if (corrections.length) {
				const cq: ParsedQuery = { ...q, positive: corrected };
				const cResults = runSearch(data, cq);
				if (cResults.length) {
					results = cResults;
					q.positive = corrected; // so highlighting matches what we found
					const shown = corrections
						.map(([, to]) => `<strong>${escapeHtml(to)}</strong>`)
						.join(", ");
					noticeHtml =
						`Showing results for ${shown} &nbsp;` +
						`<a data-force="${escapeHtml(trimmed)}">Search instead for "${escapeHtml(trimmed)}"</a>`;
				}
			}
		}

		if (sectionCorrected && !noticeHtml) {
			noticeHtml = `Corrected section to <span class="notice-chip">${escapeHtml(q.sections.join(", "))}</span>`;
		}

		showNotice(noticeHtml);

		const final = applyReservation(results);
		setCount(`${results.length} result${results.length === 1 ? "" : "s"}`);
		renderResults(final, trimmed, highlightTokens(q));
	}

	function handleInput(e: Event) {
		const raw = (e.target as HTMLInputElement).value;
		lastForcedRaw = null;
		executeSearch(raw, true);
	}

	/* Help popover */
	function toggleHelp(force?: boolean) {
		const pop = document.getElementById("search-help-popover");
		const btn = document.getElementById("search-help-btn");
		if (!pop || !btn) return;
		const open = force ?? !pop.classList.contains("open");
		pop.classList.toggle("open", open);
		pop.setAttribute("aria-hidden", String(!open));
		btn.setAttribute("aria-expanded", String(open));
	}

	let lastTrigger: HTMLElement | null = null;

	function openModal() {
		if (!lastTrigger && document.activeElement instanceof HTMLElement && document.activeElement !== document.body)
			lastTrigger = document.activeElement;
		const modal = document.getElementById("search-modal");
		const container = document.getElementById("search-result-list");
		if (container && !container.innerHTML.trim()) container.innerHTML = EMPTY_STATE;
		modal?.classList.add("open");
		modal?.setAttribute("aria-hidden", "false");
		document.body.style.overflow = "hidden";
		setTimeout(
			() => (document.getElementById("search-input") as HTMLInputElement)?.focus(),
			30,
		);
		loadIndex();
	}

	function closeModal() {
		const modal = document.getElementById("search-modal");
		modal?.classList.remove("open");
		modal?.setAttribute("aria-hidden", "true");
		document.body.style.overflow = "";
		const input = document.getElementById("search-input") as HTMLInputElement;
		if (input) input.value = "";
		const container = document.getElementById("search-result-list");
		if (container) container.innerHTML = EMPTY_STATE;
		showNotice(null);
		toggleHelp(false);
		setCount("");
		focusIdx = -1;
		try {
			const url = new URL(window.location.href);
			if (url.searchParams.has("q")) {
				url.searchParams.delete("q");
				history.replaceState(history.state, "", url.pathname + url.search + url.hash);
			}
		} catch {}
		if (lastTrigger && document.contains(lastTrigger)) lastTrigger.focus({ preventScroll: true });
		lastTrigger = null;
	}

	function init() {
		const modal = document.getElementById("search-modal");
		if (!modal || modal.dataset.init) return;
		modal.dataset.init = "1";

		// Portal to <body>: an ancestor with a transform (the mobile drawer)
		// would otherwise become the containing block of this fixed overlay.
		if (modal.parentElement !== document.body) document.body.appendChild(modal);

		// Shortcut label: ⌘K on Apple platforms, ^K (ctrl) elsewhere.
		const kbd = document.getElementById("search-kbd");
		const isMac = /Mac|iPhone|iPad|iPod/i.test(
			(navigator as any).userAgentData?.platform || navigator.platform || navigator.userAgent,
		);
		if (kbd && !isMac) kbd.textContent = "^K";

		// Any [data-search-open] element opens the palette (sidebar trigger,
		// docs mobile bar button, ...).
		document.addEventListener("click", (e) => {
			const t = (e.target as Element | null)?.closest?.("[data-search-open]") as HTMLElement | null;
			if (!t) return;
			e.preventDefault();
			lastTrigger = t;
			openModal();
		});
		document.getElementById("search-backdrop")?.addEventListener("click", closeModal);
		document.getElementById("search-close-btn")?.addEventListener("click", closeModal);
		document.getElementById("search-input")?.addEventListener("input", handleInput);

		document.getElementById("search-help-btn")?.addEventListener("click", (e) => {
			e.stopPropagation();
			toggleHelp();
		});
		document
			.getElementById("search-help-popover")
			?.addEventListener("click", (e) => e.stopPropagation());

		// "Search instead for" override (skip fuzzy)
		document.getElementById("search-notice")?.addEventListener("click", (e) => {
			const a = (e.target as HTMLElement).closest("a[data-force]") as HTMLElement | null;
			if (!a) return;
			e.preventDefault();
			const forced = a.getAttribute("data-force") || "";
			lastForcedRaw = forced;
			executeSearch(forced, false);
		});

		document.getElementById("search-input")?.addEventListener("keydown", (e) => {
			const items = document.querySelectorAll<HTMLElement>(".result-item");
			if (e.key === "ArrowDown") {
				e.preventDefault();
				setFocus(focusIdx + 1);
			} else if (e.key === "ArrowUp") {
				e.preventDefault();
				setFocus(focusIdx - 1);
			} else if (e.key === "Enter") {
				e.preventDefault();
				const target = items[focusIdx >= 0 ? focusIdx : 0];
				if (target) window.location.href = (target as HTMLAnchorElement).href;
			} else if (e.key === "Escape") {
				if (document.getElementById("search-help-popover")?.classList.contains("open"))
					toggleHelp(false);
				else closeModal();
			}
		});

		document.addEventListener("keydown", (e) => {
			if ((e.metaKey || e.ctrlKey) && e.key === "k") {
				e.preventDefault();
				document.getElementById("search-modal")?.classList.contains("open")
					? closeModal()
					: openModal();
			}
			if (
				e.key === "/" &&
				!document.getElementById("search-modal")?.classList.contains("open")
			) {
				const tag = (document.activeElement?.tagName || "").toLowerCase();
				if (tag !== "input" && tag !== "textarea") {
					e.preventDefault();
					openModal();
				}
			}
			if (
				e.key === "Escape" &&
				document.getElementById("search-modal")?.classList.contains("open")
			) {
				closeModal();
			}
		});

		// Close help popover on outside click
		document.addEventListener("click", () => toggleHelp(false));

		// Deep link: /docs/?q=<term> (the site's JSON-LD SearchAction target)
		// opens the palette with the query prefilled and already run.
		try {
			const q = new URLSearchParams(window.location.search).get("q");
			if (q && q.trim()) {
				openModal();
				const input = document.getElementById("search-input") as HTMLInputElement | null;
				if (input) {
					input.value = q;
					executeSearch(q, true);
				}
			}
		} catch {}
	}

	init();
	document.addEventListener("astro:page-load", init);
</script>
