---
import { getCollection } from 'astro:content';
import { buildDocTree, formatSectionName, type TreeSection, type TreePage } from '../../lib/docs-tree';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const allDocs = await getCollection('docs');
const tree = buildDocTree(allDocs);

function isActive(id: string): boolean {
  const normalized = currentPath.replace(/^\/docs\/?/, '').replace(/\/$/, '');
  const docSlug = id.replace(/\.mdx?$/, '').replace(/\/index$/, '');
  return normalized === docSlug || (normalized === '' && (docSlug === 'index' || docSlug === ''));
}

function esc(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

/* ── ASCII file tree ──────────────────────────────────────────────────
   Every row carries its own guide columns, one per depth level:
     p = "│   "  (an ancestor still has siblings below)
     b = "    "  (ancestor was the last child)
     t = "├── "  (this row has siblings below)
     e = "└── "  (this row is the last child)
   The guides are drawn as 1px CSS lines (see global.css .tg) so they
   stay continuous at any row height / when a long title wraps.
   Purely decorative: aria-hidden.                                       */
function guides(trail: boolean[], last: boolean): string {
  let g = '';
  for (const more of trail) g += `<i class="tg ${more ? 'p' : 'b'}"></i>`;
  g += `<i class="tg ${last ? 'e' : 't'}"></i>`;
  return `<span class="tree-guides" aria-hidden="true">${g}</span>`;
}

function pageRow(page: TreePage, trail: boolean[], last: boolean): string {
  const active = isActive(page.id);
  return `<a href="${page.href}" class="sidebar-link tree-row${active ? ' active' : ''}"${active ? ' aria-current="page"' : ''}>${guides(trail, last)}<span class="tree-label">${esc(page.title)}</span></a>`;
}

// A collapsible directory: "├── [-] language/"
function renderSection(section: TreeSection, sectionPath: string, trail: boolean[], last: boolean, top: boolean): string {
  const collapsed = section.defaultCollapsed;
  const pretty = formatSectionName(section.name);
  const dirName = `${esc(section.name)}<span class="tree-slash" aria-hidden="true">/</span>`;
  const bodyId = `sb-${sectionPath.replace(/[^a-zA-Z0-9_-]+/g, '-')}`;
  const toggle = `<button type="button" class="sidebar-section-btn tree-toggle" aria-expanded="${!collapsed}" aria-controls="${bodyId}" aria-label="Toggle ${esc(pretty)} section"><span class="tree-toggle-glyph" aria-hidden="true"></span></button>`;

  let label: string;
  if (section.indexPage) {
    const active = isActive(section.indexPage.id);
    label = `<a href="${section.indexPage.href}" class="sidebar-group-label sidebar-grouplabel-link tree-label${active ? ' active' : ''}"${active ? ' aria-current="page"' : ''} title="${esc(pretty)}">${dirName}</a>`;
  } else {
    // no index page: the name itself toggles the directory
    label = `<button type="button" class="sidebar-group-label sidebar-section-btn tree-label tree-label-btn" aria-expanded="${!collapsed}" aria-controls="${bodyId}" title="${esc(pretty)}">${dirName}</button>`;
  }

  const header = `<div class="sidebar-collapsible-header tree-row tree-dir">${guides(trail, last)}${toggle}${label}</div>`;
  const body = `<div class="sidebar-collapsible-body" id="${bodyId}">${renderChildren(section, sectionPath, [...trail, !last])}</div>`;
  const cls = top ? 'sidebar-group sidebar-collapsible' : 'sidebar-subgroup sidebar-collapsible';
  return `<div class="${cls}" data-section="${esc(sectionPath)}" data-collapsed="${collapsed}">${header}${body}</div>`;
}

function renderChildren(section: TreeSection, parentPath: string, trail: boolean[]): string {
  let html = '';
  section.children.forEach((child, i) => {
    const last = i === section.children.length - 1;
    if (child.kind === 'section') html += renderSection(child, `${parentPath}/${child.name}`, trail, last, false);
    else html += pageRow(child, trail, last);
  });
  return html;
}

// Root: index + root pages first (flat), then the top-level directories.
const rootPages = tree.children.filter((c): c is TreePage => c.kind === 'page');
const rootSections = tree.children.filter((c): c is TreeSection => c.kind === 'section');
const rootList: Array<TreePage | TreeSection> = [
  ...(tree.indexPage ? [tree.indexPage] : []),
  ...rootPages,
  ...rootSections,
];

let treeHtml = '';
rootList.forEach((node, i) => {
  const last = i === rootList.length - 1;
  treeHtml += node.kind === 'section'
    ? renderSection(node, node.name, [], last, true)
    : pageRow(node, [], last);
});
---

<nav class="docs-sidebar-nav" aria-label="Documentation">
  <!-- Back to home (mobile drawer only) -->
  <div class="sidebar-back">
    <a href="/" class="sidebar-back-link"><span aria-hidden="true">cd </span>~<span class="sr-only"> back to home</span></a>
  </div>

  <div class="sidebar-tree-root" aria-hidden="true">
    <span class="dim">$</span> tree <a href="/docs/" tabindex="-1">~/docs</a>
  </div>

  <div class="sidebar-tree" id="sidebar-tree">
    <Fragment set:html={treeHtml} />
  </div>
  <p class="sidebar-tree-foot" aria-hidden="true">{allDocs.length} files</p>
</nav>

<!-- Apply saved collapse states synchronously, before first paint and before
     the layout's sidebar scroll restore runs, so nothing jumps. A section that
     contains the active page is always open. -->
<script is:inline>
  (function () {
    var root = document.getElementById('sidebar-tree');
    if (!root) return;
    var secs = root.querySelectorAll('.sidebar-collapsible');
    for (var i = 0; i < secs.length; i++) {
      var s = secs[i];
      var hasActive = s.querySelector('.sidebar-link.active, .sidebar-grouplabel-link.active');
      var v = null;
      if (hasActive) v = 'false';
      else { try { v = localStorage.getItem('sidebar-section:' + s.getAttribute('data-section')); } catch (_) {} }
      if (v === 'true' || v === 'false') {
        s.setAttribute('data-collapsed', v);
        var h = s.firstElementChild;
        if (h) { var b = h.querySelectorAll('.sidebar-section-btn'); for (var j = 0; j < b.length; j++) b[j].setAttribute('aria-expanded', String(v === 'false')); }
      }
    }
  })();
</script>

<style>
  .docs-sidebar-nav {
    padding: 0.25rem 0 1rem;
    font-family: var(--font-mono);
  }
  .sidebar-back { display: none; padding: 0 1.25rem 1rem; }
  .sidebar-back-link {
    font-size: 0.78rem;
    color: var(--text-2);
    text-decoration: none;
    padding: 2px 4px;
    margin-left: -4px;
  }
  .sidebar-back-link span[aria-hidden] { color: var(--text-3); }
  .sidebar-back-link:hover { background: var(--text); color: var(--bg); }
  .sidebar-back-link:hover span[aria-hidden] { color: inherit; }

  .sidebar-tree-root {
    padding: 0 1.25rem 0.35rem;
    font-size: 0.76rem;
    color: var(--text-2);
    white-space: nowrap;
  }
  .sidebar-tree-root a {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .sidebar-tree { padding: 0 0.75rem 0 1.25rem; }
  .sidebar-tree-foot {
    margin: 0.5rem 0 0;
    padding: 0 1.25rem;
    font-size: 0.68rem;
    color: var(--text-3);
    letter-spacing: 0.04em;
  }

  @media (max-width: 1024px) {
    .sidebar-back { display: block; }
  }
</style>

<script>
  function initCollapsible() {
    const root = document.getElementById('sidebar-tree');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';

    // Event delegation: one listener for every [+]/[-] toggle and dir label.
    root.addEventListener('click', (e) => {
      const btn = (e.target as Element | null)?.closest?.<HTMLElement>('.sidebar-section-btn');
      if (!btn || !root.contains(btn)) return;
      const section = btn.closest<HTMLElement>('.sidebar-collapsible');
      if (!section) return;
      const collapsed = section.dataset.collapsed !== 'true';
      section.dataset.collapsed = String(collapsed);
      section.firstElementChild
        ?.querySelectorAll('.sidebar-section-btn')
        .forEach((b) => b.setAttribute('aria-expanded', String(!collapsed)));
      try { localStorage.setItem(`sidebar-section:${section.dataset.section}`, String(collapsed)); } catch (_) {}
    });
  }

  initCollapsible();
  document.addEventListener('astro:page-load', initCollapsible);
</script>
