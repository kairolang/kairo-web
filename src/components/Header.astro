---
import ThemeToggle from './ThemeToggle.astro';
const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home', active: pathname === '/' || pathname === '' },
  { href: '/docs', label: 'Docs', active: pathname.startsWith('/docs') },
  { href: '/blog', label: 'Blog', active: pathname.startsWith('/blog') },
  { href: '/ksf', label: 'KSF', active: pathname === '/ksf' || pathname === '/ksf/' },
];
---

<header class="site-header" id="site-header">
  <div class="header-inner container">
    <!-- Logo -->
    <a href="/" class="header-logo" aria-label="Kairo home">
      <img src="/kairo-file-icon.svg" alt="" width="26" height="26" />
      <span class="header-wordmark">kairo</span>
    </a>

    <!-- Desktop nav -->
    <nav class="header-nav" aria-label="Primary">
      {links.map(l => (
        <a href={l.href} class={`nav-link ${l.active ? 'active' : ''}`}>{l.label}</a>
      ))}
    </nav>

    <!-- Right cluster -->
    <div class="header-actions">
      <a
        href="https://github.com/kairolang/kairo-lang"
        target="_blank"
        rel="noopener noreferrer"
        class="header-icon-btn"
        aria-label="Kairo on GitHub"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <ThemeToggle />
      <a href="/docs/install" class="btn-primary header-cta">Install</a>

      <!-- Hamburger (mobile) -->
      <button id="hamburger" class="header-icon-btn hamburger-btn" aria-label="Open menu" aria-expanded="false">
        <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <line x1="4" y1="8" x2="20" y2="8"/>
          <line x1="4" y1="16" x2="20" y2="16"/>
        </svg>
        <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="display:none;">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobile-menu">
    {links.map(l => (
      <a href={l.href} class="mobile-nav-link">{l.label}</a>
    ))}
    <a href="https://github.com/kairolang/kairo-lang" class="mobile-nav-link" target="_blank" rel="noopener noreferrer">
      GitHub
      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block;vertical-align:baseline;margin-left:4px;">
        <path d="M7 17 17 7M7 7h10v10"/>
      </svg>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: transparent;
    transition:
      background var(--dur-med) var(--ease),
      box-shadow var(--dur-med) var(--ease),
      border-color var(--dur-med) var(--ease);
    border-bottom: 1px solid transparent;
  }
  .site-header.scrolled {
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border-bottom-color: var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 1rem;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .header-logo img {
    transition: transform var(--dur-med) var(--ease-spring);
  }
  .header-logo:hover img {
    transform: rotate(-8deg) scale(1.06);
  }
  .header-wordmark {
    font-weight: 600;
    font-size: 1.06rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 2px;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .header-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--r-pill);
    color: var(--text-2);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .header-icon-btn:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--text) 7%, transparent);
  }

  .header-cta {
    font-size: 0.82rem;
    padding: 7px 16px;
    margin-left: 4px;
  }

  .hamburger-btn { display: none; }

  /* The header needs relative positioning for the centered nav */
  .header-inner { position: relative; }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    flex-direction: column;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 1.5rem 1rem;
  }
  .mobile-menu.open {
    display: flex;
    animation: fadeUp 0.35s var(--ease-out) both;
  }

  @media (max-width: 820px) {
    .header-nav { display: none; }
    .hamburger-btn { display: inline-flex; }
    .header-cta { display: none; }
  }
</style>

<script>
  function initHeader() {
    const header = document.getElementById('site-header');
    const hamburger = document.getElementById('hamburger');
    const mobileMenu = document.getElementById('mobile-menu');

    let ticking = false;
    function handleScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        header?.classList.toggle('scrolled', window.scrollY > 8);
        ticking = false;
      });
    }
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    hamburger?.addEventListener('click', () => {
      const open = mobileMenu?.classList.toggle('open');
      hamburger.setAttribute('aria-expanded', String(!!open));
      const menuIcon = hamburger.querySelector('.icon-menu') as HTMLElement | null;
      const closeIcon = hamburger.querySelector('.icon-close') as HTMLElement | null;
      if (menuIcon) menuIcon.style.display = open ? 'none' : 'block';
      if (closeIcon) closeIcon.style.display = open ? 'block' : 'none';
      if (open) header?.classList.add('scrolled');
    });
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
