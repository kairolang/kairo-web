---
import { Code } from 'astro:components';
import { langFor } from './kairo-lang';
import AsciiField from '../ascii/AsciiField.astro';
import '../../styles/resize.css';

const examples = [
  {
    id: 'syntax',
    label: 'Printing to the console',
    filename: 'hello.k',
    code: `import std  // import only what you need

// No main() required top-level code runs immediately
// or is callable when imported as a module.
const name  = "Kairo"
var   count = 0

for i in 0..5 {
    std::print(f"Hello, {name}! Count is {count}.")
    count++
}

std::println(f"Ran {count} times.")`,
    blurb: {
      heading: 'Simple, clean syntax',
      points: [
        { label: 'Type inference', body: 'Write `var count = 0` the compiler knows it\'s an integer. Annotate when you want to, not because you have to.' },
        { label: 'String interpolation', body: '`f""` strings let you embed expressions directly. No concatenation, no format specifiers.' },
        { label: 'Top-level code', body: 'Skip the `main()` boilerplate. Code at the top level runs on execution and can still be imported as a module.' },
      ],
    },
  },
  {
    id: 'cpp-in-kairo',
    label: 'C++ in Kairo',
    filename: 'ffi.k',
    code: ` // Call C++ code directly from Kairo with perfect ABI compatibility.
 // my_cpp_lib.hpp contains:
 //
 // int add(int a, int b) { return a + b; }
 // namespace my_cpp_lib {
 //     std::string greet(std::string name) { return "Hello, " + name + "!"; }
 // }
 //
 // C++ namespaces map directly to Kairo module syntax.
 // Functions with no namespace are callable without qualification.

 ffi "c++" import "my_cpp_lib.hpp"  // import a C++ header directly as a module.
                                    // no wrapper generation, no binding step.

 const sum      = add(3, 4)  // direct call, zero overhead.
 var   greeting = my_cpp_lib::greet("Kairo")

 greeting += " Welcome to seamless interop!"  // C++ std::string, manipulated
                                              // directly in Kairo, no conversion.

 std::println(greeting)  // Hello, Kairo! Welcome to seamless interop!`,
    blurb: {
      heading: 'Drop in, not rewrite',
      points: [
        { label: 'No binding step', body: 'Point Kairo at a C++ header and call it. Full type and ABI compatibility, no generated wrappers, no intermediate layer.' },
        { label: 'Namespaces just work', body: 'C++ namespaces map to Kairo module syntax automatically. Your existing library surface stays exactly as you designed it.' },
        { label: 'Migrate at your own pace', body: 'Move files to Kairo one at a time while the rest of your codebase stays in C++. There\'s no cutover point, no rewrite cliff.' },
      ],
    },
  },
  {
    id: 'kairo-in-cpp',
    label: 'Kairo in C++',
    filename: 'kairo_ffi.cpp',
    code: `// Call Kairo functions directly from C++ with full ABI compatibility.
// KCC (Kairo C++ Compiler) is the tool that allows you to include Kairo modules directly in C++.
//   \`kcc kairo_ffi.cpp\` - kcc is a clang++ driver that supports including Kairo files.
// Without -cc, use \`kairo kairo_ffi.k -c -o kairo_ffi -xc++ -header kairo_ffi.hh\` to generate C++ or C headers
// for shipping a Kairo library to C++ consumers.
//
// kairo_ffi.k:
//   import std
//   fn add(a: i32, b: i32) -> i32 { return a + b }
//   fn greet(name: string) -> string { return f"Hello, {name}!" }
//
// Kairo wraps the module under its filename as the exposed C++ namespace.

#include "kairo_ffi.k"  // include the Kairo module directly.
#include <iostream>

int main() {
    int sum = kairo_ffi::add(3, 4);  // direct call, no overhead.
    std::string greeting = kairo_ffi::greet("C++");

    greeting += " Welcome to seamless interop!";

    std::cout << greeting << std::endl;  // Hello, C++! Welcome to seamless interop!
    return 0;
}`,
    blurb: {
      heading: 'Adopt Kairo incrementally',
      points: [
        { label: 'Include like any header', body: 'With `kcc`, your Kairo module is includable directly from C++. Only one change to your build systems default c++ compiler.' },
        { label: 'Full ABI compatibility', body: 'Kairo functions are callable from C++ with perfect type fidelity. The module is exposed under its filename as a C++ namespace, no surprises.' },
        { label: 'Ship Kairo as a C++ library', body: 'Use `kairo -c` to compile into a lib and `kairo -xc++ -header` to generate C++ headers. Consumers see a normal library.' },
      ],
    },
  },
  {
    id: 'memory',
    label: 'Memory Safety',
    filename: 'memory.k',
    code: ` import std

 struct Buffer {
     const size: usize
     var   data: *byte  // safe pointer to a heap allocation

     fn op new (self, size: usize) {
         self.data = std::Memory::alloc(size)
         self.size = size // only the constructor can set size.
     }

     fn op delete (self) {
         std::Memory::free(self.data)
         // compiler hard errors, if we do not free the memory.
         // Even though the compiler proves and has enough information
         // to add the free automatically, it does not, for explicitness
         // and code clarity.
     }

     fn op [](self, i: usize) panic -> *u8 {
         if i >= self.size {
             var x = 0
             return &x // since this is a stack pointer, in debug builds,
                       // Tether changes the decl of x to a unique or shared
                       // pointer, so theres no undefined behavior.
                       // In release builds, hard error with a fix:
                       // var *x = std::Unique<u8>(0)
         }
         return self.data + i
     }
 }

 var buf = Buffer(1024)  // 1KB on the heap.
                         // destructor runs automatically when buf goes out of scope.
 buf[0] = 42
 `,
    blurb: {
      heading: 'Control without the footguns',
      points: [
        { label: 'Manual allocation', body: 'You decide what goes on the heap. No GC, no hidden allocations, no surprises at runtime.' },
        { label: 'Automatic cleanup', body: 'Kairo tracks ownership and places the destructor exactly where `buf` goes out of scope, or earlier if the function returns or panics. No leaks, no double frees, no annotations required.' },
        { label: 'Opt out when you need to', body: 'Safety features can be disabled per-module or per-type. When you need raw performance or bare-metal access, you\'re not fighting the language to get it.' },
      ],
    },
  },
  {
    id: 'error-handling',
    label: 'Error Handling',
    filename: 'errors.k',
    code: `import std
import json // imagine this is a complex JSON library

@json::Serializable
struct Config {
    var host:    string;
    var port:    u16;
    var workers: u32 = 4;
}

fn <T impl json::Serializable> json_parse(raw: string) panic -> T;
// imagine this has a complex implementation that can panic with Json::Error::Parse

fn read_file(path: string) panic -> string;
// imagine this has a complex implementation that can panic with Fs::Error::NotFound,
// or Fs::Error::PermissionDenied

fn parse_config(path: string) panic -> Config {
    var raw: string

    raw = read_file(path)
    return json_parse(raw)

    catch _: Fs::Error::NotFound {
        std::println(f"Config file not found: {path}")
        return Config { host: "localhost", port: 8080 }  // recover with a default.
    } catch e: Json::Error::Parse {
        std::println(f"Failed to parse config with error: {e}")
        return Config { host: "localhost", port: 8080 }  // recover with a default.
    } catch e { // We don't care about Fs::Error::PermissionDenied thats the
                // caller\'s problem, if we don't catch all possible panics,
                // the compiler will error, we can catch it and re-panic.
        panic e // propagate unexpected errors without wrapping or losing context.
    }
}

fn start_server(path: string) -> Config {
    try {
        const config = parse_config(path)
        // parse_config is marked \`panic\`, so we must catch its errors that
        // can reach this scope (in this case, Fs::Error::PermissionDenied).
        std::println(f"Starting {config.host}:{config.port} {config.workers}workers...")
        return config
    } catch _: Fs::Error::PermissionDenied {
        std::println(f"Permission denied when reading config file: {path}")
        return Config { host: "localhost", port: 8080 }  // recover with a default.
    } // every reachable panic is handled, no panic is needed in this function.
}     // callers of start_server need no error handling at all.`,
    blurb: {
      heading: 'The compiler knows what can fail',
      points: [
        { label: '`panic` on the signature', body: 'Mark a function `panic` and the compiler traces every failure reachable in its entire call graph. Nothing hidden, nothing implicit.' },
        { label: 'Exhaustive catch blocks', body: 'Catch blocks work like a match on an enum. Handle every reachable panic type and the compiler clears your function\'s signature. Your callers inherit the guarantee automatically, no annotations, no propagation to think about.' },
        { label: 'Propagate what you don\'t own', body: 'Use `catch e { panic e }` to handle what you care about and push the rest upstream. The original panic travels intact, no wrapping, no lost context.' },
        { label: 'Dead catches are flagged too', body: 'If a catch block handles a panic type that can\'t actually reach that scope, the compiler tells you. Catch blocks stay honest as code changes over time.' },
      ],
    },
  },
];

const inlineCode = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/`([^`]+)`/g, '<code>$1</code>');

const LANG_NAMES: Record<string, string> = { k: 'kairo', kro: 'kairo', cpp: 'c++', hpp: 'c++' };
const enc = new TextEncoder();
const panes = await Promise.all(
  examples.map(async (ex) => {
    const ext = ex.filename.split('.').pop() ?? 'txt';
    return {
      ...ex,
      ext,
      lang: await langFor(ex.filename),
      langName: LANG_NAMES[ext] ?? ext,
      lines: ex.code.split('\n').length,
      bytes: enc.encode(ex.code).length,
    };
  }),
);
// vim-style "~" rows fill the empty viewport under short files
const TILDES = Array.from({ length: 30 }, () => '~').join('\n');
---

<section class="showcase-section" id="code-showcase" aria-labelledby="showcase-title">
  <!-- the same slow drifting noise field as the CTA (own clock offset), faded
       out under the content; copy sits on solid backing. Reduced motion: one
       still frame. -->
  <AsciiField
    preset="noise"
    size={13}
    fps={20}
    radius={170}
    strength={0.3}
    t0={7.4}
    opacity={0.24}
    mask="radial-gradient(ellipse 60% 64% at 50% 52%, transparent 40%, #000 90%)"
    hole={[0.5, 0.52, 0.27, 0.288]}
  />
  <div class="container showcase-inner">

    <!-- Heading -->
    <div class="showcase-head" data-reveal-stagger>
      <div class="section-label">01 - Code</div>
      <h2 class="display showcase-h2" id="showcase-title">
        See it in action.
        <span class="dim">Clean syntax. No magic.</span>
      </h2>
    </div>

    <!-- ASCII tab bar -->
    <div class="showcase-tabs-row">
      <div class="segmented showcase-tabs" id="code-tabs" role="tablist" aria-label="Code examples">
        <div class="segmented-thumb" id="code-tabs-thumb" aria-hidden="true"></div>
        {panes.map((ex, i) => (
          <button
            type="button"
            class={`segmented-btn ${i === 0 ? 'active' : ''}`}
            id={`code-tab-${ex.id}`}
            data-tab={ex.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`code-panel-${ex.id}`}
            tabindex={i === 0 ? '0' : '-1'}
          >{ex.label}</button>
        ))}
      </div>
      <p class="showcase-hint" aria-hidden="true">// {panes.length} examples · <kbd>←</kbd> <kbd>→</kbd> to switch</p>
    </div>

    <div class="showcase-grid">

      <!-- LEFT: code panes -->
      <div class="showcase-code" id="showcase-code">
        {panes.map((ex, i) => (
          <div
            class="code-panel"
            id={`code-panel-${ex.id}`}
            data-panel={ex.id}
            role="tabpanel"
            aria-labelledby={`code-tab-${ex.id}`}
            hidden={i !== 0}
          >
            <div class="ascii-frame ascii-frame--fill pane">
              <span class="ascii-frame-title"><span class="pane-name glitch">{ex.filename}</span></span>
              <span class="ascii-frame-meta">{ex.langName}</span>
              <div class="pane-view">
                <div class="pane-body" tabindex="0" aria-label={`${ex.filename} source`}>
                  <div class="pane-code">
                    <Code
                      code={ex.code}
                      lang={ex.lang}
                      themes={{ dark: 'github-dark-default', light: 'github-light-default' }}
                      defaultColor={false}
                    />
                  </div>
                  <pre class="pane-tilde" aria-hidden="true">{TILDES}</pre>
                </div>
                <span class="pane-scan" aria-hidden="true"></span>
              </div>
              <div class="pane-status" aria-hidden="true">
                <span class="pane-mode">normal</span>
                <span class="pane-file">"{ex.filename}" {ex.lines}L, {ex.bytes}B</span>
                <span class="pane-right">{ex.langName} │ utf-8 │ ln 1</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- RIGHT: blurb trees -->
      <div class="showcase-blurbs">
        {panes.map((ex, i) => (
          <div class="blurb-panel" data-blurb={ex.id} hidden={i !== 0}>
            <h3 class="blurb-heading">{ex.blurb.heading}</h3>
            <ul class="blurb-tree">
              {ex.blurb.points.map(pt => (
                <li>
                  <span class="blurb-label" set:html={inlineCode(pt.label)} />
                  <span class="blurb-body" set:html={inlineCode(pt.body)} />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .showcase-section {
    padding: clamp(5rem, 12vh, 8.5rem) 0;
    border-top: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  .showcase-inner {
    position: relative;
    z-index: 1;
  }
  /* solid backing for copy over the field (readability first) */
  .showcase-head > *,
  .showcase-hint,
  .showcase-blurbs {
    background-color: var(--bg);
    box-shadow: 0 0 0 0.6rem var(--bg);
  }
  .showcase-head > * { width: fit-content; margin-inline: auto; }
  .showcase-tabs { background-color: var(--bg); }

  .showcase-head {
    text-align: center;
    margin-bottom: 2.25rem;
  }
  .showcase-h2 {
    font-size: clamp(1.75rem, 3.8vw, 2.8rem);
    margin: 0;
  }
  .showcase-h2 .dim {
    display: block;
    font-weight: 500;
  }

  .showcase-tabs-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 2.25rem;
    max-width: 100%;
  }
  .showcase-tabs { max-width: 100%; }
  .showcase-hint {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--text-3);
  }
  .showcase-hint kbd { font-size: 0.9em; color: var(--text-2); }

  /* --sc-code: the code column's width while the pane is drag-resized; the
     blurb column takes the rest and reflows live */
  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--sc-code, 1.6fr)) minmax(240px, 1fr);
    gap: clamp(2rem, 4vw, 3.25rem);
    align-items: start;
  }
  .showcase-code { min-width: 0; }

  @media (max-width: 900px) {
    .showcase-grid { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .showcase-head { text-align: left; }
    .showcase-head > * { margin-inline: 0; }
    .showcase-tabs-row { align-items: flex-start; }
    .showcase-hint { display: none; }
  }

  /* ── Code pane: ASCII frame + vim viewport ── */
  .pane {
    --frame-pad: 0;
    padding-top: 0.6rem;
  }
  .pane-name { display: inline-block; }

  .pane-view {
    position: relative;
    overflow: hidden;
  }
  .pane-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: var(--sc-pane-h, 540px);
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    /* x contained (no back-swipe on long lines); y chains to the page */
    overscroll-behavior: contain auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border-hi) transparent;
  }
  .pane-body:focus-visible { outline-offset: -2px; }
  .pane-code { flex-shrink: 0; min-width: 100%; }

  .pane-code :global(pre.astro-code) {
    margin: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    padding: 1.1rem 1.5rem 0 !important;
    font-size: 0.82rem !important;
    line-height: 1.75 !important;
    font-family: var(--font-mono) !important;
    background: transparent !important;
    min-width: 0;
    width: max-content;
    overflow: visible !important;
  }
  .pane-tilde {
    flex: 1 0 0;
    min-height: 0;
    overflow: hidden;
    margin: 0;
    padding: 0 1.5rem 1.1rem;
    border: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.75;
    color: var(--text-3);
    opacity: 0.7;
    user-select: none;
  }

  .pane-status {
    display: flex;
    align-items: center;
    gap: 1.5ch;
    border-top: 1px solid var(--frame-line);
    background: var(--bg-3);
    font-size: 0.68rem;
    line-height: 1;
    color: var(--text-2);
    white-space: nowrap;
    overflow: hidden;
  }
  .pane-mode {
    padding: 0.5rem 1ch;
    background: var(--red);
    color: var(--on-red);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pane-file { overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .pane-right { margin-left: auto; padding-right: 1ch; color: var(--text-3); }

  @media (max-width: 900px) {
    .pane-body { height: var(--sc-pane-h, 420px); }
  }

  /* soft wrap once the pane has been resized narrower than its code;
     wrapped rows hang 2ch in so each source line still reads as one */
  .showcase-code.is-wrapped .pane-code { width: 100%; min-width: 0; }
  .showcase-code.is-wrapped .pane-code :global(pre.astro-code) {
    width: auto;
    white-space: pre-wrap !important;
    overflow-wrap: anywhere;
  }
  .showcase-code.is-wrapped .pane-code :global(.line) {
    display: inline-block;
    max-width: 100%;
    vertical-align: top;
    padding-left: 2ch;
    text-indent: -2ch;
  }
  @media (max-width: 520px) {
    .pane-right { display: none; }
    .pane-code :global(pre.astro-code) { font-size: 0.76rem !important; padding: 1rem 1rem 0 !important; }
    .pane-tilde { font-size: 0.76rem; padding: 0 1rem 1rem; }
  }

  /* ── Tab swap: stepped print-in + one scan line, then still ── */
  .code-panel.is-swap .pane-view { animation: paneIn 220ms steps(8, end) both; }
  .code-panel.is-swap .pane-scan { animation: paneScan 220ms steps(8, end) both; }
  .blurb-panel.is-swap { animation: paneIn 200ms steps(6, end) 40ms both; }

  .pane-scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      to bottom,
      transparent calc(100% - 28px),
      color-mix(in srgb, var(--red) 9%, transparent) calc(100% - 2px),
      var(--red) 0
    );
  }
  @keyframes paneIn {
    from { clip-path: inset(0 0 100% 0); }
    to   { clip-path: inset(0 0 0 0); }
  }
  @keyframes paneScan {
    0%   { opacity: 1; transform: translateY(-100%); }
    99%  { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(0); }
  }

  /* ── Blurb: "├── label" tree ── */
  .blurb-heading {
    display: flex;
    align-items: baseline;
    gap: 1ch;
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0.25rem 0 1.4rem;
  }
  .blurb-heading::before {
    content: '▌';
    content: '▌' / '';
    color: var(--red);
  }
  .blurb-tree {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.84rem;
  }
  .blurb-tree li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0 0 1.25rem 4.2ch;
  }
  .blurb-tree li:last-child { padding-bottom: 0; }
  .blurb-tree li::before {
    content: '├──';
    content: '├──' / '';
    position: absolute;
    left: 0;
    top: 0;
    line-height: 1.45;
    color: var(--text-3);
    transition: color var(--dur-instant) steps(1, end);
  }
  .blurb-tree li:last-child::before { content: '└──'; content: '└──' / ''; }
  /* continuous rail down the tree, under the ├ stroke */
  .blurb-tree li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(0.5ch - 0.5px);
    top: 1.2em;
    bottom: 0;
    width: 1px;
    background: var(--text-3);
    opacity: 0.8;
  }
  .blurb-tree li:hover::before { color: var(--accent); }

  .blurb-label {
    font-weight: 600;
    line-height: 1.45;
    color: var(--text);
  }
  .blurb-body {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.65;
  }
  .blurb-tree :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--text);
    background: var(--bg-3);
    border: 1px solid var(--border);
    padding: 0 0.4ch;
    border-radius: 0;
  }
  .blurb-label :global(code) { color: var(--accent); }
</style>

<script>
  import { makeResizable } from '../../lib/ascii/resize';

  /**
   * The code column is resizable from its bottom-right corner / right and
   * bottom edges: the grid's first track follows --sc-code (blurb column
   * reflows live), every pane's viewport follows --sc-pane-h, and the code
   * soft-wraps once narrower than its longest line. <=900px (single column):
   * height only.
   */
  function initPaneResize(root: HTMLElement) {
    const col = root.querySelector<HTMLElement>('#showcase-code');
    const grid = root.querySelector<HTMLElement>('.showcase-grid');
    if (!col || !grid) return;
    let chrome = 0, gap = 0, charW = 7.9, lineH = 23, padX = 0, bodyH = 0;
    const visibleBody = () =>
      col.querySelector<HTMLElement>('.code-panel:not([hidden]) .pane-body') ?? col.querySelector<HTMLElement>('.pane-body');

    makeResizable(col, {
      handles: ['se', 'e', 's'],
      anchor: 'start',
      label: 'the code pane',
      axis: () => (window.innerWidth <= 900 ? 'y' : 'both'),
      measure: () => {
        const r = col.getBoundingClientRect();
        const b = visibleBody();
        bodyH = b ? b.getBoundingClientRect().height : 0;
        chrome = r.height - bodyH;
        gap = parseFloat(getComputedStyle(grid).columnGap) || 0;
        const pre = b?.querySelector('pre');
        if (pre) {
          const cs = getComputedStyle(pre);
          const fs = parseFloat(cs.fontSize) || 13;
          charW = fs * 0.6;
          lineH = parseFloat(cs.lineHeight) || fs * 1.75;
          padX = (parseFloat(cs.paddingLeft) || 0) + (parseFloat(cs.paddingRight) || 0);
        }
        return r;
      },
      minWidth: 340,
      maxWidth: () => grid.clientWidth - gap - 260,
      minHeight: () => chrome + lineH * 7,
      maxHeight: () => chrome + Math.max(540, window.innerHeight * 0.9),
      apply(w, h, dw, dh) {
        if (dw) {
          col.classList.add('is-wrapped');
          grid.style.setProperty('--sc-code', w + 'px');
        }
        if (dh) {
          bodyH = Math.round(h - chrome);
          root.style.setProperty('--sc-pane-h', bodyH + 'px');
        }
      },
      reset() {
        grid.style.removeProperty('--sc-code');
        root.style.removeProperty('--sc-pane-h');
        col.classList.remove('is-wrapped');
      },
      readout: (w) => {
        const cols = Math.max(1, Math.floor((w - 2 - padX) / charW));
        const rows = Math.max(1, Math.floor(bodyH / lineH));
        return `${cols}x${rows}`;
      },
    });
  }

  function initCodeTabs() {
    const root = document.getElementById('code-showcase');
    const tabsContainer = document.getElementById('code-tabs');
    const thumb = document.getElementById('code-tabs-thumb');
    if (!root || !tabsContainer || !thumb || root.dataset.init) return;
    root.dataset.init = '1';

    const buttons = Array.from(tabsContainer.querySelectorAll<HTMLButtonElement>('.segmented-btn'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.code-panel'));
    const blurbs = Array.from(root.querySelectorAll<HTMLElement>('.blurb-panel'));

    function moveThumb(btn: HTMLElement, animate = true) {
      if (!thumb) return;
      if (!animate) thumb.style.transition = 'none';
      thumb.style.width = btn.offsetWidth + 'px';
      thumb.style.transform = `translateX(${btn.offsetLeft - 3}px)`;
      if (!animate) {
        void thumb.offsetWidth;
        thumb.style.transition = '';
      }
    }

    function swapIn(el: HTMLElement) {
      el.hidden = false;
      el.classList.remove('is-swap');
      void el.offsetWidth;
      el.classList.add('is-swap');
      el.addEventListener('animationend', () => el.classList.remove('is-swap'), { once: true });
    }

    function select(btn: HTMLButtonElement, focus = false) {
      if (btn.classList.contains('active')) { if (focus) btn.focus(); return; }
      const target = btn.dataset.tab;
      buttons.forEach((b) => {
        const on = b === btn;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
        b.tabIndex = on ? 0 : -1;
      });
      if (focus) btn.focus({ preventScroll: true });
      // keep the active tab visible inside the bar (never scrolls the page)
      const c = tabsContainer!;
      const left = btn.offsetLeft - (c.clientWidth - btn.offsetWidth) / 2;
      c.scrollTo({ left: Math.max(0, left), behavior: 'auto' });
      moveThumb(btn);

      panels.forEach((p) => {
        if (p.dataset.panel === target) {
          swapIn(p);
          const name = p.querySelector<HTMLElement>('.pane-name');
          if (name) {
            name.classList.remove('is-glitching');
            void name.offsetWidth;
            name.classList.add('is-glitching');
            setTimeout(() => name.classList.remove('is-glitching'), 200);
          }
        } else {
          p.hidden = true;
          p.classList.remove('is-swap');
        }
      });
      blurbs.forEach((b) => {
        if (b.dataset.blurb === target) swapIn(b);
        else { b.hidden = true; b.classList.remove('is-swap'); }
      });
    }

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => select(btn));
      btn.addEventListener('keydown', (e) => {
        let j = -1;
        if (e.key === 'ArrowRight') j = (i + 1) % buttons.length;
        else if (e.key === 'ArrowLeft') j = (i - 1 + buttons.length) % buttons.length;
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = buttons.length - 1;
        if (j < 0) return;
        e.preventDefault();
        select(buttons[j], true);
      });
    });

    const placeThumb = () => {
      const a = buttons.find((b) => b.classList.contains('active')) || buttons[0];
      if (a) moveThumb(a, false);
    };
    placeThumb();
    try { initPaneResize(root); } catch { /* resizing is a bonus */ }
    if ('fonts' in document) (document as any).fonts.ready.then(placeThumb);
    if ('ResizeObserver' in window) new ResizeObserver(placeThumb).observe(tabsContainer);
    else window.addEventListener('resize', placeThumb, { passive: true });
  }

  initCodeTabs();
  document.addEventListener('astro:page-load', initCodeTabs);
</script>
