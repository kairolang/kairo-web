---
import { Code } from 'astro:components';
import { langFor } from './kairo-lang';
import AsciiField from '../ascii/AsciiField.astro';
import '../../styles/resize.css';

const examples = [
  {
    id: 'syntax',
    label: 'Printing to the console',
    filename: 'hello.k',
    code: `import std::io::println  // import only what you need

// No main() required: a file with top-level code is a script, run top to bottom.
const name  = "Kairo"
var   count = 0

for i in 0..5 {
    println(f"Hello, {name}! {i} squared is {i * i}.")
    count++
}

println(f"Ran {count} times.")`,
    blurb: {
      heading: 'Simple, clean syntax',
      points: [
        { label: 'Type inference', body: 'Write `var count = 0` and the compiler knows it\'s an integer. Annotate when you want to, not because you have to.' },
        { label: 'String interpolation', body: '`f""` strings embed any expression directly, `{i * i}` included. No concatenation, no format specifiers.' },
        { label: 'Top-level code', body: 'Skip the `main()` boilerplate. A file with top-level statements is a script: they run in order, as the program.' },
      ],
    },
  },
  {
    id: 'cpp-in-kairo',
    label: 'C++ in Kairo',
    filename: 'ffi.k',
    code: `// Call C++ directly from Kairo: no bindings, no wrappers, no glue code.
// my_cpp_lib.hpp contains:
//   inline int add(int a, int b) { return a + b; }
//   namespace my_cpp_lib {
//       struct Vec2 { double x, y; double dot(Vec2 o) const { return x * o.x + y * o.y; } };
//       template <class T> T clamp(T v, T lo, T hi) { return v < lo ? lo : hi < v ? hi : v; }
//   }
// C++ namespaces map directly to Kairo module syntax; add() has none, so it's unqualified.

import std::io::println

ffi "c++" import "my_cpp_lib.hpp"  // the bundled clang parses it: classes, templates, all of it.
ffi "c++" import "vector"          // the C++ standard library is just another header.

var points: cxx::std::vector<my_cpp_lib::Vec2>  // a C++ template, instantiated from Kairo.

points.push_back(my_cpp_lib::Vec2 { x: 3.0, y: 4.0 })
points.push_back(my_cpp_lib::Vec2 { x: 6.0, y: 8.0 })

var total = 0

for p in points {  // C++ iterators drive a Kairo for loop.
    total = add(total, my_cpp_lib::clamp(p.dot(p) as i32, 0, 50))  // clamp<int>, deduced.
}

println(f"{points.size()} points, total {total}")  // 2 points, total 75`,
    blurb: {
      heading: 'Drop in, not rewrite',
      points: [
        { label: 'No binding step', body: 'Point Kairo at a C++ header and call it. Classes, methods and templates arrive as native Kairo symbols, with no generated wrappers and no intermediate layer.' },
        { label: 'Namespaces and templates just work', body: 'C++ namespaces map to Kairo module syntax, and `cxx::std::vector<my_cpp_lib::Vec2>` instantiates a C++ template from Kairo. Your existing library surface stays exactly as you designed it.' },
        { label: 'Migrate at your own pace', body: 'Move files to Kairo one at a time while the rest of your codebase stays in C++. There\'s no cutover point, no rewrite cliff.' },
      ],
    },
  },
  {
    id: 'kairo-in-cpp',
    label: 'Kairo in C++',
    filename: 'kairo_ffi.cpp',
    code: `// Include a Kairo module straight from C++ with kcc, a drop-in clang-compatible driver:
//   \`kcc kairo_ffi.cpp -o app\` finds kairo_ffi.k, compiles it and links it in.
// Shipping a library? \`kairo kairo_ffi.k -c --emit-headers include/\` writes the headers.
// kairo_ffi.k:
//   pub struct Vec2 { var x: f64; var y: f64 }
//   pub fn dot(a: Vec2, b: Vec2) -> f64 { return a.x * b.x + a.y * b.y }
//   pub struct Overdrawn { var short_by: i64 }
//   pub fn withdraw(balance: i64, amount: i64) panic -> i64 {
//       if amount > balance { panic Overdrawn { short_by: amount - balance } }
//       return balance - amount
//   }
// The module's C++ namespace is its file name: kairo_ffi.

#include "kairo_ffi.k"
#include <iostream>

int main() {
    kairo_ffi::Vec2 v{3.0, 4.0};      // a Kairo struct is a plain C++ aggregate.
    std::cout << kairo_ffi::dot(v, v) << std::endl;  // 25

    try {   // a Kairo panic is a value; value_or_throw turns it into a C++ exception.
        auto left = builtin::value_or_throw(kairo_ffi::withdraw(100, 30));  // 70
        builtin::value_or_throw(kairo_ffi::withdraw(left, 500));
    } catch (const builtin::panic_error<kairo_ffi::Overdrawn>& e) {
        std::cout << "short by " << e.error.short_by << std::endl;  // 430
    }
}`,
    blurb: {
      heading: 'Adopt Kairo incrementally',
      points: [
        { label: 'Include like any header', body: 'With `kcc`, a Kairo module is `#include`-able directly from C++. The only change to your build is the C++ compiler it calls.' },
        { label: 'Native C++ types', body: 'Kairo structs are plain C++ aggregates and functions are ordinary C++ calls, under a namespace named after the file. A panic is a value; `builtin::value_or_throw` turns it into a C++ exception when you want one.' },
        { label: 'Ship Kairo as a C++ library', body: 'Use `kairo -c` to compile the module and `--emit-headers` to generate its C++ headers. Consumers see a normal library.' },
      ],
    },
  },
  {
    id: 'memory',
    label: 'Memory Safety',
    filename: 'memory.k',
    code: `import std::io::println
import std::System

// The whole program's heap is yours: five static functions, no vtable, no indirection.
// Every allocation in the program, the standard library's included, comes here.
class Counting {
    static live: i64 = 0
    static fn alloc(n: usize, a: usize) -> unsafe *u8 { Self::live += 1; return System::alloc(n, a) }
    static fn free(p: unsafe *u8, n: usize, a: usize) { Self::live -= 1; System::free(p, n, a) }
    static fn resize(p: unsafe *u8, o: usize, n: usize, a: usize) -> bool { return System::resize(p, o, n, a) }
    static fn realloc(p: unsafe *u8, o: usize, n: usize, a: usize) -> unsafe *u8 { return System::realloc(p, o, n, a) }
    static fn alloc_zeroed(n: usize, a: usize) -> unsafe *u8 { Self::live += 1; return System::alloc_zeroed(n, a) }
}

@set_global_allocator(Counting)  // System is the default heap: the bundled mimalloc.

class Node { var value: i32; fn Node(self, v: i32) { self.value = v } }

class Owner {
    var node: *Node
    fn Owner(self, v: i32) { self.node = @create Node(v) }  // on the heap, because you said so.
    @copy fn Owner(self, other: Self) = delete                // one owner, so no double free.
    fn op delete(self) { @destroy self.node }                // the destructor.
}

fn work() {
    var a = Owner(1)
    var b = Owner(2)
    // var c = a   // compile error: Owner cannot be copied.
    println(f"inside: {Counting::live} live allocations")  // inside: 2 live allocations
}   // b, then a: destructors run here, on every path out of the scope.

work()
println(f"after: {Counting::live} live allocations")  // after: 0 live allocations`,
    blurb: {
      heading: 'Control without the footguns',
      points: [
        { label: 'Manual allocation', body: 'You decide what goes on the heap: `@create` and `@destroy`, no GC, no hidden allocations. The default heap is the bundled mimalloc.' },
        { label: 'Your allocator, everywhere', body: '`@set_global_allocator` swaps the heap for the whole program, the standard library included. An allocator is five static functions, with no vtable.' },
        { label: 'Automatic cleanup', body: 'Destructors run where each value goes out of scope, in reverse order, on every path out. Delete the copy constructor and an accidental copy, the classic double free, is a compile error.' },
      ],
    },
  },
  {
    id: 'error-handling',
    label: 'Error Handling',
    filename: 'errors.k',
    code: `import std::io::println

struct InUse   { var port: i32 }   // any type can be panicked:
struct Denied  { var port: i32 }   // no base class, no exception hierarchy.
struct BadPort { var port: i32 }
struct Socket  { var port: i32 }

// A declared panic set is a contract: panicking anything else is a compile error.
fn open(port: i32) panic(InUse, Denied) -> Socket {
    if port < 1024  { panic Denied { port: port } }  // privileged
    if port == 8080 { panic InUse { port: port } }   // already listening
    
    return Socket { port: port }
}

fn listen(port: i32) panic -> Socket {  // set inferred: Denied, BadPort.
    if port > 65535 { panic BadPort { port: port } }
    
    try {
        return open(port)
    } catch e: InUse {
        println(f"{e.port} is already ours, reusing it")
        return Socket { port: e.port }
    } catch e {  // Denied is the caller's problem: re-panic it, original site intact.
        panic e
    }
}

// No \`panic\` here: every error listen() can raise is handled below.
// Delete either arm and this function no longer compiles; add a \`catch e: InUse\`
// and the compiler flags it as dead: InUse can never reach this scope.
fn serve(port: i32) -> Socket {
    try {
        return listen(port)
    } catch e: Denied {
        println(f"{e.port} needs root, using 3000")
    } catch e: BadPort {
        println(f"{e.port} is not a port, using 3000")
    }

    return Socket { port: 3000 }
}

for port in [8080, 80, 99999, 4000] {
    const s = serve(port)  // callers of serve() need no error handling at all.
    println(f"listening on {s.port}")
}`,
    blurb: {
      heading: 'The compiler knows what can fail',
      points: [
        { label: '`panic` on the signature', body: 'Mark a function `panic` and the compiler infers its panic set from everything it can reach. Declare the set, `panic(InUse, Denied)`, and it becomes a contract the compiler enforces.' },
        { label: 'Exhaustive catch blocks', body: 'Catch blocks work like a match on an enum. Handle every reachable panic type and the function needs no `panic` at all, so its callers need no error handling.' },
        { label: 'Propagate what you don\'t own', body: 'Use `catch e { panic e }` to handle what you care about and push the rest upstream. The original panic travels intact, no wrapping, no lost context.' },
        { label: 'Dead catches are flagged too', body: 'If a catch block handles a panic type that can\'t actually reach that scope, the compiler warns and offers to remove it. Catch blocks stay honest as code changes over time.' },
      ],
    },
  },
];

const inlineCode = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/`([^`]+)`/g, '<code>$1</code>');

const LANG_NAMES: Record<string, string> = { k: 'kairo', kro: 'kairo', cpp: 'c++', hpp: 'c++' };
const enc = new TextEncoder();
const panes = await Promise.all(
  examples.map(async (ex) => {
    const ext = ex.filename.split('.').pop() ?? 'txt';
    return {
      ...ex,
      ext,
      lang: await langFor(ex.filename),
      langName: LANG_NAMES[ext] ?? ext,
      lines: ex.code.split('\n').length,
      bytes: enc.encode(ex.code).length,
    };
  }),
);
// vim-style "~" rows fill the empty viewport under short files
const TILDES = Array.from({ length: 30 }, () => '~').join('\n');
---

<section class="showcase-section" id="code-showcase" aria-labelledby="showcase-title">
  <!-- the same slow drifting noise field as the CTA (own clock offset), faded
       out under the content; copy sits on solid backing. Reduced motion: one
       still frame. -->
  <AsciiField
    preset="noise"
    size={13}
    fps={20}
    radius={170}
    strength={0.3}
    t0={7.4}
    opacity={0.24}
    mask="radial-gradient(ellipse 60% 64% at 50% 52%, transparent 40%, #000 90%)"
    hole={[0.5, 0.52, 0.27, 0.288]}
  />
  <div class="container showcase-inner">

    <!-- Heading -->
    <div class="showcase-head" data-reveal-stagger>
      <div class="section-label">01 - Code</div>
      <h2 class="display showcase-h2" id="showcase-title">
        See it in action.
        <span class="dim">Clean syntax. No magic.</span>
      </h2>
    </div>

    <!-- ASCII tab bar -->
    <div class="showcase-tabs-row">
      <div class="segmented showcase-tabs" id="code-tabs" role="tablist" aria-label="Code examples">
        <div class="segmented-thumb" id="code-tabs-thumb" aria-hidden="true"></div>
        {panes.map((ex, i) => (
          <button
            type="button"
            class={`segmented-btn ${i === 0 ? 'active' : ''}`}
            id={`code-tab-${ex.id}`}
            data-tab={ex.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`code-panel-${ex.id}`}
            tabindex={i === 0 ? '0' : '-1'}
          >{ex.label}</button>
        ))}
      </div>
      <p class="showcase-hint" aria-hidden="true">// {panes.length} examples · <kbd>←</kbd> <kbd>→</kbd> to switch</p>
    </div>

    <div class="showcase-grid">

      <!-- LEFT: code panes -->
      <div class="showcase-code" id="showcase-code">
        {panes.map((ex, i) => (
          <div
            class="code-panel"
            id={`code-panel-${ex.id}`}
            data-panel={ex.id}
            role="tabpanel"
            aria-labelledby={`code-tab-${ex.id}`}
            hidden={i !== 0}
          >
            <div class="ascii-frame ascii-frame--fill pane">
              <span class="ascii-frame-title"><span class="pane-name glitch">{ex.filename}</span></span>
              <span class="ascii-frame-meta">{ex.langName}</span>
              <div class="pane-view">
                <div class="pane-body" tabindex="0" aria-label={`${ex.filename} source`}>
                  <div class="pane-code">
                    <Code
                      code={ex.code}
                      lang={ex.lang}
                      themes={{ dark: 'github-dark-default', light: 'github-light-default' }}
                      defaultColor={false}
                    />
                  </div>
                  <pre class="pane-tilde" aria-hidden="true">{TILDES}</pre>
                </div>
                <span class="pane-scan" aria-hidden="true"></span>
              </div>
              <div class="pane-status" aria-hidden="true">
                <span class="pane-mode">normal</span>
                <span class="pane-file">"{ex.filename}" {ex.lines}L, {ex.bytes}B</span>
                <span class="pane-right">{ex.langName} │ utf-8 │ ln 1</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- RIGHT: blurb trees -->
      <div class="showcase-blurbs">
        {panes.map((ex, i) => (
          <div class="blurb-panel" data-blurb={ex.id} hidden={i !== 0}>
            <h3 class="blurb-heading">{ex.blurb.heading}</h3>
            <ul class="blurb-tree">
              {ex.blurb.points.map(pt => (
                <li>
                  <span class="blurb-label" set:html={inlineCode(pt.label)} />
                  <span class="blurb-body" set:html={inlineCode(pt.body)} />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .showcase-section {
    padding: clamp(5rem, 12vh, 8.5rem) 0;
    border-top: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  .showcase-inner {
    position: relative;
    z-index: 1;
  }
  /* solid backing for copy over the field (readability first) */
  .showcase-head > *,
  .showcase-hint,
  .showcase-blurbs {
    background-color: var(--bg);
    box-shadow: 0 0 0 0.6rem var(--bg);
  }
  .showcase-head > * { width: fit-content; margin-inline: auto; }
  .showcase-tabs { background-color: var(--bg); }

  .showcase-head {
    text-align: center;
    margin-bottom: 2.25rem;
  }
  .showcase-h2 {
    font-size: clamp(1.75rem, 3.8vw, 2.8rem);
    margin: 0;
  }
  .showcase-h2 .dim {
    display: block;
    font-weight: 500;
  }

  .showcase-tabs-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 2.25rem;
    max-width: 100%;
  }
  .showcase-tabs { max-width: 100%; }
  .showcase-hint {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--text-3);
  }
  .showcase-hint kbd { font-size: 0.9em; color: var(--text-2); }

  /* --sc-code: the code column's width while the pane is drag-resized; the
     blurb column takes the rest and reflows live */
  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--sc-code, 1.6fr)) minmax(240px, 1fr);
    gap: clamp(2rem, 4vw, 3.25rem);
    align-items: start;
  }
  .showcase-code { min-width: 0; }

  @media (max-width: 900px) {
    .showcase-grid { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .showcase-head { text-align: left; }
    .showcase-head > * { margin-inline: 0; }
    .showcase-tabs-row { align-items: flex-start; }
    .showcase-hint { display: none; }
  }

  /* ── Code pane: ASCII frame + vim viewport ── */
  .pane {
    --frame-pad: 0;
    padding-top: 0.6rem;
  }
  .pane-name { display: inline-block; }

  .pane-view {
    position: relative;
    overflow: hidden;
  }
  .pane-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: var(--sc-pane-h, 540px);
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    /* x contained (no back-swipe on long lines); y chains to the page */
    overscroll-behavior: contain auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border-hi) transparent;
  }
  .pane-body:focus-visible { outline-offset: -2px; }
  .pane-code { flex-shrink: 0; min-width: 100%; }

  .pane-code :global(pre.astro-code) {
    margin: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    padding: 1.1rem 1.5rem 0 !important;
    font-size: 0.82rem !important;
    line-height: 1.75 !important;
    font-family: var(--font-mono) !important;
    background: transparent !important;
    min-width: 0;
    width: max-content;
    overflow: visible !important;
  }
  .pane-tilde {
    flex: 1 0 0;
    min-height: 0;
    overflow: hidden;
    margin: 0;
    padding: 0 1.5rem 1.1rem;
    border: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.75;
    color: var(--text-3);
    opacity: 0.7;
    user-select: none;
  }

  .pane-status {
    display: flex;
    align-items: center;
    gap: 1.5ch;
    border-top: 1px solid var(--frame-line);
    background: var(--bg-3);
    font-size: 0.68rem;
    line-height: 1;
    color: var(--text-2);
    white-space: nowrap;
    overflow: hidden;
  }
  .pane-mode {
    padding: 0.5rem 1ch;
    background: var(--red);
    color: var(--on-red);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pane-file { overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .pane-right { margin-left: auto; padding-right: 1ch; color: var(--text-3); }

  @media (max-width: 900px) {
    .pane-body { height: var(--sc-pane-h, 420px); }
  }

  /* soft wrap once the pane has been resized narrower than its code;
     wrapped rows hang 2ch in so each source line still reads as one */
  .showcase-code.is-wrapped .pane-code { width: 100%; min-width: 0; }
  .showcase-code.is-wrapped .pane-code :global(pre.astro-code) {
    width: auto;
    white-space: pre-wrap !important;
    overflow-wrap: anywhere;
  }
  .showcase-code.is-wrapped .pane-code :global(.line) {
    display: inline-block;
    max-width: 100%;
    vertical-align: top;
    padding-left: 2ch;
    text-indent: -2ch;
  }
  @media (max-width: 520px) {
    .pane-right { display: none; }
    .pane-code :global(pre.astro-code) { font-size: 0.76rem !important; padding: 1rem 1rem 0 !important; }
    .pane-tilde { font-size: 0.76rem; padding: 0 1rem 1rem; }
  }

  /* ── Tab swap: stepped print-in + one scan line, then still ── */
  .code-panel.is-swap .pane-view { animation: paneIn 220ms steps(8, end) both; }
  .code-panel.is-swap .pane-scan { animation: paneScan 220ms steps(8, end) both; }
  .blurb-panel.is-swap { animation: paneIn 200ms steps(6, end) 40ms both; }

  .pane-scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      to bottom,
      transparent calc(100% - 28px),
      color-mix(in srgb, var(--red) 9%, transparent) calc(100% - 2px),
      var(--red) 0
    );
  }
  @keyframes paneIn {
    from { clip-path: inset(0 0 100% 0); }
    to   { clip-path: inset(0 0 0 0); }
  }
  @keyframes paneScan {
    0%   { opacity: 1; transform: translateY(-100%); }
    99%  { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(0); }
  }

  /* ── Blurb: "├── label" tree ── */
  .blurb-heading {
    display: flex;
    align-items: baseline;
    gap: 1ch;
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0.25rem 0 1.4rem;
  }
  .blurb-heading::before {
    content: '▌';
    content: '▌' / '';
    color: var(--red);
  }
  .blurb-tree {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.84rem;
  }
  .blurb-tree li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0 0 1.25rem 4.2ch;
  }
  .blurb-tree li:last-child { padding-bottom: 0; }
  .blurb-tree li::before {
    content: '├──';
    content: '├──' / '';
    position: absolute;
    left: 0;
    top: 0;
    line-height: 1.45;
    color: var(--text-3);
    transition: color var(--dur-instant) steps(1, end);
  }
  .blurb-tree li:last-child::before { content: '└──'; content: '└──' / ''; }
  /* continuous rail down the tree, under the ├ stroke */
  .blurb-tree li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(0.5ch - 0.5px);
    top: 1.2em;
    bottom: 0;
    width: 1px;
    background: var(--text-3);
    opacity: 0.8;
  }
  .blurb-tree li:hover::before { color: var(--accent); }

  .blurb-label {
    font-weight: 600;
    line-height: 1.45;
    color: var(--text);
  }
  .blurb-body {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.65;
  }
  .blurb-tree :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--text);
    background: var(--bg-3);
    border: 1px solid var(--border);
    padding: 0 0.4ch;
    border-radius: 0;
  }
  .blurb-label :global(code) { color: var(--accent); }
</style>

<script>
  import { makeResizable } from '../../lib/ascii/resize';

  /**
   * The code column is resizable from its bottom-right corner / right and
   * bottom edges: the grid's first track follows --sc-code (blurb column
   * reflows live), every pane's viewport follows --sc-pane-h, and the code
   * soft-wraps once narrower than its longest line. <=900px (single column):
   * height only.
   */
  function initPaneResize(root: HTMLElement) {
    const col = root.querySelector<HTMLElement>('#showcase-code');
    const grid = root.querySelector<HTMLElement>('.showcase-grid');
    if (!col || !grid) return;
    let chrome = 0, gap = 0, charW = 7.9, lineH = 23, padX = 0, bodyH = 0;
    const visibleBody = () =>
      col.querySelector<HTMLElement>('.code-panel:not([hidden]) .pane-body') ?? col.querySelector<HTMLElement>('.pane-body');

    makeResizable(col, {
      handles: ['se', 'e', 's'],
      anchor: 'start',
      label: 'the code pane',
      axis: () => (window.innerWidth <= 900 ? 'y' : 'both'),
      measure: () => {
        const r = col.getBoundingClientRect();
        const b = visibleBody();
        bodyH = b ? b.getBoundingClientRect().height : 0;
        chrome = r.height - bodyH;
        gap = parseFloat(getComputedStyle(grid).columnGap) || 0;
        const pre = b?.querySelector('pre');
        if (pre) {
          const cs = getComputedStyle(pre);
          const fs = parseFloat(cs.fontSize) || 13;
          charW = fs * 0.6;
          lineH = parseFloat(cs.lineHeight) || fs * 1.75;
          padX = (parseFloat(cs.paddingLeft) || 0) + (parseFloat(cs.paddingRight) || 0);
        }
        return r;
      },
      minWidth: 340,
      maxWidth: () => grid.clientWidth - gap - 260,
      minHeight: () => chrome + lineH * 7,
      maxHeight: () => chrome + Math.max(540, window.innerHeight * 0.9),
      apply(w, h, dw, dh) {
        if (dw) {
          col.classList.add('is-wrapped');
          grid.style.setProperty('--sc-code', w + 'px');
        }
        if (dh) {
          bodyH = Math.round(h - chrome);
          root.style.setProperty('--sc-pane-h', bodyH + 'px');
        }
      },
      reset() {
        grid.style.removeProperty('--sc-code');
        root.style.removeProperty('--sc-pane-h');
        col.classList.remove('is-wrapped');
      },
      readout: (w) => {
        const cols = Math.max(1, Math.floor((w - 2 - padX) / charW));
        const rows = Math.max(1, Math.floor(bodyH / lineH));
        return `${cols}x${rows}`;
      },
    });
  }

  function initCodeTabs() {
    const root = document.getElementById('code-showcase');
    const tabsContainer = document.getElementById('code-tabs');
    const thumb = document.getElementById('code-tabs-thumb');
    if (!root || !tabsContainer || !thumb || root.dataset.init) return;
    root.dataset.init = '1';

    const buttons = Array.from(tabsContainer.querySelectorAll<HTMLButtonElement>('.segmented-btn'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.code-panel'));
    const blurbs = Array.from(root.querySelectorAll<HTMLElement>('.blurb-panel'));

    function moveThumb(btn: HTMLElement, animate = true) {
      if (!thumb) return;
      if (!animate) thumb.style.transition = 'none';
      thumb.style.width = btn.offsetWidth + 'px';
      thumb.style.transform = `translateX(${btn.offsetLeft - 3}px)`;
      if (!animate) {
        void thumb.offsetWidth;
        thumb.style.transition = '';
      }
    }

    function swapIn(el: HTMLElement) {
      el.hidden = false;
      el.classList.remove('is-swap');
      void el.offsetWidth;
      el.classList.add('is-swap');
      el.addEventListener('animationend', () => el.classList.remove('is-swap'), { once: true });
    }

    function select(btn: HTMLButtonElement, focus = false) {
      if (btn.classList.contains('active')) { if (focus) btn.focus(); return; }
      const target = btn.dataset.tab;
      buttons.forEach((b) => {
        const on = b === btn;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
        b.tabIndex = on ? 0 : -1;
      });
      if (focus) btn.focus({ preventScroll: true });
      // keep the active tab visible inside the bar (never scrolls the page)
      const c = tabsContainer!;
      const left = btn.offsetLeft - (c.clientWidth - btn.offsetWidth) / 2;
      c.scrollTo({ left: Math.max(0, left), behavior: 'auto' });
      moveThumb(btn);

      panels.forEach((p) => {
        if (p.dataset.panel === target) {
          swapIn(p);
          const name = p.querySelector<HTMLElement>('.pane-name');
          if (name) {
            name.classList.remove('is-glitching');
            void name.offsetWidth;
            name.classList.add('is-glitching');
            setTimeout(() => name.classList.remove('is-glitching'), 200);
          }
        } else {
          p.hidden = true;
          p.classList.remove('is-swap');
        }
      });
      blurbs.forEach((b) => {
        if (b.dataset.blurb === target) swapIn(b);
        else { b.hidden = true; b.classList.remove('is-swap'); }
      });
    }

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => select(btn));
      btn.addEventListener('keydown', (e) => {
        let j = -1;
        if (e.key === 'ArrowRight') j = (i + 1) % buttons.length;
        else if (e.key === 'ArrowLeft') j = (i - 1 + buttons.length) % buttons.length;
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = buttons.length - 1;
        if (j < 0) return;
        e.preventDefault();
        select(buttons[j], true);
      });
    });

    const placeThumb = () => {
      const a = buttons.find((b) => b.classList.contains('active')) || buttons[0];
      if (a) moveThumb(a, false);
    };
    placeThumb();
    try { initPaneResize(root); } catch { /* resizing is a bonus */ }
    if ('fonts' in document) (document as any).fonts.ready.then(placeThumb);
    if ('ResizeObserver' in window) new ResizeObserver(placeThumb).observe(tabsContainer);
    else window.addEventListener('resize', placeThumb, { passive: true });
  }

  initCodeTabs();
  document.addEventListener('astro:page-load', initCodeTabs);
</script>
