---
// Fetch live data from GitHub at build time
let stars = 320;
let contributors = 6;
let forks = 12;

try {
  const [repoRes, contribRes] = await Promise.all([
    fetch('https://api.github.com/repos/kairolang/kairo-lang', {
      headers: { 'Accept': 'application/vnd.github.v3+json', 'User-Agent': 'kairo-web' },
    }),
    fetch('https://api.github.com/repos/kairolang/kairo-lang/contributors?per_page=100', {
      headers: { 'Accept': 'application/vnd.github.v3+json', 'User-Agent': 'kairo-web' },
    }),
  ]);

  if (repoRes.ok) {
    const repo = await repoRes.json();
    stars = repo.stargazers_count ?? stars;
    forks = repo.forks_count ?? forks;
  }
  if (contribRes.ok) {
    const contribs = await contribRes.json();
    contributors = Array.isArray(contribs) ? contribs.length : contributors;
  }
} catch (e) {
  console.warn('[kairo-web] GitHub API fetch failed, using fallback stats');
}

const stats = [
  { value: stars,        suffix: '+', label: 'GitHub Stars' },
  { value: 55,           suffix: '+', label: 'Weekly Downloads' },
  { value: contributors, suffix: '',  label: 'Contributors' },
  { value: forks,        suffix: '',  label: 'Forks' },
];
---

<section class="stats-section">
  <div class="container">
    <div class="stats-row" id="stats-grid" data-reveal>
      {stats.map((stat, i) => (
        <div class="stats-item">
          <div class="stats-number" data-target={stat.value} data-suffix={stat.suffix}>
            0{stat.suffix}
          </div>
          <div class="stats-label">{stat.label}</div>
        </div>
      ))}
    </div>
    <p class="stats-footer" data-reveal>
      Alpha stage · Compiler written in C++ · Self-hosting in progress
    </p>
  </div>
</section>

<style>
  .stats-section {
    padding: 5rem 0;
    background: var(--bg-2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .stats-item {
    text-align: center;
  }

  .stats-number {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--text);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stats-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: var(--text-3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .stats-footer {
    text-align: center;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.75rem;
    color: var(--text-3);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-top: 3rem;
  }

  @media (max-width: 600px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); gap: 2.5rem; }
  }
</style>

<script>
  function initStats() {
    const grid = document.getElementById('stats-grid');
    if (!grid) return;
    const numbers = grid.querySelectorAll('.stats-number');
    let animated = false;

    function easeOut(t: number) { return 1 - Math.pow(1 - t, 3); }

    function animateCount(el: Element) {
      const target = parseInt((el as HTMLElement).dataset.target || '0');
      const suffix = (el as HTMLElement).dataset.suffix || '';
      const duration = 1400;
      const start = performance.now();
      function step(now: number) {
        const progress = Math.min((now - start) / duration, 1);
        el.textContent = Math.floor(easeOut(progress) * target) + suffix;
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    new IntersectionObserver(entries => {
      if (entries[0].isIntersecting && !animated) {
        animated = true;
        numbers.forEach((el, i) => {
          setTimeout(() => animateCount(el), i * 120);
        });
      }
    }, { threshold: 0.3 }).observe(grid);
  }

  initStats();
  document.addEventListener('astro:page-load', initStats);
</script>
