---
// Fetch live data from GitHub at build time
let stars = 320;
let contributors = 6;
let forks = 12;

try {
  const [repoRes, contribRes] = await Promise.all([
    fetch('https://api.github.com/repos/kairolang/kairo-lang', {
      headers: { 'Accept': 'application/vnd.github.v3+json', 'User-Agent': 'kairo-web' },
    }),
    fetch('https://api.github.com/repos/kairolang/kairo-lang/contributors?per_page=100', {
      headers: { 'Accept': 'application/vnd.github.v3+json', 'User-Agent': 'kairo-web' },
    }),
  ]);

  if (repoRes.ok) {
    const repo = await repoRes.json();
    stars = repo.stargazers_count ?? stars;
    forks = repo.forks_count ?? forks;
  }
  if (contribRes.ok) {
    const contribs = await contribRes.json();
    contributors = Array.isArray(contribs) ? contribs.length : contributors;
  }
} catch (e) {
  console.warn('[kairo-web] GitHub API fetch failed, using fallback stats');
}

const stats = [
  { value: stars,        suffix: '+', label: 'GitHub Stars' },
  { value: 55,           suffix: '+', label: 'Weekly Downloads' },
  { value: contributors, suffix: '',  label: 'Contributors' },
  { value: forks,        suffix: '',  label: 'Forks' },
];
---

<section class="stats-section">
  <div class="container">
    <div class="stats-row" id="stats-grid" data-reveal-stagger data-stagger-step="90">
      {stats.map(stat => (
        <div class="stats-item">
          <div class="stats-number tabular" data-target={stat.value} data-suffix={stat.suffix}>
            0{stat.suffix}
          </div>
          <div class="stats-label">{stat.label}</div>
        </div>
      ))}
    </div>
    <p class="stats-footer" data-reveal>
      Alpha stage · Compiler written in C++ · Self-hosting in progress
    </p>
  </div>
</section>

<style>
  .stats-section {
    padding: clamp(5rem, 10vh, 8rem) 0 5rem;
    position: relative;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .stats-item {
    text-align: center;
    padding: 0.5rem 1rem;
    position: relative;
  }
  .stats-item + .stats-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 15%;
    bottom: 15%;
    width: 1px;
    background: var(--border);
  }

  .stats-number {
    font-size: clamp(2.4rem, 4.6vw, 3.6rem);
    font-weight: 550;
    letter-spacing: -0.04em;
    color: var(--text);
    line-height: 1.05;
    margin-bottom: 0.6rem;
  }

  .stats-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .stats-footer {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 3.5rem;
  }

  @media (max-width: 640px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); row-gap: 2.5rem; }
    .stats-item:nth-child(3)::before { display: none; }
  }
</style>

<script>
  function initStats() {
    const grid = document.getElementById('stats-grid');
    if (!grid) return;
    const numbers = grid.querySelectorAll('.stats-number');
    let animated = false;

    function easeOut(t: number) { return 1 - Math.pow(1 - t, 4); }

    function animateCount(el: Element) {
      const target = parseInt((el as HTMLElement).dataset.target || '0');
      const suffix = (el as HTMLElement).dataset.suffix || '';
      const duration = 1600;
      const start = performance.now();
      function step(now: number) {
        const progress = Math.min((now - start) / duration, 1);
        el.textContent = Math.floor(easeOut(progress) * target) + suffix;
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    new IntersectionObserver((entries, obs) => {
      if (entries[0].isIntersecting && !animated) {
        animated = true;
        numbers.forEach((el, i) => {
          setTimeout(() => animateCount(el), i * 110);
        });
        obs.disconnect();
      }
    }, { threshold: 0.3 }).observe(grid);
  }

  initStats();
  document.addEventListener('astro:page-load', initStats);
</script>
