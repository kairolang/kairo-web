---
---
<section class="capabilities-section" style="border-top:1px solid var(--border);">
  <!-- Diagonal red accent -->
  <div style="position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--red),transparent);opacity:0.4;pointer-events:none;animation:beamMove 6s linear infinite;"></div>
  <!-- Animated diagonal striping -->
  <div style="position:absolute;inset:0;background-image:repeating-linear-gradient(135deg,rgba(189,9,32,0.02) 0,rgba(189,9,32,0.02) 1px,transparent 0,transparent 50%);background-size:24px 24px;pointer-events:none;"></div>

  <div class="container">
    <div style="margin-bottom:4rem;" data-reveal>
      <div class="section-label">How it works</div>
      <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(1.75rem,4vw,2.75rem);font-weight:700;letter-spacing:-0.03em;line-height:1.1;color:var(--text);max-width:500px;">
        The compiler,<br>
        <span style="color:var(--text-2);font-weight:400;">in practice.</span>
      </h2>
    </div>

    <div class="capabilities-list">

      <!-- Block 1 -->
      <div class="cap-block" data-reveal>
        <div class="cap-number">01</div>
        <div class="cap-content">
          <h3 class="cap-title">Include a .kro file from C++</h3>
          <p class="cap-desc">Kairo compiles to Clang tokens, not object files. Your C++ build includes Kairo files the same way it includes headers — no FFI boundary, no ABI negotiation, templates and inlining work as normal.</p>
          <pre class="cap-code"><code class="cap-code-inner">// main.cpp
#include "renderer.kro"

int main() &#123;
    auto scene = renderer::Scene::new();
    scene.add_mesh(renderer::Mesh::load("model.obj"));
    scene.render();  // Kairo function, called directly
&#125;</code></pre>
        </div>
      </div>

      <div class="cap-divider"></div>

      <!-- Block 2 -->
      <div class="cap-block" data-reveal>
        <div class="cap-number">02</div>
        <div class="cap-content">
          <h3 class="cap-title">Use any C++ library directly</h3>
          <p class="cap-desc"><code class="cap-inline">ffi "c++"</code> import gives you the full C++ symbol table — classes, templates, operator overloads, everything. No bindings to write, no generated glue code, no runtime overhead.</p>
          <pre class="cap-code"><code class="cap-code-inner">ffi "c++" import "llvm/IR/Module.h"
ffi "c++" import "llvm/IR/IRBuilder.h"

var ctx     = llvm::LLVMContext()
var mod     = llvm::Module("my_module", ctx)
var builder = llvm::IRBuilder(ctx)

// Full C++ API, no wrappers
var fn_type = llvm::FunctionType::get(builder.getInt32Ty(), false)
var fn      = llvm::Function::Create(fn_type, llvm::Function::ExternalLinkage, "main", mod)</code></pre>
        </div>
      </div>

      <div class="cap-divider"></div>

      <!-- Block 3 -->
      <div class="cap-block" data-reveal>
        <div class="cap-number">03</div>
        <div class="cap-content">
          <h3 class="cap-title">Safety without rewriting</h3>
          <p class="cap-desc">The BCIR borrow checker analyzes ownership across your Kairo and C++ code together. Invalid borrows lower to smart pointers automatically — the code still compiles, you get a report of what was fixed.</p>
          <pre class="cap-code"><code class="cap-code-inner">fn process(data: *u8, len: usize) &#123;
    var ptr = data
    std::Memory::free(data)
    ptr[0] = 1  // note[BCIR]: use after free
                // lowered to UniquePtr&lt;u8&gt; automatically
                // recompile with --bcir-report for full ownership graph
&#125;</code></pre>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .capabilities-section {
    padding: 7rem 0;
    background: var(--bg);
    position: relative;
    overflow: hidden;
  }

  .capabilities-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .cap-block {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 2.5rem;
    padding: 3rem 0;
    align-items: start;
  }

  @media (max-width: 640px) {
    .cap-block {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 2rem 0;
    }
  }

  .cap-number {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--red);
    padding-top: 0.2rem;
    user-select: none;
  }

  .cap-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cap-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0;
  }

  .cap-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.7;
    max-width: 660px;
    margin: 0;
  }

  .cap-inline {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85em;
    color: var(--text);
    background: var(--bg-3);
    border: 1px solid var(--border);
    padding: 1px 5px;
    border-radius: 2px;
  }

  .cap-code {
    margin: 0;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-left: 2px solid rgba(189,9,32,0.35);
    border-radius: 2px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .cap-code-inner {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    line-height: 1.75;
    color: var(--text-2);
    padding: 1.1rem 1.4rem;
    white-space: pre;
  }

  .cap-divider {
    height: 1px;
    background: var(--border);
  }
</style>
