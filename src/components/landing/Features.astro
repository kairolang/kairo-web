---
const blocks = [
  {
    number: '01',
    title: 'Include a .k file from C++',
    desc: 'Kairo compiles to Clang tokens, not object files. Your C++ build includes Kairo files the same way it includes headers no FFI boundary, no ABI negotiation, templates and inlining work as normal.',
    filename: 'main.cpp',
    code: `// main.cpp
#include "renderer.k"

int main() {
    auto scene = renderer::Scene::new();
    scene.add_mesh(renderer::Mesh::load("model.obj"));
    scene.render();  // Kairo function, called directly
}`,
  },
  {
    number: '02',
    title: 'Use any C++ library directly',
    desc: 'ffi "c++" import gives you the full C++ symbol table classes, templates, operator overloads, everything. No bindings to write, no generated glue code, no runtime overhead.',
    filename: 'codegen.k',
    code: `ffi "c++" import "llvm/IR/Module.h"
ffi "c++" import "llvm/IR/IRBuilder.h"

var ctx     = llvm::LLVMContext()
var mod     = llvm::Module("my_module", ctx)
var builder = llvm::IRBuilder(ctx)

// Full C++ API, no wrappers
var fn_type = llvm::FunctionType::get(builder.getInt32Ty(), false)
var fn      = llvm::Function::Create(fn_type, llvm::Function::ExternalLinkage, "main", mod)`,
  },
  {
    number: '03',
    title: 'Safety without rewriting',
    desc: 'The BCIR borrow checker analyzes ownership across your Kairo and C++ code together. Invalid borrows lower to smart pointers automatically the code still compiles, you get a report of what was fixed.',
    filename: 'process.k',
    code: `fn process(data: *u8, len: usize) {
    var ptr = data
    std::Memory::free(data)
    ptr[0] = 1  // note[BCIR]: use after free
                // lowered to UniquePtr<u8> automatically
                // recompile with --bcir-report for full ownership graph
}`,
  },
];
---

<section class="cap-section">
  <div class="container">
    <div class="cap-head" data-reveal>
      <div class="section-label">How it works</div>
      <h2 class="display cap-h2">
        The compiler,
        <span class="dim">in practice.</span>
      </h2>
    </div>

    <div class="cap-list">
      {blocks.map((block, i) => (
        <div class={`cap-block ${i % 2 === 1 ? 'cap-flip' : ''}`} data-reveal>
          <div class="cap-text">
            <span class="cap-number">{block.number}</span>
            <h3 class="cap-title">{block.title}</h3>
            <p class="cap-desc">{block.desc}</p>
          </div>
          <div class="code-window cap-window">
            <div class="code-window-bar">
              <div class="window-dots"><span></span><span></span><span></span></div>
              <span class="code-window-title">{block.filename}</span>
            </div>
            <pre class="cap-code"><code>{block.code}</code></pre>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cap-section {
    padding: clamp(5rem, 12vh, 9rem) 0;
    border-top: 1px solid var(--border);
    position: relative;
  }

  .cap-head {
    margin-bottom: clamp(3rem, 7vh, 5rem);
  }
  .cap-h2 {
    font-size: clamp(1.9rem, 4vw, 3rem);
    max-width: 540px;
  }
  .cap-h2 .dim { display: block; font-weight: 500; }

  .cap-list {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 8vh, 6rem);
  }

  .cap-block {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .cap-block.cap-flip .cap-text { order: 2; }
  .cap-block.cap-flip .cap-window { order: 1; }

  .cap-text {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .cap-number {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--accent);
    user-select: none;
  }

  .cap-title {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--text);
    margin: 0;
    line-height: 1.2;
  }

  .cap-desc {
    font-size: 0.95rem;
    color: var(--text-2);
    line-height: 1.7;
    margin: 0;
    max-width: 420px;
  }

  .cap-window { min-width: 0; }

  .cap-code {
    margin: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    font-size: 0.82rem;
    line-height: 1.75;
    color: var(--text-2);
    padding: 1.3rem 1.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    white-space: pre;
  }

  @media (max-width: 820px) {
    .cap-block {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      align-items: start;
    }
    .cap-block.cap-flip .cap-text { order: 1; }
    .cap-block.cap-flip .cap-window { order: 2; }
  }
</style>
