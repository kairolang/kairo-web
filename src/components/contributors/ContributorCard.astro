---
/**
 * One contributor as an ASCII frame:
 *
 *   ┌─[ @login ]────────────< #01 >─┐
 *   │   <24×11 ascii avatar>        │
 *   │   1,234 commits               │
 *   │   repos: kairo, kairo-lsp     │
 *   └───────────────────────────────┘
 *
 * The ASCII avatar is converted at build time (src/lib/contributors.ts).
 * Hover / focus: one 180ms glitch burst on the art, then the real photo
 * prints in over it top→bottom (stepped clip-path). Reduced motion: instant.
 */
import { avatarAscii, avatarPhoto, type Contributor } from '../../lib/contributors';

interface Props {
  contributor: Contributor;
  rank: number;
}

const { contributor: c, rank } = Astro.props;
const art = await avatarAscii(c);
const fmt = new Intl.NumberFormat('en-US');
const unit = c.contributions === 1 ? 'commit' : 'commits';
const rankLabel = `#${String(rank).padStart(2, '0')}`;
---
<a
  class="ascii-frame ascii-frame--fill ascii-frame--hover c-card"
  href={c.html_url}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="ascii-frame-title">@{c.login}</span>
  <span class="ascii-frame-meta" aria-hidden="true">{rankLabel}</span>

  <span class="c-avatar" aria-hidden="true">
    <span class="c-art-wrap">
      <pre class="ascii-art c-art c-art--dark" set:html={art.dark} />
      <pre class="ascii-art c-art c-art--light" set:html={art.light} />
    </span>
    <img
      class="c-photo"
      src={avatarPhoto(c, 160)}
      alt=""
      width="160"
      height="160"
      loading="lazy"
      decoding="async"
    />
  </span>

  <span class="c-meta">
    <span class="c-row"><span class="c-gl" aria-hidden="true">│</span><strong class="c-count tabular">{fmt.format(c.contributions)}</strong> {unit}</span>
    <span class="c-row c-repos"><span class="c-gl" aria-hidden="true">│</span><span class="c-key">repos:</span> {c.repos.map((r) => r.name).join(', ')}</span>
    <span class="c-row c-open"><span class="c-gl" aria-hidden="true">└─</span>github.com/{c.login} <span aria-hidden="true">↗</span><span class="sr-only">(opens GitHub profile in a new tab)</span></span>
  </span>
</a>

<style>
  .c-card {
    --frame-pad: 1.6rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    color: var(--text-2);
    text-decoration: none;
  }

  /* keep the @login notch clear of the < #NN > meta notch when the card is narrow */
  .c-card > .ascii-frame-title { max-width: calc(100% - 9rem); }

  /* ── avatar: ASCII by default, photo prints in on hover/focus ── */
  .c-avatar {
    position: relative;
    display: block;
    align-self: flex-start;
    /* 24 cols × 0.6em by 11 rows × 1.3em at 9px ≈ 130 × 129 px */
    --art-size: 9px;
    width: calc(24 * 0.6 * var(--art-size));
    height: calc(11 * 1.3 * var(--art-size));
    background-color: var(--bg);
    outline: 1px solid var(--frame-line);
    outline-offset: 4px;
    overflow: hidden;
  }
  .c-art-wrap { display: block; }
  .c-art {
    font-size: var(--art-size);
    line-height: 1.3;
    color: var(--red);
  }
  .c-art :global(.d) { color: color-mix(in srgb, var(--red) 48%, var(--bg)); }
  .c-art--light { display: none; }
  :global([data-theme='light']) .c-art--light { display: block; }
  :global([data-theme='light']) .c-art--dark { display: none; }

  .c-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    border-radius: 0;
    clip-path: inset(0 0 100% 0);
    transition: clip-path var(--dur-slow, 350ms) steps(7, end);
  }

  .c-card:hover .c-photo,
  .c-card:focus-visible .c-photo {
    clip-path: inset(0 0 0 0);
  }
  .c-card:hover .c-art-wrap,
  .c-card:focus-visible .c-art-wrap {
    animation: glitch 180ms steps(2, end) 1;
  }

  /* ── stats ── */
  .c-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.78rem;
    line-height: 1.55;
    min-width: 0;
  }
  .c-row { display: block; overflow-wrap: anywhere; }
  .c-gl { color: var(--text-3); margin-right: 0.6ch; }
  .c-count { color: var(--text); font-weight: 700; font-size: 0.95rem; }
  .c-key { color: var(--text-2); }
  .c-repos { color: var(--text-2); }
  .c-open { color: var(--accent); margin-top: 0.35rem; }
  .c-card:hover .c-open,
  .c-card:focus-visible .c-open { color: var(--text); }

  @media (prefers-reduced-motion: reduce) {
    .c-photo { transition: none; }
    .c-card:hover .c-art-wrap,
    .c-card:focus-visible .c-art-wrap { animation: none; }
  }
</style>
