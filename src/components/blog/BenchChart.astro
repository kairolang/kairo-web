---
/**
 * Horizontal bar chart for one benchmark: one row per compiler, sorted
 * fastest first, bar = median wall time, tick = fastest run.
 *
 *   <BenchChart name="nbody" n="30000000" baseline="gcc" rows={[
 *     { label: 'kairo', median: 1.266, min: 1.255 }, ...
 *   ]} />
 *
 * Kairo's row is drawn in brand red, every other toolchain in neutral gray,
 * so the chart reads "where does Kairo land" at a glance. Identity never
 * rides on colour alone: every row is labelled with its toolchain name.
 */
interface Row { label: string; median: number; min: number }
interface Props {
  name: string;
  n: string;
  rows: Row[];
  /** label of the row the "× vs" column compares against */
  baseline?: string;
  /** the row drawn as the highlighted series */
  highlight?: string;
  caption?: string;
}

const { name, n, rows, baseline = 'gcc', highlight = 'kairo', caption } = Astro.props;
const sorted = [...rows].sort((a, b) => a.median - b.median);
const base = rows.find(r => r.label === baseline)?.median ?? sorted[0].median;

// Clean axis with at most 6 labels (fits a phone-width track). Headroom of
// 20% keeps the value label at the longest bar's end inside the track.
const top = Math.max(...rows.map(r => r.median)) * 1.2;
const step = [0.5, 1, 2, 5, 10].find(s => Math.ceil(top / s) <= 5) ?? 10;
const max = Math.ceil(top / step) * step;
const ticks = Array.from({ length: Math.round(max / step) + 1 }, (_, i) => +(i * step).toFixed(2));
const pct = (v: number) => `${(v / max) * 100}%`;
const fmtX = (v: number) => `${v.toFixed(2)}×`;
---
<figure class="bench" aria-labelledby={`bench-${name}-t`}>
  <figcaption class="bench-head">
    <span class="bench-title" id={`bench-${name}-t`}>{name}</span>
    <span class="bench-n">N = {Number(n).toLocaleString('en-US')}</span>
    <span class="bench-unit">median seconds · lower is faster</span>
  </figcaption>

  <ol class="bench-rows">
    {sorted.map((r, i) => {
      const ratio = base / r.median;
      return (
        <li
          class:list={['bench-row', { 'is-hl': r.label === highlight, 'is-first': i === 0 }]}
          tabindex="0"
          aria-label={`${r.label}: median ${r.median.toFixed(3)} seconds, fastest run ${r.min.toFixed(3)} seconds, ${fmtX(ratio)} the speed of ${baseline}`}
        >
          <span class="bench-label">{r.label}</span>
          <span class="bench-track" style={`--ticks:${ticks.length - 1}`}>
            <span class="bench-bar" style={`width:${pct(r.median)}`}></span>
            <span class="bench-min" style={`left:${pct(r.min)}`} aria-hidden="true"></span>
            <span class="bench-val" style={`left:${pct(r.median)}`}>{r.median.toFixed(3)}s</span>
            <span class="bench-tip" role="tooltip" aria-hidden="true">
              <b>{r.label}</b>
              <span>median <em>{r.median.toFixed(3)}s</em></span>
              <span>fastest <em>{r.min.toFixed(3)}s</em></span>
              <span>vs {baseline} <em>{r.label === baseline ? '—' : fmtX(ratio)}</em></span>
            </span>
          </span>
          <span class="bench-ratio">{r.label === baseline ? 'base' : fmtX(ratio)}</span>
        </li>
      );
    })}
  </ol>

  <div class="bench-axis" aria-hidden="true">
    <span class="bench-label"></span>
    <span class="bench-ticks">
      {ticks.map(t => <span class="bench-tick" style={`left:${pct(t)}`}>{t}s</span>)}
    </span>
    <span class="bench-ratio">vs {baseline}</span>
  </div>

  {caption && <p class="bench-note">{caption}</p>}
</figure>

<style>
  .bench {
    --bench-hl: var(--red);
    --bench-mute: color-mix(in srgb, var(--text-2) 55%, var(--bg-2));
    --bench-grid: var(--border);
    margin: 2rem 0;
    padding: 1.1rem 1.25rem 0.9rem;
    border: 1px solid var(--border-hi);
    background: var(--bg-2);
    font-family: var(--font-mono);
  }
  .bench-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
    margin-bottom: 1rem;
  }
  .bench-title { color: var(--text); font-weight: 600; font-size: 0.95rem; }
  .bench-n { color: var(--text-2); font-size: 0.78rem; }
  .bench-unit { color: var(--text-2); font-size: 0.72rem; margin-left: auto; }

  .bench-rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .bench-row, .bench-axis {
    display: grid;
    grid-template-columns: 3.75rem 1fr 3.4rem;
    align-items: center;
    gap: 0.75rem;
  }
  .bench-row { padding: 0.32rem 0; margin: 0; outline: none; }
  .bench-row::marker { content: none; }
  .bench-label { color: var(--text-2); font-size: 0.8rem; text-align: right; }
  .bench-row.is-hl .bench-label { color: var(--text); font-weight: 600; }

  .bench-track {
    position: relative;
    height: 22px;
    /* gridlines at every axis tick, drawn by the track itself */
    background-image: linear-gradient(to right, var(--bench-grid) 1px, transparent 1px);
    background-size: calc(100% / var(--ticks, 1)) 100%;
  }
  .bench-bar {
    position: absolute; inset: 0 auto 0 0;
    background: var(--bench-mute);
    transition: filter var(--dur-fast) var(--ease);
  }
  .bench-row.is-hl .bench-bar { background: var(--bench-hl); }
  .bench-row:hover .bench-bar,
  .bench-row:focus-visible .bench-bar { filter: brightness(1.18); }
  .bench-row:focus-visible .bench-track { outline: 1px solid var(--accent); outline-offset: 3px; }

  /* fastest-run tick: a thin marker where the best of the runs landed */
  .bench-min {
    position: absolute; top: -3px; bottom: -3px; width: 2px;
    margin-left: -1px;
    background: var(--text);
    opacity: 0.55;
  }
  .bench-val {
    position: absolute; top: 50%;
    transform: translate(0.5rem, -50%);
    color: var(--text-2); font-size: 0.74rem; white-space: nowrap;
  }
  .bench-row.is-hl .bench-val { color: var(--text); }

  .bench-ratio { color: var(--text-2); font-size: 0.78rem; text-align: right; font-variant-numeric: tabular-nums; }
  .bench-row.is-hl .bench-ratio { color: var(--text); font-weight: 600; }

  .bench-tip {
    position: absolute; z-index: 5; bottom: calc(100% + 8px); left: 0;
    display: grid; gap: 2px; min-width: 11rem;
    padding: 0.5rem 0.65rem;
    background: var(--bg-3); border: 1px solid var(--border-hi);
    color: var(--text-2); font-size: 0.72rem;
    pointer-events: none; opacity: 0; transform: translateY(4px);
    transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .bench-tip b { color: var(--text); font-weight: 600; margin-bottom: 2px; }
  .bench-tip span { display: flex; justify-content: space-between; gap: 1rem; }
  .bench-tip em { font-style: normal; color: var(--text); font-variant-numeric: tabular-nums; }
  .bench-row:hover .bench-tip,
  .bench-row:focus-visible .bench-tip { opacity: 1; transform: none; }

  .bench-axis { margin-top: 0.35rem; }
  .bench-ticks { position: relative; height: 1rem; border-top: 1px solid var(--border-hi); }
  .bench-tick {
    position: absolute; top: 0.2rem; transform: translateX(-50%);
    color: var(--text-2); font-size: 0.68rem; white-space: nowrap;
  }
  .bench-tick:first-child { transform: none; }
  .bench-tick:last-child { transform: translateX(-100%); }
  .bench-axis .bench-ratio { font-size: 0.68rem; }

  .bench-note { margin: 0.9rem 0 0; color: var(--text-2); font-family: var(--font-sans); font-size: 0.85rem; line-height: 1.55; }

  @media (max-width: 560px) {
    .bench { padding: 0.9rem 0.8rem 0.75rem; }
    .bench-row, .bench-axis { grid-template-columns: 3rem 1fr 2.9rem; gap: 0.5rem; }
    .bench-unit { margin-left: 0; width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bench-bar, .bench-tip { transition: none; }
  }
</style>
