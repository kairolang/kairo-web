---
import AsciiArt from './ascii/AsciiArt.astro';

const languageLinks = [
  { href: '/docs/', label: 'Documentation' },
  { href: '/docs/install/', label: 'Installation' },
  { href: '/docs/status/', label: 'Status' },
  { href: '/llms.txt', label: 'LLM Context', hidden: true },
  { href: '/llms-full.txt', label: 'LLM Full Docs', hidden: true },
  { href: '/blog/', label: 'Blog' },
  { href: 'https://github.com/kairolang/kairo/releases', label: 'Changelog', external: true },
];

const helpLinks = [
  { href: 'https://github.com/kairolang/kairo/discussions', label: 'Get help', external: true },
  { href: 'https://discord.gg/VHCnPccDc', label: 'Discord', external: true },
  { href: 'https://github.com/kairolang/kairo/issues/new/choose', label: 'Report an issue', external: true },
  { href: 'https://github.com/kairolang/kairo/blob/main/CONTRIBUTING.md', label: 'Contributing', external: true },
];

const communityLinks = [
  { href: 'https://github.com/kairolang/kairo', label: 'GitHub', external: true },
  { href: 'https://www.linkedin.com/company/kairo-software-foundation', label: 'LinkedIn', external: true },
  { href: '/contributors/', label: 'Contributors' },
  { href: '/ksf/', label: 'KSF' },
];

const columns = [
  { title: '~/language', label: 'Language', links: languageLinks },
  { title: '~/help', label: 'Help', links: helpLinks },
  { title: '~/community', label: 'Community', links: communityLinks },
];

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <!-- Giant ASCII wordmark (decorative) -->
    <a href="/" class="footer-wordmark-link" aria-label="Kairo home">
      <AsciiArt text="KAIRO" max={34} class="footer-wordmark" />
    </a>

    <div class="footer-grid">
      <!-- Column 1: tagline as terminal output -->
      <div class="footer-brand">
        <p class="footer-cmd"><span class="prompt">kairo --version</span></p>
        <p class="footer-out">kairo 0.1.0-alpha <span class="dim">(stage0, c++)</span></p>
        <p class="footer-tagline">
          The Language Beyond C++<br>
          Compiled systems language. Two-way C++ interop.
        </p>
      </div>

      <!-- Columns 2-4: link trees -->
      {columns.map(col => (
        <nav aria-label={col.label}>
          <p class="footer-col-title">{col.title}</p>
          <ul class="ascii-tree footer-links">
            {col.links.map(link => (
              <li class={link.hidden ? 'sr-only' : undefined}>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class={link.hidden ? 'sr-only-link' : 'footer-link'}
                  tabindex={link.hidden ? -1 : undefined}
                >
                  {link.label}
                  {link.external && !link.hidden && <span class="footer-ext" aria-hidden="true" data-scramble-skip>↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <!-- Bottom status line -->
    <div class="footer-bottom">
      <p class="footer-legal">
        &copy; {year} Dhruvan Kartik. Open source under the
        <a
          href="/LICENSE.txt"
          target="_blank"
          rel="noopener noreferrer"
        >Apache 2.0 License (with Runtime Exception)</a>.
      </p>
      <p class="footer-version">
        <span>v0.1.0-alpha</span>
        <span class="footer-sep" aria-hidden="true">│</span>
        <span><span class="dim">exit</span> 0</span><span class="blink-cursor-glyph" aria-hidden="true">█</span>
      </p>
    </div>
  </div>
</footer>

<style>
  /* Keep the root as <footer class="site-footer"> directly under <body>:
     the docs footer gate selects `body > footer.site-footer`.
     position: relative anchors the absolutely positioned .sr-only items
     inside the footer's own box. */
  .site-footer {
    position: relative;
    border-top: 1px solid var(--border);
    padding: 3.5rem 0 2rem;
    margin-top: auto;
    background: var(--bg);
    font-family: var(--font-mono);
  }

  .footer-wordmark-link {
    display: block;
    text-decoration: none;
    margin-bottom: 3rem;
  }
  .footer-wordmark-link :global(.footer-wordmark) {
    --art-shadow: color-mix(in srgb, var(--red) 30%, var(--bg));
  }
  /* one ≤200ms burst on hover/focus only (RESTRAINT) */
  .footer-wordmark-link:hover :global(.ascii-art),
  .footer-wordmark-link:focus-visible :global(.ascii-art) { animation: glitch 180ms steps(2, end) 1; }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px dashed var(--border-hi);
  }

  .footer-cmd, .footer-out {
    font-size: 0.8rem;
    line-height: 1.7;
  }
  .footer-cmd { color: var(--text); }
  .footer-out { color: var(--text-2); margin-bottom: 1rem; }

  .footer-tagline {
    font-size: 0.8rem;
    color: var(--text-2);
    line-height: 1.7;
    max-width: 340px;
  }

  .footer-col-title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
    /* reads like `tree` output: the root sits directly on the first ├── */
    line-height: 1.3;
    margin-bottom: 0;
  }

  /* A true monospace block: rows touch (no gap), and every row is exactly
     one 1.3em line (the height of Geist Mono's box-drawing glyphs), so
     the ├/└ verticals join into one continuous line. */
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0;
    font-size: 0.82rem;
    line-height: 1.3;
    /* whole-pixel rows, rounded DOWN so the glyphs overlap by a hair:
       fractional rows (17.056px) leave a faint anti-aliased seam where one
       ├ meets the next, and rounding up leaves a visible gap */
    line-height: round(down, 1.3em, 1px);
  }
  .footer-links > li::before { line-height: inherit; top: 0; }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    /* pinned to the row height and top-aligned so neither the hover padding
       nor the ↗ glyph can grow the line box */
    height: 1.3em;
    height: 1lh;
    vertical-align: top;
    color: var(--text-2);
    text-decoration: none;
    padding: 0 0.3ch;
    margin: 0 -0.3ch;
    width: fit-content;
  }
  .footer-ext { line-height: 1; }
  .footer-link:hover { background: var(--text); color: var(--bg); }
  .footer-ext { color: var(--text-3); }
  .footer-link:hover .footer-ext { color: inherit; }

  .sr-only-link {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-legal {
    font-size: 0.72rem;
    color: var(--text-2);
    line-height: 1.6;
  }
  .footer-legal a {
    color: var(--text-2);
    text-decoration: underline;
    text-decoration-color: var(--border-hi);
    text-underline-offset: 3px;
  }
  .footer-legal a:hover { color: var(--accent); text-decoration-color: var(--accent); }

  .footer-version {
    display: flex;
    align-items: center;
    gap: 1ch;
    font-size: 0.72rem;
    color: var(--text-2);
    letter-spacing: 0.04em;
  }
  .footer-sep { color: var(--text-3); }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
    .footer-brand { grid-column: 1 / -1; }
    .footer-wordmark-link { margin-bottom: 2rem; }
  }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 420px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
