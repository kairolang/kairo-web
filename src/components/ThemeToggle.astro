---
// Terminal theme switch: "[● dark]" ⇄ "[○ lite]" (same width, no layout shift). Same storage contract as
// before: localStorage 'theme' = 'light' | 'dark'; data-theme="light" on <html>.
---
<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Switch to light theme"
  title="Toggle dark/light mode"
>
  <span class="tt-glyph" aria-hidden="true">●</span><span class="tt-label" aria-hidden="true">dark</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    line-height: 1;
    color: var(--text-2);
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 6px 2px;
    cursor: pointer;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .theme-toggle::before { content: '['; color: var(--text-3); }
  .theme-toggle::after  { content: ']'; color: var(--text-3); }
  .tt-glyph { color: var(--red); display: inline-block; }
  .tt-label { display: inline-block; }
  .theme-toggle:hover { color: var(--accent); }
  .theme-toggle:hover::before,
  .theme-toggle:hover::after { color: var(--accent); }
  .theme-toggle.flip .tt-glyph { animation: ttFlip 160ms steps(4, end); }
  @keyframes ttFlip {
    0%   { transform: scaleX(1); }
    50%  { transform: scaleX(0); }
    100% { transform: scaleX(1); }
  }
  @media (max-width: 1040px) {
    .tt-label { display: none; }
  }
</style>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.init) return;
    btn.dataset.init = '1';
    const glyph = btn.querySelector<HTMLElement>('.tt-glyph');
    const label = btn.querySelector<HTMLElement>('.tt-label');
    const html = document.documentElement;

    function render() {
      const isLight = html.getAttribute('data-theme') === 'light';
      if (glyph) glyph.textContent = isLight ? '○' : '●';
      if (label) label.textContent = isLight ? 'lite' : 'dark';
      btn!.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
    }

    render();
    // the theme can also change under us (re-read when a prerendered or
    // back/forward-cached page is shown, see BaseLayout): keep the label true
    new MutationObserver(render).observe(html, { attributes: true, attributeFilter: ['data-theme'] });

    btn.addEventListener('click', () => {
      const isLight = html.getAttribute('data-theme') === 'light';
      try {
        if (isLight) {
          html.removeAttribute('data-theme');
          localStorage.setItem('theme', 'dark');
        } else {
          html.setAttribute('data-theme', 'light');
          localStorage.setItem('theme', 'light');
        }
      } catch (_) {
        if (isLight) html.removeAttribute('data-theme'); else html.setAttribute('data-theme', 'light');
      }
      try { const bc = new BroadcastChannel('kairo-theme'); bc.postMessage(1); bc.close(); } catch (_) {}
      render();
      btn.classList.remove('flip');
      void btn.offsetWidth;
      btn.classList.add('flip');
    });
  }

  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
