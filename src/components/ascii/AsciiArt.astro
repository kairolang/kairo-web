---
/**
 * Decorative ASCII art block that always fits its container (aria-hidden).
 *
 *   <AsciiArt text="KAIRO" max={40} />                 FIGlet word, auto-fit to width
 *   <AsciiArt art={myMultilineString} max={14} tone="solid" />
 *   <AsciiArt text="CONTRIBUTORS" narrowText={'CONTRI\nBUTORS'} />  swaps art under 520px container width
 *
 * Fit math: font-size = min(max, containerWidth / (cols * 0.612)), via
 * container query units on the .ascii-fit wrapper. No JS, no overflow.
 *
 * Lens (default on, lib/ascii/lens.ts): the art loads in as dim shade glyphs
 * (░▒, deterministic per cell) and a rectangular lens (full art height, ~8-14
 * columns) sweeps across it once when it first scrolls into view, resolving
 * each column to the final glyphs. On fine pointers the rect lens then
 * follows the cursor, showing the glyphs inside it as dense shades (▓▒░).
 * lens="reveal" (sweep only), lens="hover" (no sweep), lens={false} (static).
 * Calm pages (docs/blog) skip the sweep unless lensCalm is set (a calm page's
 * one title moment); reduced motion always skips it.
 */
import { renderFiglet, artSize, toneArt } from '../../lib/ascii/figlet';

interface Props {
  /** FIGlet text (ANSI Shadow block font) */
  text?: string;
  /** OR raw art (multiline string) */
  art?: string;
  /** alternative FIGlet text / art used when the container is < 520px wide */
  narrowText?: string;
  narrowArt?: string;
  /** max font size in px (default 40) */
  max?: number;
  /** 'two-tone' (default for FIGlet: bright faces, dim shadow) | 'solid' */
  tone?: 'two-tone' | 'solid';
  /** art colour (CSS colour), default var(--red) */
  color?: string;
  align?: 'left' | 'center' | 'right';
  class?: string;
  /** element for the fit wrapper. Use 'span' inside headings/phrasing content. */
  as?: 'div' | 'span';
  /** rect lens: true = shade-in sweep + hover lens (default) | 'reveal' | 'hover' | false */
  lens?: boolean | 'reveal' | 'hover';
  /** sweep delay / duration in ms (duration clamped 700-1100) */
  lensDelay?: number;
  lensDuration?: number;
  /** play the sweep on calm pages too (default false) */
  lensCalm?: boolean;
}

const { text, art, narrowText, narrowArt, max = 40, tone, color, align = 'left', class: cls, as = 'div', lens = true, lensDelay, lensDuration, lensCalm = false } = Astro.props;
const lensAttr = lens === false ? undefined : lens === true ? '' : lens;
const wide = art ?? (text !== undefined ? renderFiglet(text) : '');
const narrow = narrowArt ?? (narrowText !== undefined ? renderFiglet(narrowText) : undefined);
const t = tone ?? (art !== undefined ? 'solid' : 'two-tone');
const html = (s: string) => (t === 'two-tone' ? toneArt(s) : s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'));
const W = as;
const sz = (s: string) => artSize(s).cols;
const wrapStyle = `--art-max:${max}px;${color ? `--art-color:${color};--art-face:${color};` : ''}`;
const margin = align === 'center' ? 'margin-inline:auto;' : align === 'right' ? 'margin-left:auto;' : '';
---
<W class:list={['ascii-fit', cls]} style={wrapStyle} aria-hidden="true" data-lens={lensAttr} data-lens-delay={lensAttr !== undefined ? lensDelay : undefined} data-lens-duration={lensAttr !== undefined ? lensDuration : undefined} data-lens-calm={lensAttr !== undefined && lensCalm ? '' : undefined}>
  <span class:list={['ascii-art', narrow && 'ascii-art--wide']} style={`--cols:${sz(wide)};width:max-content;${margin}`} set:html={html(wide)} />
  {narrow && <span class="ascii-art ascii-art--narrow" style={`--cols:${sz(narrow)};width:max-content;${margin}`} set:html={html(narrow)} />}
</W>

<style is:global>
  /* Lens pre-state: hidden from first paint until lens.ts has swapped in the
     shaded (░▒) first state, so the final art never flashes before the sweep.
     Failsafe: the final art shows after 1.5s if the script never runs. */
  html.js:not([data-motion="calm"]) [data-lens]:not([data-lens="off"]):not([data-lens="hover"]):not([data-lens-ready]) .ascii-art,
  html.js [data-lens][data-lens-calm]:not([data-lens="off"]):not([data-lens="hover"]):not([data-lens-ready]) .ascii-art {
    visibility: hidden;
    animation: lens-failsafe 0s linear 1.5s forwards;
  }
  @keyframes lens-failsafe { to { visibility: visible; } }
  @media (prefers-reduced-motion: reduce) {
    html.js [data-lens]:not([data-lens-ready]) .ascii-art { visibility: visible; animation: none; }
  }
</style>

<script>
  import { bindLens } from '../../lib/ascii/lens';
  bindLens();
  document.addEventListener('astro:page-load', () => bindLens());
</script>
