---
/**
 * Bracketed terminal button:  [ GET STARTED -> ]
 * Hover: stepped inverse fill sweep + label scramble (auto-bound globally).
 *
 *   <AsciiButton href="/docs/" label="Get started" />
 *   <AsciiButton href="https://github.com/kairolang/kairo" label="GitHub" variant="ghost" external />
 *   <AsciiButton label="Copy" icon="none" size="sm" data-copy="…" />   (no href renders a <button type="button">)
 */
interface Props {
  href?: string;
  label: string;
  variant?: 'primary' | 'ghost';
  external?: boolean;
  /** trailing glyph: arrow "->" (default), external "↗", or none */
  icon?: 'arrow' | 'external' | 'none';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: any;
}

const { href, label, variant = 'primary', external = false, icon, size = 'md', class: cls, ...rest } = Astro.props;
const glyph = (icon ?? (external ? 'external' : 'arrow'));
const g = glyph === 'arrow' ? '->' : glyph === 'external' ? '↗' : '';
const classes = ['ascii-btn', `ascii-btn--${variant}`, size !== 'md' && `ascii-btn--${size}`, cls];
---
{href ? (
  <a
    href={href}
    class:list={classes}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    {...rest}
  >
    <span class="ascii-btn-label">{label}</span>
    {g && <span class="ascii-btn-icon" aria-hidden="true" data-scramble-skip>{g}</span>}
  </a>
) : (
  <button type="button" class:list={classes} {...rest}>
    <span class="ascii-btn-label">{label}</span>
    {g && <span class="ascii-btn-icon" aria-hidden="true" data-scramble-skip>{g}</span>}
  </button>
)}
