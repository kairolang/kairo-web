---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Seo from '../components/Seo.astro';
import { absUrl, bareTitle, fitDescription, formatTitle, ogImageFor } from '../lib/seo';
import { lastmodFor } from '../lib/lastmod.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  /** Full document <title>, used verbatim instead of formatTitle(title). */
  documentTitle?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  /** Controls structured data output; defaults to 'page' */
  type?: 'home' | 'docs' | 'blog' | 'page';
  /** 'article' for blog posts */
  ogType?: 'website' | 'article';
  pubDate?: Date;
  modDate?: Date;
  author?: string;
  tags?: string[];
  breadcrumbs?: Array<{ name: string; url: string }>;
  noindex?: boolean;
  /** Override the page's main JSON-LD node (docs hubs: 'CollectionPage'). */
  schema?: 'CollectionPage';
}

const {
  title,
  documentTitle,
  description,
  ogImage,
  canonical,
  type = 'page',
  ogType = 'website',
  pubDate,
  modDate,
  author,
  tags = [],
  breadcrumbs = [],
  noindex = false,
  schema,
} = Astro.props;

// ── SEO: pages pass a short title; the document title, description, OG card,
// canonical and dateModified are derived here (conventions in lib/seo.ts).
const pathname = Astro.url.pathname;
let pageName = bareTitle(title);
if (type === 'docs') {
  // Overloaded API pages share a title ("Frame::Frame (Constructor)" x4):
  // disambiguate with the overload number from the URL so titles stay unique.
  const docs = await getCollection('docs');
  if (docs.filter(d => d.data.title === pageName).length > 1) {
    const seg = decodeURIComponent(pathname.replace(/\/+$/, '').split('/').pop() ?? '');
    const n = seg.match(/-(\d+)$/)?.[1];
    pageName = n ? `${pageName} #${n}` : `${pageName} (${seg})`;
  }
}
const fullTitle = documentTitle ?? formatTitle(pageName, type, pathname);
const metaDescription = fitDescription(description, pageName, type);
const canonicalURL = canonical ?? absUrl(pathname);
const ogImageURL = ogImage ?? ogImageFor(pathname, type);
const modified = modDate ?? lastmodFor(pathname);

// RESTRAINT: docs + blog posts are "calm" pages: no scroll reveals, decodes,
// typewriters, counters or fields (they resolve to their final state), no CRT
// texture, and a plain quick crossfade between pages. See DESIGN.md.
const calm = type === 'docs' || type === 'blog';
// Docs are excluded from the two "playful" page behaviours: section scroll
// detents (html[data-scroll-snap]) and drag-to-resize boxes (data-resize="off").
const isDocs = type === 'docs' || /^\/docs(\/|$)/.test(pathname);
---
<!DOCTYPE html>
<html
  lang="en"
  data-motion={calm ? 'calm' : undefined}
  data-scroll-snap={isDocs ? undefined : ''}
  data-resize={isDocs ? 'off' : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <Seo
      title={fullTitle}
      headline={pageName}
      description={metaDescription}
      canonicalURL={canonicalURL}
      ogImage={ogImageURL}
      ogType={ogType}
      type={type}
      pubDate={pubDate}
      modDate={modified}
      author={author}
      tags={tags}
      breadcrumbs={breadcrumbs}
      noindex={noindex}
      schema={schema}
    />

    <!-- Self-hosted variable fonts -->
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <title>{fullTitle}</title>

    <!-- Critical paint: correct background before the stylesheet arrives.
         Without this the browser may flash its default white (or unstyled
         dark) for a frame on navigation, depending on cache timing. -->
    <style is:inline>
      html { background-color: #08080a; color: #f5f5f7; color-scheme: dark; }
      html[data-theme="light"] { background-color: #fafafa; color: #1d1d1f; color-scheme: light; }
    </style>

    <!-- Theme detection - runs before render to avoid flash.
         Also flags JS (html.js) so reveal/scramble pre-states only apply
         when scripts run; a failsafe drops the flag if the ASCII runtime
         never boots (network error etc.) so content can't stay hidden. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        function theme() {
          try {
            const stored = localStorage.getItem('theme');
            if (stored === 'light') {
              d.setAttribute('data-theme', 'light');
            } else {
              d.removeAttribute('data-theme');
            }
          } catch (_) {}
        }
        theme();
        // A prerendered page (docs speculation rules) or a back/forward-cached
        // one still carries the theme it was loaded with: re-read it before
        // that page is first shown, or a toggle in between flashes the page.
        document.addEventListener('prerenderingchange', theme);
        addEventListener('pageshow', function (e) { if (e.persisted) theme(); });
        // ThemeToggle announces every change here. Open pages follow it; a
        // page frozen in the back/forward cache is evicted by the message
        // (Chromium), so Back reloads it in the right theme instead of
        // showing its stale frame for an instant.
        try { new BroadcastChannel('kairo-theme').onmessage = theme; } catch (_) {}
        // Arriving on page/#anchor (a search result, a cross-page link):
        // land on the anchor at once. The site-wide smooth scroll-behavior
        // would otherwise animate the browser's own fragment scroll from the
        // top of the new page. Smooth again once the page has loaded.
        if (location.hash) {
          d.style.scrollBehavior = 'auto';
          addEventListener('load', function () {
            requestAnimationFrame(function () { setTimeout(function () { d.style.scrollBehavior = ''; }, 0); });
          }, { once: true });
        }
        d.classList.add('js');
        setTimeout(function () { if (!window.__asciiReady) d.classList.remove('js'); }, 3500);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <Header />
    <slot />
    <Footer />
    {!calm && <div class="crt-overlay" aria-hidden="true"></div>}
    <script>
      // KAIRO // ASCII runtime: print-reveals, scramble, typewriter,
      // counters, glyph fields, scroll progress + ruler.
      // (The cursor glyph trail is OFF site-wide per the restraint rules;
      //  initCursorTrail() only runs on a <body data-trail> opt-in.)
      import { initAscii } from '../lib/ascii';
      import { initScrollProgress } from '../lib/ascii/chrome';
      import { bindResizable } from '../lib/ascii/resize';
      import { initDetent } from '../lib/ascii/detent';

      // drag grips on every ASCII box (no-op on docs). Deferred to idle so
      // it never competes with the entrance; components that bind their own
      // boxes (hero, showcase) have run by then and are left alone.
      function initResize() {
        const run = () => { try { bindResizable(); } catch { /* resizing is a bonus */ } };
        if ('requestIdleCallback' in window) requestIdleCallback(run, { timeout: 900 });
        else setTimeout(run, 300);
      }

      function initBase() {
        initAscii();
        initScrollProgress();
        initResize();
        initDetent(); // section detents (no-op on docs)
      }
      initBase();
      document.addEventListener('astro:page-load', initBase);
    </script>
  </body>
</html>
