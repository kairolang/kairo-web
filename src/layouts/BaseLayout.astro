---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  /** Controls structured data output; defaults to 'page' */
  type?: 'home' | 'docs' | 'blog' | 'page';
  /** 'article' for blog posts */
  ogType?: 'website' | 'article';
  pubDate?: Date;
  modDate?: Date;
  author?: string;
  tags?: string[];
  breadcrumbs?: Array<{ name: string; url: string }>;
  noindex?: boolean;
}

const {
  title,
  description = 'Kairo is a modern systems programming language. The Language Beyond C++.',
  ogImage = '/kairo-logo.svg',
  canonical,
  type = 'page',
  ogType = 'website',
  pubDate,
  modDate,
  author,
  tags = [],
  breadcrumbs = [],
  noindex = false,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <Seo
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      ogImage={ogImage}
      ogType={ogType}
      type={type}
      pubDate={pubDate}
      modDate={modDate}
      author={author}
      tags={tags}
      breadcrumbs={breadcrumbs}
      noindex={noindex}
    />

    <link rel="icon" href="/kairo-file-icon.svg" type="image/svg+xml" />

    <!-- Self-hosted variable fonts -->
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>

    <!-- Critical paint: correct background before the stylesheet arrives.
         Without this the browser may flash its default white (or unstyled
         dark) for a frame on navigation, depending on cache timing. -->
    <style is:inline>
      html { background-color: #08080a; color-scheme: dark; }
      html[data-theme="light"] { background-color: #fafafa; color-scheme: light; }
    </style>

    <!-- Theme detection - runs before render to avoid flash -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
          } else {
            document.documentElement.removeAttribute('data-theme');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <Header />
    <slot />
    <Footer />
    <script is:inline>
      // Cursor-following red glow on every button
      (function() {
        var SEL = 'button, [role="button"], .btn-primary, .btn-outline, [class*="-btn"], .sidebar-link, .toc-link, .docs-nav-card, .breadcrumb-link, .docs-footer-link, .nav-link';
        document.addEventListener('pointermove', function(e) {
          var el = e.target.closest && e.target.closest(SEL);
          if (!el) return;
          var r = el.getBoundingClientRect();
          el.style.setProperty('--glow-x', (e.clientX - r.left) + 'px');
          el.style.setProperty('--glow-y', (e.clientY - r.top) + 'px');
          el.classList.add('cursor-glow');
        }, { passive: true });
      })();
    </script>
    <script is:inline>
      // Scroll progress bar: scales 0 → 1 across the page scroll
      (function() {
        var bar = document.getElementById('scroll-progress');
        if (!bar) return;
        var ticking = false;
        function update() {
          var max = document.documentElement.scrollHeight - window.innerHeight;
          var p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          bar.style.transform = 'scaleX(' + p + ')';
          ticking = false;
        }
        function request() {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }
        window.addEventListener('scroll', request, { passive: true });
        window.addEventListener('resize', request);
        update();
      })();
    </script>
    <script is:inline>
      // Scroll reveal observer — handles single reveals and staggered groups
      (function() {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (!e.isIntersecting) return;
            var el = e.target;

            if (el.hasAttribute('data-reveal-stagger')) {
              var step = +(el.dataset.staggerStep || 70);
              Array.prototype.forEach.call(el.children, function(child, i) {
                child.style.setProperty('--reveal-delay', (i * step) + 'ms');
              });
            }

            var delay = el.dataset.revealDelay || 0;
            if (delay) el.style.setProperty('--reveal-delay', delay + 'ms');

            el.classList.add('revealed');
            observer.unobserve(el);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -48px 0px' });

        function scan() {
          if (reduced) {
            document.querySelectorAll('[data-reveal]:not(.revealed), [data-reveal-stagger]:not(.revealed)')
              .forEach(function(el) { el.classList.add('revealed'); });
            return;
          }
          document.querySelectorAll('[data-reveal]:not(.revealed), [data-reveal-stagger]:not(.revealed)')
            .forEach(function(el) { observer.observe(el); });
        }

        scan();
        document.addEventListener('astro:page-load', scan);
      })();
    </script>
  </body>
</html>
