---
/**
 * DOCS_FIELD — TRIAL: one slow, very dim ASCII noise field behind every docs
 * page, sidebar, reading column and TOC alike (same motion as the home
 * CTA/Stats bands, same red ramp as the KSF hero field). It is ONE
 * viewport-sized canvas (position: fixed, z-index -1, so it never scales
 * with page height), ~12fps on a wall clock
 * (continuous across docs navigations), paused while the tab is hidden, one
 * still frame under reduced motion, hidden in print.
 * Set to false to remove the whole trial: no markup is rendered and the
 * script below finds no #docs-field host and does nothing.
 */
const DOCS_FIELD = true;

import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';
import DocsSearch from '../components/docs/DocsSearch.astro';
import TableOfContents from '../components/docs/TableOfContents.astro';
import CodeBlockEnhancer from '../components/docs/CodeBlockEnhancer.astro';
import { docHref } from '../lib/docs-tree';
// Hub component styles ship as their own file, linked only on hub pages
// (imported by the components, they would land in the CSS chunk every
// docs page loads).
import hubCssUrl from '../components/docs/hub/hub.css?url';
interface Props {
  title: string;
  description?: string;
  prev?: { href: string; title: string } | null;
  next?: { href: string; title: string } | null;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  /** 'hub': landing page (no TOC column, no prev/next, wider main column). */
  template?: 'doc' | 'hub';
  /** Source file relative to src/content/docs, e.g. "language/index.mdx". */
  editPath?: string;
  /** Full document <title> override (frontmatter `seoTitle`). */
  seoTitle?: string;
}

const { title, description, prev, next, headings = [], template = 'doc', editPath, seoTitle } = Astro.props;
const currentPath = Astro.url.pathname;
const hub = template === 'hub';

const breadcrumbs = currentPath === '/docs/'
  ? [{ name: 'Home', url: '/' }, { name: 'Docs', url: '/docs/' }]
  : [{ name: 'Home', url: '/' }, { name: 'Docs', url: '/docs/' }, { name: title, url: currentPath }];

const EDIT_BASE = 'https://github.com/kairolang/kairo-web/edit/main/src/content/docs';

// Prefer an explicit editPath if a page/route passes one; otherwise derive
// from the URL. e.g. "/docs/language/ownership/" -> "language/ownership.mdx"
const derivedPath = currentPath
  .replace(/^\/docs\/?/, '')   // drop leading /docs/
  .replace(/\/$/, '');         // drop trailing slash
// (The URL guess is wrong for folder index pages and for the lowercased
// library ids, so the docs route always passes the real source path.)
const finalPath = editPath ?? (derivedPath ? `${derivedPath}.mdx` : 'index.mdx');
const editUrl   = `${EDIT_BASE}/${finalPath}`;

// Path breadcrumb: "~/docs/language/ownership". Intermediate directories
// only link when a page actually exists there (most dirs have no index).
const allDocs = await getCollection('docs');
const known = new Set(allDocs.map(d => docHref(d.id)));
const parts = currentPath.replace(/^\/+|\/+$/g, '').split('/').filter(Boolean);
const pathSegs = parts.map((name, i) => {
  const href = '/' + parts.slice(0, i + 1).join('/') + '/';
  const last = i === parts.length - 1;
  return { name: decodeURIComponent(name), href: !last && known.has(href) ? href : null, last };
});

const hasToc = !hub && headings.filter(h => h.depth === 2 || h.depth === 3).length > 0;
---
<BaseLayout
  title={`${title} - Kairo Docs`}
  documentTitle={seoTitle}
  description={description}
  type="docs"
  schema={hub ? 'CollectionPage' : undefined}
  breadcrumbs={breadcrumbs}
>
  <!-- Mobile top bar: [pages]  > Page title  [/] [toc] -->
  <div class="docs-mobile-bar" id="docs-mobile-bar">
    <button id="sidebar-toggle" class="docs-bar-btn" type="button" aria-label="Open docs navigation" aria-expanded="false" aria-controls="docs-sidebar-col">
      pages
    </button>
    <span class="docs-mobile-title">{title}</span>
    <button class="docs-bar-btn" type="button" aria-label="Search docs" data-search-open>/</button>
    {hasToc && (
      <button id="toc-toggle" class="docs-bar-btn" type="button" aria-label="On this page" aria-expanded="false" aria-controls="toc-drawer">
        toc
      </button>
    )}
  </div>

  <!-- Drawer backdrop (mobile) -->
  <div id="sidebar-backdrop" class="mobile-backdrop" aria-hidden="true"></div>

  <!-- DOCS_FIELD trial: fixed viewport-sized ASCII field behind the layout -->
  {DOCS_FIELD && <div id="docs-field" class="docs-field" aria-hidden="true"></div>}

  <!-- In the body, so it comes after the head's bundled CSS (hub.css
       overrides .ascii-frame details) and still blocks the hub's first paint. -->
  {hub && <link rel="stylesheet" href={hubCssUrl} />}

  <div class:list={['docs-layout', hub && 'docs-layout--hub']} data-resize-scope="off" data-snap="off">
    <!-- static dithered strip: the old red wash, as ░▒▓ halftone -->
    <div class="docs-dither" aria-hidden="true"></div>

    <!-- Left sidebar -->
    <aside class="docs-sidebar-col" id="docs-sidebar-col" aria-label="Docs navigation">
      <div class="docs-sidebar-inner">
        <!-- Close button (mobile drawer only) -->
        <div class="sidebar-drawer-bar">
          <span class="sidebar-drawer-name" aria-hidden="true">docs</span>
          <span class="sidebar-drawer-rule" aria-hidden="true"></span>
          <button id="sidebar-close" class="docs-bar-btn" type="button" aria-label="Close navigation">× close</button>
        </div>
        <DocsSearch />
        <DocsSidebar currentPath={currentPath} />
      </div>
    </aside>
    <!-- Restore sidebar scroll synchronously, before first paint, so the
         sidebar never visibly jumps when navigating between docs pages. -->
    <script is:inline>
      (function () {
        try {
          var col = document.getElementById('docs-sidebar-col');
          var saved = sessionStorage.getItem('docs-sidebar-scroll');
          if (col && saved !== null) col.scrollTop = parseInt(saved, 10);
        } catch (_) {}
      })();
    </script>

    <!-- Center: main content -->
    <main id="main" class="docs-content">
      <!-- Breadcrumb: ~/docs/language/ownership -->
      <nav class="docs-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/" class="breadcrumb-link" aria-label="Home">~</a></li>
          {pathSegs.map(seg => (
            <li>
              <span class="breadcrumb-sep" aria-hidden="true">/</span>
              {seg.last
                ? <span class="breadcrumb-current" aria-current="page">{seg.name}</span>
                : seg.href
                  ? <a href={seg.href} class="breadcrumb-link">{seg.name}</a>
                  : <span class="breadcrumb-dir">{seg.name}</span>}
            </li>
          ))}
        </ol>
      </nav>

      <!-- Article (hub pages lay out their own blocks: no prose measure) -->
      <article class={hub ? 'docs-hub' : 'prose'}>
        <slot />
      </article>

      <!-- Prev / Next: [← prev] / [next →] frames -->
      {(prev || next) && (
        <nav class="docs-nav-grid" aria-label="Page navigation">
          <div>
            {prev && (
              <a href={prev.href} class="ascii-frame docs-nav-card" rel="prev">
                <span class="nav-card-label"><span aria-hidden="true">← </span>prev</span>
                <span class="nav-card-title">{prev.title}</span>
              </a>
            )}
          </div>
          <div>
            {next && (
              <a href={next.href} class="ascii-frame docs-nav-card nav-card-next" rel="next">
                <span class="nav-card-label">next<span aria-hidden="true"> →</span></span>
                <span class="nav-card-title">{next.title}</span>
              </a>
            )}
          </div>
        </nav>
      )}

      <footer class="docs-footer">
        <div class="ascii-rule docs-eof" aria-hidden="true">EOF</div>
        <div class="docs-footer-links">
          <a href="https://github.com/kairolang/kairo/issues" target="_blank" rel="noopener noreferrer" class="docs-footer-link">
            report an issue<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a href={editUrl} target="_blank" rel="noopener noreferrer" class="docs-footer-link">
            edit this page<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </footer>
    </main>

    <!-- Right: TOC (not on hub pages) -->
    {!hub && (
      <aside class="docs-toc-col" aria-label="Table of contents">
        <div class="docs-toc-inner">
          <TableOfContents headings={headings} id="toc" />
        </div>
      </aside>
    )}
  </div>

  <!-- Mobile TOC drawer -->
  {hasToc && (
    <div id="toc-drawer" class="toc-drawer" aria-hidden="true">
      <div class="toc-drawer-bar">
        <span class="sidebar-drawer-name" aria-hidden="true">toc</span>
        <span class="sidebar-drawer-rule" aria-hidden="true"></span>
        <button id="toc-close" class="docs-bar-btn" type="button" aria-label="Close table of contents">× close</button>
      </div>
      <TableOfContents headings={headings} id="toc-mobile" />
    </div>
  )}

  <!-- Footer gate, armed during parse (before the site footer exists) so a
       #hash load can never overshoot into the footer, and nothing paints
       twice. Long pages only: on a fresh navigation the document ends at the
       docs content until a second, deliberate scroll (see initDocsScroll).
       Reload / back-forward keep the browser's own scroll restoration. -->
  <script is:inline>
    (function () {
      try {
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        if (nav && (nav.type === 'reload' || nav.type === 'back_forward')) return;
        var m = document.querySelector('main.docs-content');
        if (m && m.getBoundingClientRect().bottom + window.scrollY - window.innerHeight > 8) {
          document.documentElement.classList.add('docs-gated');
        }
      } catch (_) {}
    })();
  </script>

  <CodeBlockEnhancer />
</BaseLayout>

<style>
  /* header is 52px + 1px rule (Header.astro) */
  .docs-mobile-bar,
  .docs-layout { --docs-top: 53px; }

  /* ── DOCS_FIELD trial: one fixed, viewport-sized field behind everything.
     z-index -1 in the root stacking context: above the canvas background
     (body's --bg propagates there), below all in-flow content. The header,
     footer, mobile bar and drawers keep their own solid backgrounds; the
     sidebar, reading column and TOC are transparent, so it shows under all
     three. Same red ramp as the KSF hero field. A soft blur sits over it
     (--docs-field-blur): the glyphs read as a haze behind the text instead
     of competing with it. ── */
  :global(:root) { --docs-field-blur: 2px; }
  .docs-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    contain: strict;
    opacity: 0;
    transition: opacity 900ms linear;
  }
  .docs-field.is-on { opacity: 0.17; }
  /* arriving from another docs page: the field was already on screen, so it
     is shown at once (no 900ms re-fade on every docs click) */
  .docs-field.no-fade { transition: none; }
  :global([data-theme="light"]) .docs-field.is-on { opacity: 0.13; }
  @media (prefers-reduced-motion: reduce) { .docs-field { transition: none; } }
  @media print { .docs-field { display: none; } }
  .docs-field :global(canvas) { filter: blur(var(--docs-field-blur)); }

  /* ── "[menu]" style buttons (mobile bar + drawers) ── */
  .docs-bar-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: 0;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    padding: 4px 4px;
    cursor: pointer;
    white-space: nowrap;
  }
  .docs-bar-btn::before { content: '['; content: '[' / ''; color: var(--text-3); }
  .docs-bar-btn::after  { content: ']'; content: ']' / ''; color: var(--text-3); }
  .docs-bar-btn:hover,
  .docs-bar-btn:focus-visible,
  .docs-bar-btn[aria-expanded="true"] { background: var(--text); color: var(--bg); }
  .docs-bar-btn:hover::before,
  .docs-bar-btn:hover::after,
  .docs-bar-btn:focus-visible::before,
  .docs-bar-btn:focus-visible::after,
  .docs-bar-btn[aria-expanded="true"]::before,
  .docs-bar-btn[aria-expanded="true"]::after { color: inherit; }

  /* ── Mobile top bar ── */
  .docs-mobile-bar {
    display: none;
    align-items: center;
    gap: 0.75ch;
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: var(--docs-top);
    z-index: 40;
    font-family: var(--font-mono);
  }
  .docs-mobile-title {
    flex: 1;
    min-width: 0;
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--text-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0 0.5ch;
  }
  .docs-mobile-title::before { content: '> '; content: '> ' / ''; color: var(--accent); }

  /* ── Mobile backdrop: solid dim, no blur ── */
  .mobile-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    z-index: 99;
  }

  /* ── Layout grid ── */
  .docs-layout {
    position: relative;
    display: grid;
    grid-template-columns: 276px minmax(0, 1fr) 224px;
    min-height: calc(100vh - var(--docs-top));
    align-items: start;
    /* rows stay content-sized: the 6px dither row must not stretch to fill
       min-height (short pages, and at <=1024px where the sidebar is fixed) */
    align-content: start;
    max-width: 1600px;
    margin: 0 auto;
  }

  /* static ░▒▓ strip: a red ramp under a 2px checker dither (no motion) */
  .docs-dither {
    grid-column: 1 / -1;
    height: 6px;
    background:
      repeating-conic-gradient(var(--bg) 0 25%, transparent 0 50%) 0 0 / 2px 2px,
      linear-gradient(90deg, var(--red-lo), var(--red) 18%, color-mix(in srgb, var(--red) 40%, transparent) 45%, transparent 80%);
    opacity: 0.45;
  }
  [data-theme="light"] .docs-dither { opacity: 0.3; }

  /* ── Left sidebar ── */
  .docs-sidebar-col {
    position: sticky;
    top: var(--docs-top);
    height: calc(100vh - var(--docs-top));
    overflow-y: auto;
    overscroll-behavior: contain;
    border-right: 1px solid var(--border);
    scrollbar-width: thin;
  }
  .docs-sidebar-inner {
    padding: 1.25rem 0 1.5rem;
    min-height: 100%;
  }
  .sidebar-drawer-bar,
  .toc-drawer-bar {
    display: none;
    align-items: center;
    gap: 1ch;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-2);
  }
  .sidebar-drawer-bar { padding: 0 0.75rem 1rem 1.25rem; }
  .sidebar-drawer-name::before { content: '─[ '; content: '─[ ' / ''; color: var(--text-3); }
  .sidebar-drawer-name::after  { content: ' ]'; content: ' ]' / ''; color: var(--text-3); }
  .sidebar-drawer-rule { flex: 1; height: 1px; background: var(--border-hi); }

  /* ── Main content ── */
  .docs-content {
    padding: 1.75rem 3.5rem 5rem;
    min-width: 0;
  }

  /* ── Hub pages: two columns (tree + a wider main column), no TOC ── */
  .docs-layout--hub { grid-template-columns: 276px minmax(0, 1fr); }
  .docs-layout--hub .docs-breadcrumb,
  .docs-layout--hub .docs-footer { max-width: 1180px; }   /* = .docs-hub (hub.css) */

  /* ── Right TOC ── */
  .docs-toc-col {
    position: sticky;
    top: var(--docs-top);
    height: calc(100vh - var(--docs-top));
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .docs-toc-inner {
    padding: 2rem 1.5rem 2rem 0;
  }

  /* ── Breadcrumb: ~/docs/language/ownership ── */
  .docs-breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.5;
    margin-bottom: 1.75rem;
    max-width: 72ch;
  }
  .docs-breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: 2px;
  }
  .docs-breadcrumb li { display: inline-flex; align-items: baseline; min-width: 0; }
  .breadcrumb-sep { color: var(--text-3); padding: 0 0.15ch; }
  .breadcrumb-link {
    color: var(--text-2);
    text-decoration: none;
    padding: 0 0.15ch;
  }
  .breadcrumb-link:hover { background: var(--text); color: var(--bg); }
  .breadcrumb-dir { color: var(--text-2); padding: 0 0.15ch; }
  .breadcrumb-current {
    color: var(--accent);
    font-weight: 600;
    padding: 0 0.15ch;
    overflow-wrap: anywhere;
  }

  /* ── Prev / Next frames ── */
  .docs-nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    max-width: 72ch;
  }
  .docs-nav-card {
    --frame-pad: 0.9rem 1.1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    text-decoration: none;
    font-family: var(--font-mono);
  }
  .nav-card-next { text-align: right; align-items: flex-end; }
  .nav-card-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 1px 0.3ch;
    margin: -1px -0.3ch;
  }
  .nav-card-label::before { content: '['; content: '[' / ''; color: var(--text-3); }
  .nav-card-label::after  { content: ']'; content: ']' / ''; color: var(--text-3); }
  .nav-card-title {
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .docs-nav-card:hover .nav-card-label,
  .docs-nav-card:focus-visible .nav-card-label { background: var(--accent); color: var(--on-red); }
  .docs-nav-card:hover .nav-card-label::before,
  .docs-nav-card:hover .nav-card-label::after,
  .docs-nav-card:focus-visible .nav-card-label::before,
  .docs-nav-card:focus-visible .nav-card-label::after { color: inherit; }

  /* ── Docs footer ── */
  .docs-footer {
    margin-top: 2.5rem;
    max-width: 72ch;
    font-family: var(--font-mono);
  }
  .docs-eof { margin-bottom: 1rem; }
  .docs-footer-links {
    display: flex;
    gap: 0.5rem 2ch;
    flex-wrap: wrap;
  }
  .docs-footer-link {
    font-size: 0.74rem;
    color: var(--text-2);
    text-decoration: none;
    padding: 1px 0.3ch;
  }
  .docs-footer-link::before { content: '$ '; content: '$ ' / ''; color: var(--accent); }
  .docs-footer-link:hover { background: var(--text); color: var(--bg); }
  .docs-footer-link:hover::before { color: inherit; }

  /* ── Mobile TOC drawer: bottom sheet ── */
  .toc-drawer {
    display: none;
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: var(--bg-2);
    border-top: 3px double var(--border-hi);   /* ════ */
    border-radius: 0;
    padding: 0.85rem 1.25rem 1.25rem;
    z-index: 200;
    max-height: 60vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateY(100%);
    visibility: hidden;
    transition: transform var(--dur-med) var(--ease), visibility 0s linear var(--dur-med);
  }
  .toc-drawer.open {
    transform: translateY(0);
    visibility: visible;
    transition-delay: 0s;
  }
  .toc-drawer-bar { display: flex; margin-bottom: 0.85rem; }

  /* ── Hide TOC column on medium screens ── */
  @media (max-width: 1280px) {
    .docs-layout {
      grid-template-columns: 276px minmax(0, 1fr);
    }
    .docs-toc-col { display: none; }
    .toc-drawer { display: block; }
    #toc-toggle { display: inline-flex !important; }
  }

  /* ── Mobile: single column ── */
  @media (max-width: 1024px) {
    .docs-mobile-bar { display: flex; }
    .docs-layout { grid-template-columns: minmax(0, 1fr); }
    .docs-nav-grid { grid-template-columns: 1fr; }
    .docs-content { padding: 1.25rem 1.25rem 4rem; }

    /* Sidebar slides in from the left */
    .docs-sidebar-col {
      position: fixed;
      top: 0;
      left: 0;
      width: min(320px, 88vw);
      height: 100dvh;
      z-index: 100;
      background: var(--bg-2);
      transform: translateX(-100%);
      visibility: hidden;
      transition: transform var(--dur-med) var(--ease), visibility 0s linear var(--dur-med);
      border-right: 1px solid var(--border-hi);
    }
    .docs-sidebar-col.open {
      transform: translateX(0);
      visibility: visible;
      transition-delay: 0s;
    }
    .docs-sidebar-inner { padding-top: 1rem; }
    .sidebar-drawer-bar { display: flex; }
  }

  @media (max-width: 640px) {
    .docs-content { padding: 1rem 1rem 4rem; }
    .docs-nav-grid { margin-top: 3rem; }
  }
</style>

<style is:global>
  /* ── Footer gate (docs only) ──
     While html.docs-gated is set, the site footer is folded to zero height,
     so the document literally ends at the docs content: wheel, trackpad
     momentum, touch flings, End/PageDown and #anchor jumps all stop at the
     content end natively (no fighting the compositor, no scroll hijack).
     A second deliberate gesture at the bottom unfolds it (initDocsScroll).
     The fold only ever happens while the footer is below the viewport, so it
     never visibly moves anything. Contents stay in the a11y tree and in the
     tab order (focusing into it unfolds it). */
  @media screen {
    html.docs-gated body > footer.site-footer {
      height: 0;
      min-height: 0;
      margin-block: 0;
      padding-block: 0;
      border-width: 0;
      overflow: hidden;
      /* also clip (and contain) absolutely positioned descendants such as
         .sr-only items, which would otherwise still extend the page */
      contain: paint;
    }
  }
  /* DOCS_FIELD trial: <html> carries the page colour (BaseLayout's critical
     paint, same value as --bg in both themes), so body can drop its own
     --bg fill and let the z-index:-1 field show through. Only when the
     field host exists. */
  body:has(> #docs-field) { background-color: transparent; }
  /* heading focused by an in-page jump: ring for keyboard users only */
  .docs-content :is(h1, h2, h3, h4, h5, h6)[tabindex="-1"]:focus:not(:focus-visible) { outline: none; }
</style>

<script>
  import { createField, noise3, type FieldFn } from '../lib/ascii/field';
  import { reducedMotion } from '../lib/ascii/motion';

  function initDocs() {
    const sidebarCol = document.getElementById('docs-sidebar-col');
    if (!sidebarCol || sidebarCol.dataset.init) return;
    sidebarCol.dataset.init = '1';

    const sidebarToggle = document.getElementById('sidebar-toggle');
    const sidebarClose = document.getElementById('sidebar-close');
    const backdrop = document.getElementById('sidebar-backdrop');
    const tocToggle = document.getElementById('toc-toggle');
    const tocClose = document.getElementById('toc-close');
    const tocDrawer = document.getElementById('toc-drawer');

    function openSidebar() {
      closeToc();
      sidebarCol!.classList.add('open');
      sidebarToggle?.setAttribute('aria-expanded', 'true');
      if (backdrop) backdrop.style.display = 'block';
      document.body.style.overflow = 'hidden';
      sidebarClose?.focus({ preventScroll: true });
    }
    function closeSidebar(restoreFocus = false) {
      if (!sidebarCol!.classList.contains('open')) return;
      sidebarCol!.classList.remove('open');
      sidebarToggle?.setAttribute('aria-expanded', 'false');
      if (backdrop) backdrop.style.display = 'none';
      document.body.style.overflow = '';
      if (restoreFocus) sidebarToggle?.focus({ preventScroll: true });
    }
    function openToc() {
      if (!tocDrawer) return;
      tocDrawer.classList.add('open');
      tocDrawer.setAttribute('aria-hidden', 'false');
      tocToggle?.setAttribute('aria-expanded', 'true');
      if (backdrop) backdrop.style.display = 'block';
      document.dispatchEvent(new CustomEvent('docs:toc-open'));
    }
    function closeToc(restoreFocus = false) {
      if (!tocDrawer?.classList.contains('open')) return;
      tocDrawer.classList.remove('open');
      tocDrawer.setAttribute('aria-hidden', 'true');
      tocToggle?.setAttribute('aria-expanded', 'false');
      if (backdrop && !sidebarCol!.classList.contains('open')) backdrop.style.display = 'none';
      if (restoreFocus) tocToggle?.focus({ preventScroll: true });
    }

    sidebarToggle?.addEventListener('click', openSidebar);
    sidebarClose?.addEventListener('click', () => closeSidebar(true));
    backdrop?.addEventListener('click', () => {
      closeSidebar();
      closeToc();
    });

    tocToggle?.addEventListener('click', () => {
      tocDrawer?.classList.contains('open') ? closeToc() : openToc();
    });
    tocClose?.addEventListener('click', () => closeToc(true));

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      // the search palette handles its own Escape
      if (document.getElementById('search-modal')?.classList.contains('open')) return;
      if (sidebarCol.classList.contains('open')) closeSidebar(true);
      else if (tocDrawer?.classList.contains('open')) closeToc(true);
    });

    // Close sidebar on link click (mobile navigation)
    sidebarCol.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => closeSidebar());
    });
    // Opening search from inside the drawer: get the drawer out of the way
    sidebarCol.querySelector('[data-search-open]')?.addEventListener('click', () => closeSidebar());

    // Close TOC drawer on link click
    tocDrawer?.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => closeToc());
    });

    // Leaving the mobile breakpoint with a drawer open: reset state.
    const mq = window.matchMedia('(min-width: 1025px)');
    mq.addEventListener?.('change', (ev) => { if (ev.matches) closeSidebar(); });

    // ── Sidebar scroll persistence ──
    // Restore the sidebar's own scroll position across page navigations so it
    // doesn't jump back to the top. Only the sidebar container is scrolled —
    // never the page. If there's no saved position, center the active link.
    const KEY = 'docs-sidebar-scroll';
    let saved: string | null = null;
    try { saved = sessionStorage.getItem(KEY); } catch (_) {}
    if (saved !== null) {
      sidebarCol.scrollTop = parseInt(saved, 10);
    } else {
      const activeLink = sidebarCol.querySelector<HTMLElement>('.sidebar-link.active, .sidebar-grouplabel-link.active');
      if (activeLink) {
        const linkRect = activeLink.getBoundingClientRect();
        const colRect = sidebarCol.getBoundingClientRect();
        sidebarCol.scrollTop += linkRect.top - colRect.top - sidebarCol.clientHeight / 2;
      }
    }
    // If the active link ended up outside the restored view (e.g. user
    // searched and jumped somewhere far away), bring it into view gently.
    const activeLink = sidebarCol.querySelector<HTMLElement>('.sidebar-link.active');
    if (activeLink) {
      const linkRect = activeLink.getBoundingClientRect();
      const colRect = sidebarCol.getBoundingClientRect();
      if (linkRect.top < colRect.top + 40 || linkRect.bottom > colRect.bottom - 40) {
        sidebarCol.scrollTop += linkRect.top - colRect.top - sidebarCol.clientHeight / 2;
      }
    }
    sidebarCol.addEventListener('scroll', () => {
      try { sessionStorage.setItem(KEY, String(sidebarCol.scrollTop)); } catch (_) {}
    }, { passive: true });
  }

  // ── Footer gate + anchor clamp ──────────────────────────────────────
  // (1) Gate: on long pages the site footer is folded (html.docs-gated, see
  //     the global style above), so any scroll, however much momentum it
  //     carries, comes to rest with the docs content end at the viewport
  //     bottom. A NEW deliberate input at that bottom unfolds the footer:
  //       wheel/trackpad: a fresh gesture (>= GAP ms after the last wheel
  //         event, so momentum of the first never counts) pushing down;
  //       keyboard: a fresh (non-repeat) PageDown / Space / ArrowDown / End;
  //       touch: a new touch once the previous fling has stopped;
  //       scrollbar press, or focus moving into the footer: at once.
  //     Scrolling back up refolds it once it is fully below the viewport
  //     (invisible). Short pages (content end already in view) never gate.
  // (2) Anchor clamp: while gated, native #hash jumps can't pass the content
  //     end. With the footer unfolded, in-page #links are handled here:
  //     target = min(heading top - scroll-margin, content end - viewport).
  let docsScrollBound = false;
  function initDocsScroll() {
    const main = document.querySelector<HTMLElement>('main.docs-content');
    if (!main || docsScrollBound) return;
    docsScrollBound = true;

    const root = document.documentElement;
    const footer = document.querySelector<HTMLElement>('body > footer.site-footer');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const GAP = 220;        // ms of wheel silence that ends a gesture (incl. its momentum)
    const PUSH = 36;        // px a fresh gesture must push down to unfold the footer

    let gated = root.classList.contains('docs-gated');
    // reload / back-forward: let the browser restore its scroll position first
    const navType = (performance.getEntriesByType?.('navigation')[0] as PerformanceNavigationTiming | undefined)?.type;
    let armed = gated || !(navType === 'reload' || navType === 'back_forward');

    let contentBottom = 0;  // document-Y of the docs content end
    const measure = () => { contentBottom = main.getBoundingClientRect().bottom + window.scrollY; };
    const gateY = () => contentBottom - window.innerHeight;
    const canGate = () => !!footer && gateY() > 8;
    const maxScroll = () => root.scrollHeight - window.innerHeight;
    const atBottom = () => window.scrollY >= maxScroll() - 2;

    const setGated = (on: boolean) => {
      if (on === gated) return;
      gated = on;
      root.classList.toggle('docs-gated', on);
    };
    const release = () => setGated(false);
    // fold again only while the footer is entirely below the viewport
    const maybeRegate = () => {
      if (!armed || gated) return;
      if (canGate() && window.scrollY < gateY() - 2) setGated(true);
    };
    const reconcile = () => {
      measure();
      if (gated && !canGate()) setGated(false);   // page got short: show the footer
      else maybeRegate();
    };

    // modals / drawers own the scroll while open
    const pageLocked = () => document.body.style.overflow === 'hidden';
    const OWN_SCROLL = '.docs-sidebar-col, .docs-toc-col, .toc-drawer, .search-modal, [role="dialog"], dialog';
    // would this wheel be consumed by an inner scroller (sidebar, TOC, code)?
    const innerTakes = (t: EventTarget | null, dy: number) => {
      let el = t instanceof Element ? t : null;
      while (el && el !== document.body && el !== root) {
        if (el.scrollHeight > el.clientHeight + 1) {
          const cs = getComputedStyle(el);
          if (cs.overflowY === 'auto' || cs.overflowY === 'scroll') {
            if (dy > 0 ? el.scrollTop + el.clientHeight < el.scrollHeight - 1 : el.scrollTop > 0) return true;
            if (cs.overscrollBehaviorY !== 'auto') return true;
          }
        }
        el = el.parentElement;
      }
      return false;
    };

    // ── scroll: refold when back in the content; settle after our own jumps
    let lastScrollT = 0;
    let rafPending = false;
    let regateOnSettle = false;
    let settleTimer = 0;
    const onSettle = () => {
      if (!regateOnSettle) return;
      regateOnSettle = false;
      if (!gated && armed && canGate() && window.scrollY <= gateY() + 1) setGated(true);
    };
    window.addEventListener('scroll', () => {
      lastScrollT = performance.now();
      if (regateOnSettle && !('onscrollend' in window)) {
        clearTimeout(settleTimer);
        settleTimer = window.setTimeout(onSettle, 160);
      }
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => { rafPending = false; maybeRegate(); });
    }, { passive: true });
    window.addEventListener('scrollend', onSettle, { passive: true });

    // ── wheel / trackpad (passive: never blocks or hijacks scrolling) ──
    let lastWheelT = -1e9;
    let acc = 0;
    let count = 0;
    let freshAtBottom = false;
    window.addEventListener('wheel', (e) => {
      const now = performance.now();
      const fresh = now - lastWheelT > GAP;
      lastWheelT = now;
      if (!gated) return;
      if (fresh) { acc = 0; count = 0; freshAtBottom = atBottom(); }
      if (!freshAtBottom || e.ctrlKey || pageLocked()) return;
      let dy = e.deltaY;
      if (e.deltaMode === 1) dy *= 32;
      else if (e.deltaMode === 2) dy *= window.innerHeight;
      if (dy <= 0 || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
      if (!atBottom() || innerTakes(e.target, dy)) return;
      acc += dy;
      count++;
      if (acc >= PUSH || count >= 4 || e.deltaMode !== 0) release();
    }, { passive: true });

    // ── keyboard: End goes to the content end; a second End to the footer ──
    const editable = (t: EventTarget | null) =>
      t instanceof HTMLElement &&
      (t.isContentEditable || !!t.closest('input, textarea, select, button, summary, [contenteditable="true"]'));
    document.addEventListener('keydown', (e) => {
      if (!gated || e.defaultPrevented || e.repeat || e.altKey || e.ctrlKey) return;
      const k = e.key;
      const down = k === 'PageDown' || k === 'End' || k === 'ArrowDown' || (k === ' ' && !e.shiftKey);
      if (!down || (e.metaKey && k !== 'ArrowDown')) return;
      if (editable(e.target) || pageLocked()) return;
      if ((document.activeElement as Element | null)?.closest?.(OWN_SCROLL)) return;
      if (atBottom()) release();   // the default action then scrolls into the footer
    });

    // ── touch: a new touch at the bottom, after the fling has stopped ──
    window.addEventListener('touchstart', (e) => {
      if (!gated || e.touches.length !== 1 || pageLocked()) return;
      if (performance.now() - lastScrollT < 140) return;   // still flinging / bouncing
      if ((e.target as Element | null)?.closest?.(OWN_SCROLL)) return;
      if (atBottom()) release();
    }, { passive: true });

    // ── scrollbar: never blocked, the full page is there as soon as it's grabbed
    window.addEventListener('pointerdown', (e) => {
      if (!gated || e.pointerType !== 'mouse') return;
      if (e.target === root || e.clientX >= root.clientWidth) release();
    }, { passive: true, capture: true });

    // ── Tab into the footer (or anything focusing it): unfold, keep it in view
    document.addEventListener('focusin', (e) => {
      if (!gated || !footer || !footer.contains(e.target as Node)) return;
      release();
      // bring it into view now that the footer has height again (the
      // browser's own focus scroll ran against the folded footer)
      (e.target as HTMLElement).scrollIntoView?.({ block: 'nearest', behavior: 'instant' });
    });

    // ── anchor clamp (only needed while the footer is unfolded) ──
    const announce = (id: string) => document.dispatchEvent(new CustomEvent('docs:anchor', { detail: { id } }));
    const jumpTo = (el: HTMLElement, smooth: boolean, focus: boolean) => {
      measure();
      const sm = parseFloat(getComputedStyle(el).scrollMarginTop) || 0;
      const sp = parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;
      const top = el.getBoundingClientRect().top + window.scrollY - sm - sp;
      const target = Math.max(0, Math.min(top, canGate() ? gateY() : top));
      regateOnSettle = true;
      window.scrollTo({ top: target, behavior: smooth && !reduce.matches ? 'smooth' : 'instant' });
      if (Math.abs(window.scrollY - target) < 1) onSettle();   // no scroll needed
      if (focus) {
        if (!el.matches('a[href], button, input, select, textarea, [tabindex]')) {
          el.setAttribute('tabindex', '-1');
          el.addEventListener('blur', () => el.removeAttribute('tabindex'), { once: true });
        }
        el.focus({ preventScroll: true });
      }
    };
    const targetOf = (hash: string) => {
      if (!hash || hash === '#') return null;
      let id = hash.slice(1);
      try { id = decodeURIComponent(id); } catch { /* keep raw */ }
      const el = document.getElementById(id);
      return el && main.contains(el) ? el : null;
    };
    document.addEventListener('click', (e) => {
      if (gated || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
      if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
      const url = new URL(a.href, location.href);
      if (url.origin !== location.origin || url.pathname !== location.pathname || url.search !== location.search) return;
      const el = targetOf(url.hash);
      if (!el || !canGate()) return;   // short page / non-content target: native is fine
      e.preventDefault();
      if (location.hash !== url.hash) history.pushState(null, '', url.hash);
      jumpTo(el, true, true);
      announce(el.id);
    });
    // typed / traversed #hash while unfolded: pull an overshoot back out of the footer
    window.addEventListener('hashchange', () => {
      if (gated) return;
      measure();
      const el = targetOf(location.hash);
      if (el && canGate() && window.scrollY > gateY() + 1) jumpTo(el, false, false);
    });

    // ── keep the measurements honest ──
    measure();
    if (gated && !canGate()) setGated(false);
    if ('ResizeObserver' in window) new ResizeObserver(reconcile).observe(main);
    window.addEventListener('resize', reconcile, { passive: true });
    document.fonts?.ready.then(reconcile).catch(() => {});
    if (!armed) {
      const arm = () => window.setTimeout(() => { armed = true; reconcile(); }, 250);
      if (document.readyState === 'complete') arm();
      else window.addEventListener('load', arm, { once: true });
    }
  }

  initDocs();
  initDocsScroll();
  document.addEventListener('astro:page-load', () => { initDocs(); initDocsScroll(); initDocsField(); });

  // ── DOCS_FIELD trial (see the flag in the frontmatter) ──────────────
  // One fixed, viewport-sized canvas. Docs are calm pages, so the field opts
  // back in with animateOnCalm and runs on the shared field scheduler at
  // 12fps (paused while the tab is hidden; reduced motion: one still frame).
  // Its clock starts at the wall clock, so consecutive docs pages show the
  // same, continuous drift. It covers the whole viewport, columns included.
  function initDocsField() {
    const host = document.getElementById('docs-field');
    if (!host || host.dataset.init) return;
    host.dataset.init = '1';
    const still = reducedMotion();

    // the home bands' 'noise' preset, minus its centre vignette (the field
    // spans every column here); a soft top/bottom falloff instead
    // Time is read from the wall clock once per frame, not accumulated: the
    // field scheduler drops hidden-tab time, which would leave this page
    // behind the next one and make the next docs click swap patterns.
    let lastT = NaN, W = 0;
    const fn: FieldFn = (x, y, t, _p, e) => {
      if (t !== lastT) { lastT = t; W = still ? t : (Date.now() / 1000) % 86400; }
      const nx = x / 90, ny = y / 70;
      const n = noise3(nx, ny, W * 0.16) * 0.65 + noise3(nx * 2.1, ny * 2.1, W * 0.26 + 7) * 0.35;
      const v = y / e.h;
      const edge = v < 0.5 ? v : 1 - v;
      return Math.max(0, (n - 0.35) * 1.9) * (edge > 0.2 ? 1 : 0.5 + edge * 2.5);
    };
    // wall clock (s): same frame on every docs page at the same moment
    const t0 = still ? 0 : (Date.now() / 1000) % 86400;
    const field = createField(host, {
      fn, size: 14, fps: still ? 0 : 12, pointer: false, animateOnCalm: true, t0,
    });

    field.start();
    // Every docs click is a fresh document (cross-document view transition,
    // no client router). If we came from another docs page the field was
    // already showing, and its wall clock makes this frame continue that
    // one, so switch it on now, in the same task that painted frame 0, with
    // no fade. Only an entry from outside the docs gets the 900ms fade-in.
    if (cameFromDocs()) host.classList.add('no-fade', 'is-on');
    else requestAnimationFrame(() => host.classList.add('is-on'));
  }
  function cameFromDocs(): boolean {
    const isDocs = (u?: string | null) => {
      if (!u) return false;
      try {
        const url = new URL(u, location.href);
        return url.origin === location.origin && /^\/docs(\/|$)/.test(url.pathname);
      } catch { return false; }
    };
    const act = (window as any).navigation?.activation;
    if (act) {
      // reload / back-forward to this same page: also no re-fade
      if (act.navigationType === 'reload') return true;
      if (act.from) return isDocs(act.from.url);
    }
    return isDocs(document.referrer);
  }
  initDocsField();
</script>
