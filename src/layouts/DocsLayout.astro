---
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';
import DocsSearch from '../components/docs/DocsSearch.astro';
import TableOfContents from '../components/docs/TableOfContents.astro';
import CodeBlockEnhancer from '../components/docs/CodeBlockEnhancer.astro';
interface Props {
  title: string;
  description?: string;
  prev?: { href: string; title: string } | null;
  next?: { href: string; title: string } | null;
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { title, description, prev, next, headings = [] } = Astro.props;
const currentPath = Astro.url.pathname;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Docs', url: '/docs' },
  { name: title, url: currentPath },
];

const EDIT_BASE = 'https://github.com/kairolang/kairo-web/edit/main/src/content/docs';

// Prefer an explicit editPath if a page/route passes one; otherwise derive
// from the URL. e.g. "/docs/language/ownership/" -> "language/ownership.mdx"
const derivedPath = currentPath
  .replace(/^\/docs\/?/, '')   // drop leading /docs/
  .replace(/\/$/, '');         // drop trailing slash
const finalPath = (derivedPath ? `${derivedPath}.mdx` : 'index.mdx');
const editUrl   = `${EDIT_BASE}/${finalPath}`;
---
<BaseLayout
  title={`${title} - Kairo Docs`}
  description={description}
  type="docs"
  breadcrumbs={breadcrumbs}
>
  <!-- Mobile top bar -->
  <div class="docs-mobile-bar" id="docs-mobile-bar">
    <button id="sidebar-toggle" class="sidebar-toggle-btn" aria-label="Open navigation">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="15" y2="12"/>
        <line x1="3" y1="18" x2="18" y2="18"/>
      </svg>
      <span>Menu</span>
    </button>
    <span class="docs-mobile-title">{title}</span>
    {headings.filter(h => h.depth <= 3).length > 0 && (
      <button id="toc-toggle" class="sidebar-toggle-btn" aria-label="On this page" style="margin-left:auto;">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <line x1="8" y1="6" x2="21" y2="6"/>
          <line x1="8" y1="12" x2="21" y2="12"/>
          <line x1="8" y1="18" x2="21" y2="18"/>
          <line x1="3" y1="6" x2="3.01" y2="6"/>
          <line x1="3" y1="12" x2="3.01" y2="12"/>
          <line x1="3" y1="18" x2="3.01" y2="18"/>
        </svg>
        On this page
      </button>
    )}
  </div>

  <!-- Sidebar backdrop (mobile) -->
  <div id="sidebar-backdrop" class="mobile-backdrop"></div>

  <div class="docs-layout">
    <!-- Left sidebar -->
    <aside class="docs-sidebar-col" id="docs-sidebar-col">
      <div class="docs-sidebar-inner">
        <!-- Close button (mobile only) -->
        <button id="sidebar-close" class="sidebar-close-btn" aria-label="Close navigation">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
        <DocsSearch />
        <DocsSidebar currentPath={currentPath} />
      </div>
    </aside>
    <!-- Restore sidebar scroll synchronously, before first paint, so the
         sidebar never visibly jumps when navigating between docs pages. -->
    <script is:inline>
      (function () {
        try {
          var col = document.getElementById('docs-sidebar-col');
          var saved = sessionStorage.getItem('docs-sidebar-scroll');
          if (col && saved !== null) col.scrollTop = parseInt(saved, 10);
        } catch (_) {}
      })();
    </script>

    <!-- Center: main content -->
    <main class="docs-content">
      <!-- Breadcrumb -->
      <nav class="docs-breadcrumb" aria-label="Breadcrumb">
        <a href="/" class="breadcrumb-link">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        <a href="/docs" class="breadcrumb-link">Docs</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        <span class="breadcrumb-current">{title}</span>
      </nav>

      <!-- Article -->
      <article class="prose">
        <slot />
      </article>

      <!-- Prev / Next -->
      {(prev || next) && (
        <nav class="docs-nav-grid" aria-label="Page navigation">
          <div>
            {prev && (
              <a href={prev.href} class="docs-nav-card">
                <span class="nav-card-label">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                  Previous
                </span>
                <span class="nav-card-title">{prev.title}</span>
              </a>
            )}
          </div>
          <div>
            {next && (
              <a href={next.href} class="docs-nav-card nav-card-next">
                <span class="nav-card-label">
                  Next
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
                <span class="nav-card-title">{next.title}</span>
              </a>
            )}
          </div>
        </nav>
      )}

      <footer class="docs-footer">
        <a href="https://github.com/kairolang/kairo/issues" target="_blank" rel="noopener noreferrer" class="docs-footer-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
          Report an issue
        </a>
        <a href={editUrl} target="_blank" rel="noopener noreferrer" class="docs-footer-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
          Edit this page
        </a>
      </footer>
    </main>

    <!-- Right: TOC -->
    <aside class="docs-toc-col">
      <div class="docs-toc-inner">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>

  <!-- Mobile TOC drawer -->
  <div id="toc-drawer" class="toc-drawer">
    <TableOfContents headings={headings} />
  </div>

  <CodeBlockEnhancer />
</BaseLayout>

<style>
  /* ── Mobile top bar ── */
  .docs-mobile-bar {
    display: none;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
    position: sticky;
    top: 60px;
    z-index: 40;
  }
  .sidebar-toggle-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-3);
    border: 1px solid var(--border);
    color: var(--text-2);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .sidebar-toggle-btn:hover {
    border-color: var(--border-hi);
    color: var(--text);
  }
  .docs-mobile-title {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
    min-width: 0;
  }
  .sidebar-close-btn {
    display: none;
    background: transparent;
    border: none;
    color: var(--text-3);
    cursor: pointer;
    padding: 4px;
    margin-bottom: 0.5rem;
  }

  /* ── Mobile backdrop ── */
  .mobile-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 99;
  }

  /* ── Docs layout grid ── */
  .docs-layout {
    display: grid;
    grid-template-columns: 276px minmax(0, 1fr) 224px;
    min-height: calc(100vh - 60px);
    align-items: start;
    max-width: 1600px;
    margin: 0 auto;
  }

  /* ── Left sidebar ── */
  .docs-sidebar-col {
    position: sticky;
    top: 60px;
    height: calc(100vh - 60px);
    overflow-y: auto;
    border-right: 1px solid var(--border);
    scrollbar-width: thin;
  }
  .docs-sidebar-inner {
    padding: 1.5rem 0;
    min-height: 100%;
  }

  /* ── Main content ── */
  .docs-content {
    padding: 2.5rem 3.5rem 5rem;
    min-width: 0;
  }

  /* ── Right TOC ── */
  .docs-toc-col {
    position: sticky;
    top: 60px;
    height: calc(100vh - 60px);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .docs-toc-inner {
    padding: 2.5rem 1.5rem 2rem 0;
  }

  /* ── Breadcrumb ── */
  .docs-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--text-3);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .breadcrumb-link {
    color: var(--text-3);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }
  .breadcrumb-link:hover { color: var(--text); }
  .breadcrumb-current { color: var(--text-2); font-weight: 500; }

  /* ── Prev/Next ── */
  .docs-nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .docs-nav-card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 16px 20px;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease),
      box-shadow var(--dur-med) var(--ease);
  }
  .docs-nav-card:hover {
    border-color: var(--border-hi);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .nav-card-next { text-align: right; }
  .nav-card-next .nav-card-label { justify-content: flex-end; }
  .nav-card-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--text-3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .nav-card-title {
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  /* ── Docs footer ── */
  .docs-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .docs-footer-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--text-3);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }
  .docs-footer-link:hover { color: var(--text); }

  /* ── Mobile TOC drawer ── */
  .toc-drawer {
    display: none;
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: var(--bg-2);
    border-top: 1px solid var(--border);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    padding: 1.5rem;
    z-index: 200;
    max-height: 50vh;
    overflow-y: auto;
    transform: translateY(100%);
    transition: transform var(--dur-med) var(--ease);
    box-shadow: var(--shadow-lg);
  }
  .toc-drawer.open {
    transform: translateY(0);
  }

  /* ── Hide TOC on medium screens ── */
  @media (max-width: 1280px) {
    .docs-layout {
      grid-template-columns: 276px minmax(0, 1fr);
    }
    .docs-toc-col { display: none; }
    .toc-drawer { display: block; }
    #toc-toggle { display: flex !important; }
  }

  /* ── Mobile: single column ── */
  @media (max-width: 1024px) {
    .docs-mobile-bar { display: flex; }
    .docs-layout { grid-template-columns: 1fr; }
    .docs-nav-grid { grid-template-columns: 1fr; }
    .docs-content { padding: 1.5rem 1.25rem 4rem; }

    /* Sidebar slides in from left */
    .docs-sidebar-col {
      position: fixed;
      top: 0;
      left: 0;
      width: min(300px, 85vw);
      height: 100dvh;
      z-index: 100;
      background: var(--bg-2);
      transform: translateX(-100%);
      transition: transform var(--dur-med) var(--ease);
      border-right: 1px solid var(--border);
    }
    .docs-sidebar-col.open {
      transform: translateX(0);
    }
    .sidebar-close-btn { display: flex; margin: 1rem 1.5rem 0.5rem; }
    .docs-sidebar-inner { padding-top: 0.5rem; }
  }

  @media (max-width: 640px) {
    .docs-content { padding: 1.25rem 1rem 4rem; }
    .docs-nav-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  function initDocs() {
    const sidebarToggle = document.getElementById('sidebar-toggle');
    const sidebarClose = document.getElementById('sidebar-close');
    const sidebarCol = document.getElementById('docs-sidebar-col');
    const backdrop = document.getElementById('sidebar-backdrop');
    const tocToggle = document.getElementById('toc-toggle');
    const tocDrawer = document.getElementById('toc-drawer');

    function openSidebar() {
      sidebarCol?.classList.add('open');
      if (backdrop) backdrop.style.display = 'block';
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      sidebarCol?.classList.remove('open');
      if (backdrop) backdrop.style.display = 'none';
      document.body.style.overflow = '';
    }

    sidebarToggle?.addEventListener('click', openSidebar);
    sidebarClose?.addEventListener('click', closeSidebar);
    backdrop?.addEventListener('click', () => {
      closeSidebar();
      tocDrawer?.classList.remove('open');
    });

    tocToggle?.addEventListener('click', () => {
      tocDrawer?.classList.toggle('open');
    });

    // Close sidebar on link click (mobile navigation)
    sidebarCol?.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', closeSidebar);
    });

    // Close TOC drawer on link click
    tocDrawer?.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => tocDrawer.classList.remove('open'));
    });

    // ── Sidebar scroll persistence ──
    // Restore the sidebar's own scroll position across page navigations so it
    // doesn't jump back to the top. Only the sidebar container is scrolled —
    // never the page. If there's no saved position, center the active link.
    if (sidebarCol) {
      const KEY = 'docs-sidebar-scroll';
      const saved = sessionStorage.getItem(KEY);
      if (saved !== null) {
        sidebarCol.scrollTop = parseInt(saved, 10);
      } else {
        const activeLink = sidebarCol.querySelector<HTMLElement>('.sidebar-link.active, .sidebar-grouplabel-link.active');
        if (activeLink) {
          const linkRect = activeLink.getBoundingClientRect();
          const colRect = sidebarCol.getBoundingClientRect();
          sidebarCol.scrollTop += linkRect.top - colRect.top - sidebarCol.clientHeight / 2;
        }
      }
      // If the active link ended up outside the restored view (e.g. user
      // searched and jumped somewhere far away), bring it into view gently.
      const activeLink = sidebarCol.querySelector<HTMLElement>('.sidebar-link.active');
      if (activeLink) {
        const linkRect = activeLink.getBoundingClientRect();
        const colRect = sidebarCol.getBoundingClientRect();
        if (linkRect.top < colRect.top + 40 || linkRect.bottom > colRect.bottom - 40) {
          sidebarCol.scrollTop += linkRect.top - colRect.top - sidebarCol.clientHeight / 2;
        }
      }
      sidebarCol.addEventListener('scroll', () => {
        sessionStorage.setItem(KEY, String(sidebarCol.scrollTop));
      }, { passive: true });
    }
  }

  initDocs();
  document.addEventListener('astro:page-load', initDocs);
</script>
