---
import CodeBlockEnhancer from '../components/docs/CodeBlockEnhancer.astro';
import TableOfContents from '../components/docs/TableOfContents.astro';
import AsciiButton from '../components/ascii/AsciiButton.astro';
import AsciiFrame from '../components/ascii/AsciiFrame.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author?: string;
  tags?: string[];
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { title, description, pubDate, author = 'Kairo Team', tags = [], headings = [] } = Astro.props;

// Frontmatter dates are UTC midnight: format in UTC so the day never slips.
const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const isoDate = pubDate.toISOString().slice(0, 10);

const slot = await Astro.slots.render('default');
const wordCount = slot.replace(/<[^>]+>/g, '').split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: title, url: Astro.url.pathname },
];

const slug = decodeURIComponent(Astro.url.pathname.replace(/\/+$/, '').split('/').pop() ?? 'post');

// key ..... value  (dot leaders are decorative)
const LEAD = 12;
const leader = (k: string) => ' ' + '.'.repeat(Math.max(2, LEAD - k.length - 1));
const meta: Array<{ k: string; v: string; dt?: string }> = [
  { k: 'author', v: author },
  { k: 'published', v: formattedDate, dt: isoDate },
  { k: 'read', v: `${readingTime} min read` },
  { k: 'words', v: wordCount.toLocaleString('en-US') },
];

// The TOC tree itself (shared with docs) lives in TableOfContents.
const tocCount = headings.filter((h) => h.depth === 2 || h.depth === 3).length;
---
<BaseLayout
  title={`${title} - Kairo Blog`}
  description={description}
  type="blog"
  ogType="article"
  pubDate={pubDate}
  author={author}
  tags={tags}
  breadcrumbs={breadcrumbs}
>
  <div class="post-container">
    <!-- Scroll detents (DESIGN §11): only the header block (top) and the footer
         block (end) are marked. The article body never snaps. -->
    <nav class="post-crumbs" aria-label="Breadcrumb" data-snap>
      <a href="/">~</a><span class="dim" aria-hidden="true">/</span><a href="/blog/">blog</a><span class="dim" aria-hidden="true">/</span><span class="post-crumb-cur" aria-current="page">{slug}</span>
    </nav>

    <div class="post-grid">
      <!-- Center: content -->
      <main id="main" class="post-main">
        <AsciiFrame as="header" title={`${slug}.mdx`} meta="post" variant="fill" class="post-head" id="post-head">
          <div class="section-label">Blog <span class="post-label-date">/ {isoDate}</span></div>
          <!-- Large title: hover rect lens only (calm page: no load-in sweep). -->
          <h1 class="post-title" data-lens="hover">{title}</h1>
          <p class="post-desc">{description}</p>

          <dl class="post-kv">
            {meta.map((m) => (
              <div class="kv-row">
                <dt>{m.k}<span class="kv-lead" aria-hidden="true">{leader(m.k)}</span></dt>
                <dd>{m.dt ? <time datetime={m.dt}>{m.v}</time> : m.v}</dd>
              </div>
            ))}
            {tags.length > 0 && (
              <div class="kv-row">
                <dt>tags<span class="kv-lead" aria-hidden="true">{leader('tags')}</span></dt>
                <dd class="kv-tags">{tags.map((tag) => <span class="tag">{tag}</span>)}</dd>
              </div>
            )}
          </dl>

          {tocCount > 0 && (
            <details class="post-toc-mobile">
              <summary><span class="toc-sum-label">contents</span> <span class="dim">({tocCount})</span></summary>
              <TableOfContents headings={headings} id="post-toc-inline" progress={false} label={false} class="post-toc-inline" />
            </details>
          )}
        </AsciiFrame>

        <article class="prose post-body" id="post-body">
          <slot />
        </article>
        <CodeBlockEnhancer />

        <div class="ascii-rule post-eof" aria-hidden="true">EOF</div>

        <div class="post-footer" data-snap="end">
          <a href="/blog/" class="ascii-btn ascii-btn--ghost post-btn-back">
            <span class="ascii-btn-icon" aria-hidden="true" data-scramble-skip>←</span>
            <span class="ascii-btn-label">All posts</span>
          </a>
          <AsciiButton href="/docs/" label="Read the Docs" />
        </div>
      </main>

      <!-- Right rail: read bar + TOC tree + [ ↑ top ] [ cd .. ] (shared with docs) -->
      <aside class="post-rail" aria-label="Post navigation">
        <TableOfContents headings={headings} id="post-toc" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .post-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  @media (max-width: 480px) {
    .post-container { padding: 0 1rem; }
  }

  /* ── breadcrumb path ─────────────────────────────────────────── */
  .post-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4ch;
    padding: 2.5rem 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  .post-crumbs a {
    color: var(--accent);
    text-decoration: none;
    padding: 0 0.2ch;
  }
  .post-crumbs a:hover,
  .post-crumbs a:focus-visible {
    background: var(--accent);
    color: var(--on-red);
  }
  .post-crumb-cur { color: var(--text-2); }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 4rem;
    padding-bottom: 5rem;
    align-items: start;
  }
  .post-main { min-width: 0; }

  /* ── header block ────────────────────────────────────────────── */
  .post-head {
    --frame-pad: 1.75rem 1.75rem 1.5rem;
    margin-bottom: 3rem;
  }
  .post-label-date { color: var(--text-2); letter-spacing: 0.06em; }
  .post-title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(1.55rem, 3.6vw, 2.5rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--text);
    margin: 0.9rem 0 0.9rem;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .post-desc {
    font-family: var(--font-sans);
    font-size: 1.04rem;
    color: var(--text-2);
    line-height: 1.65;
    margin: 0 0 1.5rem;
    max-width: 62ch;
  }

  .post-kv {
    margin: 0;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--frame-line);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
    display: grid;
    gap: 0.15rem;
  }
  .kv-row {
    display: grid;
    grid-template-columns: 13ch minmax(0, 1fr);
    align-items: baseline;
  }
  .kv-row dt { color: var(--text-2); white-space: pre; }
  .kv-lead { color: var(--text-3); }
  .kv-row dd { margin: 0; color: var(--text); overflow-wrap: anywhere; }
  .kv-row:first-child dd { font-weight: 600; }
  .kv-tags { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 2px; }

  /* ── right rail ─────────────────────────────────────────────── */
  .post-rail {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    /* no overscroll-behavior: contain here. When the rail's content fits, Chrome
       would treat it as a scroll container that swallows the wheel, so the post
       could not scroll with the pointer over the TOC. Chaining at the ends is fine. */
    scrollbar-width: thin;
    font-family: var(--font-mono);
    padding-bottom: 1rem;
  }
  /* ── mobile TOC (inside the header block) ───────────────────── */
  .post-toc-mobile {
    display: none;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--frame-line);
    font-family: var(--font-mono);
  }
  .post-toc-mobile summary {
    cursor: pointer;
    list-style: none;
    font-size: 0.78rem;
    color: var(--text-2);
    width: fit-content;
    padding: 2px 0.5ch;
    margin-left: -0.5ch;
  }
  .post-toc-mobile summary::-webkit-details-marker { display: none; }
  .post-toc-mobile summary::before {
    content: '[+] ';
    content: '[+] ' / '';
    color: var(--accent);
  }
  .post-toc-mobile[open] summary::before { content: '[-] '; content: '[-] ' / ''; }
  .post-toc-mobile summary:hover { color: var(--text); }
  .toc-sum-label { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.7rem; }
  .post-toc-mobile :global(.post-toc-inline) { margin-top: 0.75rem; padding-bottom: 0; }

  /* ── end of post ────────────────────────────────────────────── */
  .post-eof { margin-top: 4rem; }
  .post-footer {
    margin-top: 1.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .post-btn-back:hover .ascii-btn-icon,
  .post-btn-back:focus-visible .ascii-btn-icon { transform: translateX(-0.5ch); }

  @media (max-width: 1080px) {
    .post-grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .post-rail { display: none; }
    .post-toc-mobile { display: block; }
  }
  @media (max-width: 640px) {
    .post-crumbs { padding-top: 1.75rem; }
    .post-head { --frame-pad: 1.4rem 1rem 1.15rem; margin-bottom: 2.25rem; }
    .post-head :global(.ascii-frame-meta) { display: none; }
    .post-kv { font-size: 0.76rem; }
  }
</style>

<script>
  import { bindResizable } from '../lib/ascii/resize';

  // Code blocks are framed client-side by CodeBlockEnhancer (.code-block-wrap,
  // shared with docs, so not edited here). BaseLayout's idle bindResizable()
  // normally runs after that; re-binding the post body is idempotent and
  // guarantees the grips even if the wrap lands later (page-load navigations).
  function initPostResize() {
    const body = document.getElementById('post-body');
    if (!body || document.documentElement.dataset.resize === 'off') return;
    const run = () => { try { bindResizable(body); } catch { /* resizing is a bonus */ } };
    if ('requestIdleCallback' in window) requestIdleCallback(run, { timeout: 1200 });
    else setTimeout(run, 400);
  }

  function initPost() { initPostResize(); }
  initPost();
  document.addEventListener('astro:page-load', initPost);
</script>
