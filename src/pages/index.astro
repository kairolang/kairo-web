---
// Section backgrounds alternate: hero (its own field) · stats (drifting field) ·
// showcase · install (plain) · CTA (drifting field). Every section is a top-level
// <section> (body > main > section), so each one is a scroll-snap detent.
import CodeShowcase from '../components/landing/CodeShowcase.astro';
import Cta from '../components/landing/Cta.astro';
import Hero from '../components/landing/Hero.astro';
import QuickInstall from '../components/landing/QuickInstall.astro';
import Stats from '../components/landing/Stats.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Kairo — The Systems Programming Language Beyond C++"
  description="Kairo is an open-source systems programming language with native, bidirectional C++ interop: C++ performance and modern safety, with no bindings to maintain."
  type="home"
>
  <main id="main">
  <Hero />
  <Stats />
  <CodeShowcase />
  <QuickInstall />
  <Cta />
  </main>
</BaseLayout>
