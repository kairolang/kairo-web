---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout
  title="Blog - Kairo"
  description="Thoughts, updates, and design proposals from the Kairo language team."
>
  <!-- Header -->
  <section class="blog-hero">
    <div class="ambient blog-ambient" aria-hidden="true"></div>
    <div class="container blog-hero-inner">
      <div class="section-label fade-up" style="--d: 0ms;">Blog</div>
      <h1 class="display blog-hero-title">
        <span class="mask-line"><span style="--d: 80ms;">Thoughts &amp; Updates</span></span>
      </h1>
      <p class="blog-hero-sub fade-up" style="--d: 240ms;">
        Design decisions, language proposals, and updates from the Kairo team
        and community contributors.
      </p>
    </div>
  </section>

  <!-- Post list -->
  <section class="blog-list-section">
    <div class="container blog-list-container">
      {posts.length === 0 ? (
        <div class="blog-empty">
          <p class="blog-empty-title">No posts yet.</p>
          <p class="blog-empty-sub">Check back soon.</p>
        </div>
      ) : (
        <div class="blog-list" data-reveal-stagger data-stagger-step="80">
          {posts.map(post => {
            const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            });
            return (
              <a href={`/blog/${post.id.replace(/\.mdx?$/, '')}`} class="blog-card">
                <div class="blog-card-meta">
                  <span class="blog-card-date">{formattedDate}</span>
                  <span class="blog-card-author">By {post.data.author}</span>
                </div>
                <h2 class="blog-card-title">{post.data.title}</h2>
                <p class="blog-card-desc">{post.data.description}</p>
                <div class="blog-card-bottom">
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="blog-card-tags">
                      {post.data.tags.map(tag => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  )}
                  <span class="blog-card-read">
                    Read post
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-hero {
    padding: clamp(4rem, 10vh, 7rem) 0 3.5rem;
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  .blog-ambient {
    width: 560px;
    height: 360px;
    top: -180px;
    left: 8%;
    background: radial-gradient(ellipse at center, var(--red-glow) 0%, transparent 70%);
  }
  .blog-hero-inner {
    position: relative;
    z-index: 1;
  }
  .blog-hero-title {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-bottom: 1.1rem;
  }
  .blog-hero-sub {
    font-size: 1.05rem;
    color: var(--text-2);
    max-width: 500px;
    line-height: 1.65;
  }

  .blog-list-section {
    padding: 4rem 0 6rem;
  }
  .blog-list-container {
    max-width: 860px;
  }

  .blog-empty {
    text-align: center;
    padding: 5rem 2rem;
    color: var(--text-3);
  }
  .blog-empty-title { font-size: 1.25rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--text-2); }
  .blog-empty-sub { font-size: 0.875rem; }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .blog-card {
    display: block;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 1.75rem 2rem;
    text-decoration: none;
    transition:
      transform var(--dur-med) var(--ease),
      border-color var(--dur-med) var(--ease),
      box-shadow var(--dur-med) var(--ease);
  }
  .blog-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-hi);
    box-shadow: var(--shadow-md);
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }
  .blog-card-date,
  .blog-card-author {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-3);
    letter-spacing: 0.04em;
  }

  .blog-card-title {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 0.6rem;
    line-height: 1.3;
    transition: color var(--dur-fast) var(--ease);
  }

  .blog-card-desc {
    font-size: 0.92rem;
    color: var(--text-2);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .blog-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .blog-card-read {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-3);
    transition: color var(--dur-fast) var(--ease);
  }
  .blog-card-read svg { transition: transform var(--dur-fast) var(--ease); }
  .blog-card:hover .blog-card-read { color: var(--accent); }
  .blog-card:hover .blog-card-read svg { transform: translateX(3px); }

  @media (max-width: 640px) {
    .blog-card { padding: 1.4rem 1.4rem; }
  }
</style>
