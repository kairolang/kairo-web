---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 - Kairo" description="Page not found.">
  <section class="nf-section">
    <div class="ambient nf-ambient" aria-hidden="true"></div>
    <div class="grid-texture" aria-hidden="true"></div>

    <div class="container nf-inner">
      <div class="nf-code fade-up" style="--d: 0ms;">404</div>

      <h1 class="display nf-title fade-up" style="--d: 120ms;">This page doesn't exist in any timeline.</h1>

      <p class="nf-sub fade-up" style="--d: 220ms;">
        The page you're looking for has been moved, deleted,
        or may have never existed. Check the URL and try again.
      </p>

      <!-- Error readout -->
      <div class="code-window nf-error fade-up" style="--d: 320ms;">
        <div class="code-window-bar">
          <div class="window-dots"><span></span><span></span><span></span></div>
          <span class="code-window-title">kairo</span>
        </div>
        <div class="nf-error-body">
          <span class="nf-err">error</span><span class="nf-err-code">[E404]</span>: page not found<br>
          <span class="nf-dim">  --&gt; </span><span id="current-path" class="nf-path">/unknown</span><br>
          <span class="nf-dim">hint</span>: try <a href="/">/</a> or <a href="/docs">/docs</a>
        </div>
      </div>

      <div class="nf-actions fade-up" style="--d: 420ms;">
        <a href="/" class="btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Go Home
        </a>
        <a href="/docs" class="btn-outline">View Docs</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf-section {
    min-height: calc(100dvh - 60px);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 4rem 0;
  }
  .nf-ambient {
    width: 700px;
    height: 460px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse at center, var(--red-glow) 0%, transparent 70%);
  }

  .nf-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nf-code {
    font-size: clamp(7rem, 18vw, 12rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.05em;
    background: linear-gradient(180deg, var(--red-hi) 0%, var(--red) 45%, var(--red-lo) 110%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    margin-bottom: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  .nf-title {
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    margin-bottom: 1rem;
  }

  .nf-sub {
    font-size: 1rem;
    color: var(--text-2);
    line-height: 1.7;
    margin-bottom: 2.25rem;
    text-wrap: balance;
  }

  .nf-error {
    width: 100%;
    max-width: 460px;
    margin-bottom: 2.25rem;
    text-align: left;
  }
  .nf-error-body {
    padding: 14px 18px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--text-3);
  }
  .nf-err { color: var(--accent); font-weight: 600; }
  .nf-err-code { color: var(--text-2); }
  .nf-dim { color: var(--text-3); }
  .nf-path { color: var(--text-2); }
  .nf-error-body a {
    color: var(--accent);
    text-decoration: none;
  }
  .nf-error-body a:hover { text-decoration: underline; }

  .nf-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .nf-actions a { text-decoration: none; }
</style>

<script>
  const el = document.getElementById('current-path');
  if (el) el.textContent = window.location.pathname;
</script>
